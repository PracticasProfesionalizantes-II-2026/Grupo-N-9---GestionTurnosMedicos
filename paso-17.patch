diff --git a/ChronoSaludWeb/Views/Shared/_TamanoLetra.cshtml b/ChronoSaludWeb/Views/Shared/_TamanoLetra.cshtml
new file mode 100644
index 0000000..df3cf02
--- /dev/null
+++ b/ChronoSaludWeb/Views/Shared/_TamanoLetra.cshtml
@@ -0,0 +1,34 @@
+@model string
+@{
+    // Los tres tamaños de Ajustes, siempre a mano en el encabezado. Cada botón
+    // es un formulario chico que guarda la misma cookie y vuelve a esta misma
+    // pantalla, sin JavaScript. El Model es la escala que está elegida ahora.
+    var volver = $"{Context.Request.Path}{Context.Request.QueryString}";
+
+    var opciones = new[]
+    {
+        (Escala: "md", Texto: "A",   Nombre: "normal",       Clase: "text-sm"),
+        (Escala: "lg", Texto: "A+",  Nombre: "grande",       Clase: "text-base"),
+        (Escala: "xl", Texto: "A++", Nombre: "extra grande", Clase: "text-lg")
+    };
+}
+
+@* aria-pressed dice cuál está elegido; el lector de pantalla lee, por
+   ejemplo, "Letra grande, botón conmutador, presionado". *@
+<div role="group" aria-label="Tamaño de la letra" class="flex items-center gap-1">
+    <span aria-hidden="true" class="mr-1 text-xs font-medium text-muted">Letra</span>
+    @foreach (var opcion in opciones)
+    {
+        var elegida = Model == opcion.Escala;
+
+        <form asp-controller="Ajustes" asp-action="Tamano" method="post">
+            <input type="hidden" name="escala" value="@opcion.Escala" />
+            <input type="hidden" name="volver" value="@volver" />
+            <button type="submit" aria-pressed="@(elegida ? "true" : "false")"
+                    class="boton boton-secundario min-w-11 px-2 py-1 font-bold @opcion.Clase aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-on-primary aria-pressed:shadow-none aria-pressed:hover:bg-primary-hover">
+                <span aria-hidden="true">@opcion.Texto</span>
+                <span class="sr-only">Letra @opcion.Nombre</span>
+            </button>
+        </form>
+    }
+</div>
diff --git a/ChronoSaludWeb/Views/Turnos/Comprobante.cshtml b/ChronoSaludWeb/Views/Turnos/Comprobante.cshtml
new file mode 100644
index 0000000..057efd8
--- /dev/null
+++ b/ChronoSaludWeb/Views/Turnos/Comprobante.cshtml
@@ -0,0 +1,109 @@
+@model TurnoComprobanteViewModel
+@{
+    ViewData["Title"] = $"Comprobante del turno #{Model.IdTurno}";
+}
+
+@* La hoja del comprobante, con letra grande. Sin JavaScript: se imprime con
+   el menú del navegador. Lo que lleva print:hidden no sale en el papel, y el
+   bloque @media print de app.css (el mismo de la receta, por la clase
+   hoja-receta) deja la hoja en blanco y negro. *@
+
+<a asp-action="Detalle" asp-route-id="@Model.IdTurno"
+   class="boton-texto text-muted hover:text-primary print:hidden">
+    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
+         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
+        <path d="m12 19-7-7 7-7" />
+        <path d="M19 12H5" />
+    </svg>
+    Volver al turno
+</a>
+
+@if (Model.HuboError || Model.Turno is null)
+{
+    <div class="tarjeta mt-8">
+        <partial name="_EstadoVacio"
+                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudo cargar el comprobante", Ayuda = Model.Error }' />
+    </div>
+}
+else
+{
+    var turno = Model.Turno;
+
+    <div class="mx-auto mt-6 flex max-w-3xl items-start gap-3 rounded-input border border-border bg-surface px-4 py-3 text-sm text-muted print:hidden">
+        <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none"
+             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
+            <circle cx="12" cy="12" r="10" />
+            <path d="M12 16v-4" />
+            <path d="M12 8h.01" />
+        </svg>
+        <p>
+            Para imprimirlo o guardarlo como PDF, usá <span class="font-medium text-ink">Imprimir</span>
+            en el menú del navegador (Ctrl + P). Sale solo la hoja.
+        </p>
+    </div>
+
+    <article class="hoja-receta tarjeta mx-auto mt-6 max-w-3xl p-6 sm:p-10" aria-labelledby="titulo-comprobante">
+        <header class="flex flex-wrap items-start justify-between gap-4 border-b border-border pb-5">
+            <p class="flex items-center gap-2 text-lg font-bold tracking-tight text-primary">
+                <svg class="size-7 shrink-0" viewBox="0 0 32 32" aria-hidden="true">
+                    <rect width="32" height="32" rx="7" class="fill-primary" />
+                    <path d="M16 8v8l5 3" fill="none" class="stroke-on-primary" stroke-width="3"
+                          stroke-linecap="round" stroke-linejoin="round" />
+                </svg>
+                ChronoSalud
+            </p>
+            <div class="sm:text-right">
+                <h1 id="titulo-comprobante" class="text-xl font-bold text-ink">Comprobante de turno</h1>
+                <p class="mt-1 text-sm tabular-nums text-muted">Turno N.º @turno.IdTurno</p>
+            </div>
+        </header>
+
+        @* Lo más importante, bien grande: el día y la hora. El día va como se
+           dice ("viernes 16 de octubre"), para que no haya que interpretar números. *@
+        <section class="border-b border-border py-6" aria-labelledby="titulo-cuando">
+            <h2 id="titulo-cuando" class="text-sm font-semibold uppercase tracking-wide text-muted">Cuándo</h2>
+            <p class="mt-2 text-3xl font-bold text-ink first-letter:uppercase">@turno.DiaParaPaciente</p>
+            <p class="mt-1 text-2xl font-semibold tabular-nums text-ink">@turno.Horario hs</p>
+            @* La fecha completa, con el año, por si el papel se lee otro día. *@
+            <p class="mt-2 text-lg text-muted first-letter:uppercase">@turno.FechaLarga</p>
+        </section>
+
+        <section class="border-b border-border py-6" aria-labelledby="titulo-con-quien">
+            <h2 id="titulo-con-quien" class="text-sm font-semibold uppercase tracking-wide text-muted">Con quién y dónde</h2>
+            <p class="mt-2 text-2xl font-semibold text-ink">@turno.DoctorMostrado</p>
+            @if (!string.IsNullOrWhiteSpace(turno.Especialidad))
+            {
+                <p class="text-xl capitalize text-ink">@turno.Especialidad</p>
+            }
+            @if (!string.IsNullOrWhiteSpace(turno.Consultorio))
+            {
+                <p class="mt-2 text-xl text-ink">Consultorio @turno.Consultorio</p>
+            }
+            @if (Model.Direccion is not null)
+            {
+                <p class="mt-1 text-xl text-ink">@Model.Direccion</p>
+            }
+        </section>
+
+        <section class="border-b border-border py-6" aria-labelledby="titulo-paciente">
+            <h2 id="titulo-paciente" class="text-sm font-semibold uppercase tracking-wide text-muted">Paciente</h2>
+            <p class="mt-2 text-xl font-medium text-ink">@turno.PacienteMostrado</p>
+            <p class="mt-3 text-lg text-ink">
+                <span class="text-muted">Estado:</span>
+                @EstadoTurnoTexto.Para(turno.Estado, paciente: true)
+            </p>
+        </section>
+
+        <section class="py-6" aria-labelledby="titulo-llevar">
+            <h2 id="titulo-llevar" class="text-sm font-semibold uppercase tracking-wide text-muted">Qué llevar</h2>
+            <ul class="mt-2 list-disc space-y-1 pl-6 text-xl text-ink">
+                <li>Tu DNI.</li>
+                <li>La credencial de tu cobertura médica, si tenés.</li>
+            </ul>
+        </section>
+
+        <p class="mt-4 border-t border-border pt-3 text-xs text-muted">
+            Generado en ChronoSalud el <span class="tabular-nums">@Model.GeneradoElTexto</span>.
+        </p>
+    </article>
+}
