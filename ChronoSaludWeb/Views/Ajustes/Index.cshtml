@model AjustesViewModel
@{
    ViewData["Title"] = "Ajustes";

    // La tarjeta entera es el label: se marca sola con has-[:checked] (CSS puro,
    // sin JavaScript) y el radio nativo queda a la vista para que se entienda
    // que es una opción única y siga funcionando con teclado.
    const string claseOpcion = "group flex cursor-pointer items-start gap-3 rounded-input border border-control bg-card px-4 py-3 shadow-elevado-xs hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary-soft has-[:checked]:shadow-none has-[:checked]:inset-shadow-hundido";
    const string claseRadio = "mt-0.5 h-4 w-4 shrink-0 accent-primary";

    // Muestra de cada tema: una pantalla en miniatura con los colores reales
    // del tema (fondo, tarjeta, texto y botón), fijos para que se vean igual
    // con cualquiera de los dos temas activo. Es decorativa: el nombre del
    // tema ya está escrito.
    static (string Fondo, string Tarjeta, string Borde, string Texto, string Boton) ColoresDe(string tema) => tema == "dark"
        ? ("#16130F", "#25201A", "#2D6A70", "#F2EBE2", "#2F9FA9")
        : ("#EFE6DA", "#FFFFFF", "#8CC4C9", "#1B2627", "#0B6E75");

    // "Aa" en el tamaño de cada escala, relativo al texto de la página.
    static string ClaseMuestraEscala(string escala) => escala switch
    {
        "xl" => "text-[1.5rem]",
        "lg" => "text-[1.3rem]",
        _    => "text-[1.125rem]",
    };
}

<div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-bold tracking-tight text-ink">Ajustes</h1>
    <p class="mt-1 text-sm text-muted">
        Cómo se ve ChronoSalud en este navegador. Se guarda en tu equipo, así que
        se mantiene aunque cierres sesión, y no cambia nada para el resto.
    </p>

    <div class="mt-6 tarjeta p-5 sm:p-8">
        <form asp-action="Guardar" method="post">
            <input type="hidden" asp-for="UrlRetorno" />

            <fieldset>
                <legend class="text-sm font-semibold text-ink">Tema</legend>
                <p class="mt-1 text-sm text-muted">El esquema de colores de toda la aplicación.</p>

                <div class="mt-3 grid gap-3 sm:grid-cols-2">
                    @foreach (var opcion in AjustesViewModel.Temas)
                    {
                        var colores = ColoresDe(opcion.Valor);
                        <label class="@claseOpcion" for="tema-@opcion.Valor">
                            <input asp-for="Tema" type="radio" value="@opcion.Valor"
                                   id="tema-@opcion.Valor" class="@claseRadio" />
                            <span class="min-w-0 flex-1">
                                <span class="block text-sm font-medium text-ink group-has-[:checked]:font-bold">@opcion.Titulo</span>
                                <span class="mt-0.5 block text-xs text-muted">@opcion.Descripcion</span>
                            </span>
                            <svg class="h-10 w-14 shrink-0 rounded-badge" viewBox="0 0 56 40" aria-hidden="true">
                                <rect width="56" height="40" rx="6" fill="@colores.Fondo" />
                                <rect x="7" y="7" width="42" height="26" rx="4" fill="@colores.Tarjeta" stroke="@colores.Borde" stroke-width="1.5" />
                                <rect x="12" y="13" width="20" height="3" rx="1.5" fill="@colores.Texto" />
                                <rect x="12" y="19" width="14" height="3" rx="1.5" fill="@colores.Texto" opacity=".45" />
                                <rect x="33" y="22" width="11" height="6" rx="2" fill="@colores.Boton" />
                            </svg>
                        </label>
                    }
                </div>
            </fieldset>

            <fieldset class="mt-8">
                <legend class="text-sm font-semibold text-ink">Tamaño del texto</legend>
                <p class="mt-1 text-sm text-muted">
                    Agranda el texto y, en la misma proporción, los espacios y los
                    botones, para que nada quede apretado.
                </p>

                <div class="mt-3 grid gap-3">
                    @foreach (var opcion in AjustesViewModel.Escalas)
                    {
                        <label class="@claseOpcion" for="escala-@opcion.Valor">
                            <input asp-for="Escala" type="radio" value="@opcion.Valor"
                                   id="escala-@opcion.Valor" class="@claseRadio" />
                            <span class="min-w-0 flex-1">
                                <span class="block text-sm font-medium text-ink group-has-[:checked]:font-bold">@opcion.Titulo</span>
                                <span class="mt-0.5 block text-xs text-muted">@opcion.Descripcion</span>
                            </span>
                            <span aria-hidden="true" class="w-10 shrink-0 self-center text-center leading-none font-bold text-primary @ClaseMuestraEscala(opcion.Valor)">Aa</span>
                        </label>
                    }
                </div>
            </fieldset>

            <div class="mt-7 flex flex-wrap items-center gap-3">
                <button type="submit" data-cargando="Guardando…"
                        class="boton boton-primario">
                    Guardar
                </button>
                <span class="text-xs text-muted">Los cambios se aplican al guardar.</span>
            </div>
        </form>
    </div>
</div>
