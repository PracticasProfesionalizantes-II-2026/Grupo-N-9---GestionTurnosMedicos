@model EstudioResultadoViewModel
@{
    var titulo = Model.EsCorreccion ? "Corregir resultado" : "Cargar resultado";
    ViewData["Title"] = titulo;
    var erroresGenerales = ViewData.ModelState[string.Empty]?.Errors;
    const string claseCampo = "campo mt-1.5";
    const string claseError = "mt-1 block text-xs text-status-cancelado";
}

<a asp-action="Index" asp-route-paciente="@Model.IdPaciente"
   class="boton-texto area-tactil text-muted hover:text-primary">
    <icono nombre="volver" class="h-4 w-4" />
    Volver a los estudios
</a>

<div class="mt-6 max-w-2xl">
    <h1 class="text-2xl font-bold tracking-tight text-ink">@titulo</h1>
    <p class="mt-1 text-sm text-muted">
        Al guardar, el paciente recibe un aviso y ve el resultado en «Mis estudios».
    </p>

    @if (Model.Estudio is { } estudio)
    {
        <dl class="mt-4 grid gap-3 rounded-input border border-border bg-surface px-4 py-3 text-sm sm:grid-cols-2">
            <div class="sm:col-span-2">
                <dt class="text-muted">Estudio</dt>
                <dd class="font-medium text-ink">@estudio.Titulo</dd>
            </div>
            @if (Model.NombrePaciente is not null)
            {
                <div>
                    <dt class="text-muted">Paciente</dt>
                    <dd class="text-ink">@Model.NombrePaciente</dd>
                </div>
            }
            <div>
                <dt class="text-muted">Pedido</dt>
                <dd class="text-ink">
                    <span class="tabular-nums">@estudio.FechaSolicitudTexto</span>
                    @if (estudio.PedidoPor is not null)
                    {
                        <text>por @estudio.PedidoPor.NombreCompleto</text>
                    }
                </dd>
            </div>
        </dl>
    }

    <div class="mt-6 tarjeta p-5 sm:p-8">
        @if (erroresGenerales is { Count: > 0 })
        {
            <div role="alert" class="aviso aviso-error mb-6">
                <icono nombre="alerta" class="mt-0.5 h-4 w-4 shrink-0" />
                <span>
                    @foreach (var error in erroresGenerales)
                    {
                        <span class="block">@error.ErrorMessage</span>
                    }
                </span>
            </div>
        }

        <form asp-action="Resultado" method="post" novalidate data-avisar-cambios>
            <input type="hidden" asp-for="IdEstudio" />
            <input type="hidden" asp-for="IdPaciente" />

            <div>
                <label asp-for="Resultado" class="block text-sm font-medium text-ink"></label>
                <textarea asp-for="Resultado" rows="8" aria-describedby="ayuda-resultado"
                          placeholder="Por ejemplo: hemograma dentro de valores normales. Glucemia 92 mg/dl…" class="@claseCampo"></textarea>
                <p id="ayuda-resultado" class="mt-1 text-xs text-muted">Escribilo para que el paciente lo entienda.</p>
                <span asp-validation-for="Resultado" class="@claseError"></span>
            </div>

            <div class="mt-5">
                <label asp-for="ArchivoUrl" class="block text-sm font-medium text-ink"></label>
                <input asp-for="ArchivoUrl" type="url" inputmode="url" autocomplete="off" spellcheck="false" autocapitalize="none" aria-describedby="ayuda-archivo"
                       placeholder="https://laboratorio.com/resultado…" class="@claseCampo" />
                <p id="ayuda-archivo" class="mt-1 text-xs text-muted">
                    Si el laboratorio dejó el informe en internet, pegá acá la dirección completa (empieza con https://).
                </p>
                <span asp-validation-for="ArchivoUrl" class="@claseError"></span>
            </div>

            <div class="mt-7 flex flex-wrap items-center gap-3">
                <button type="submit" data-cargando="Guardando…" class="boton boton-primario">Guardar resultado</button>
                <a asp-action="Index" asp-route-paciente="@Model.IdPaciente" class="boton boton-secundario">Cancelar</a>
            </div>
        </form>
    </div>
</div>
