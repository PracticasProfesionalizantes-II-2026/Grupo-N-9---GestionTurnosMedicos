@model PaginadorViewModel
@{
    // El inactivo usa el apagado de .boton[aria-disabled] de app.css, con el
    // borde de un divisor: se ve que está, pero que no lleva a ningún lado.
    const string clasePaso = "boton boton-secundario";
    const string clasePasoInactivo = "boton border border-border text-muted";
}

@* Paginación con enlaces: cada listado arma las rutas con sus filtros, así
   que pasar de página no los pierde. Sin JavaScript. *@
<nav aria-label="Páginas de resultados" class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-muted">
        Página <span class="font-semibold tabular-nums text-ink">@Model.Pagina</span>
        de <span class="font-semibold tabular-nums text-ink">@Model.TotalPaginas</span>
    </p>
    <div class="flex items-center gap-2">
        @if (Model.HayAnterior)
        {
            <a asp-action="@Model.Accion" asp-all-route-data="Model.RutaAnterior"
               rel="prev" class="@clasePaso"><icono nombre="chevron-izq" class="size-4" /> Anterior</a>
        }
        else
        {
            <span aria-disabled="true" class="@clasePasoInactivo"><icono nombre="chevron-izq" class="size-4" /> Anterior</span>
        }
        @if (Model.HaySiguiente)
        {
            <a asp-action="@Model.Accion" asp-all-route-data="Model.RutaSiguiente"
               rel="next" class="@clasePaso">Siguiente <icono nombre="chevron-der" class="size-4" /></a>
        }
        else
        {
            <span aria-disabled="true" class="@clasePasoInactivo">Siguiente <icono nombre="chevron-der" class="size-4" /></span>
        }
    </div>
</nav>
