@model TiraDeDiasViewModel

@* Dos semanas de días: cada uno dice cuántos horarios libres tiene. El
   elegido lleva aria-current="date"; uno sin lugar no es un enlace. En
   pantalla va abreviado ("jue 9 oct"), así que el lector de pantalla lee
   la descripción completa ("jueves 9 de octubre, 3 libres").
   En el celular es una tira que se desliza de costado (de a un día, con
   snap) en lugar de una grilla de cuatro filas; site.js la deja con el día
   elegido a la vista (data-tira-dias). El relleno interno deja lugar para
   el contorno del foco, que el desplazamiento recortaría. *@
<nav aria-label="Días" class="mt-4">
    <ul data-tira-dias
        class="relative -mx-1 flex snap-x snap-mandatory gap-2 overflow-x-auto overscroll-x-contain px-1 py-1 sm:mx-0 sm:grid sm:grid-cols-7 sm:overflow-visible sm:p-0">
        @foreach (var dia in Model.Dias)
        {
            <li class="w-[4.75rem] shrink-0 snap-start sm:w-auto">
                @if (dia.SinLugar)
                {
                    <span aria-disabled="true" class="tarjeta dia h-full">
                        <span class="sr-only">@dia.Descripcion</span>
                        <span aria-hidden="true" class="text-xs capitalize text-muted">@dia.DiaCorto</span>
                        <span aria-hidden="true" class="text-sm font-semibold tabular-nums text-ink">@dia.FechaCorta</span>
                        <span aria-hidden="true" class="text-xs text-muted">@dia.TextoLibres</span>
                    </span>
                }
                else
                {
                    <a asp-action="@Model.Accion" asp-all-route-data="dia.Ruta"
                       aria-current="@(dia.Elegido ? "date" : null)"
                       class="tarjeta dia h-full">
                        <span class="sr-only">@dia.Descripcion</span>
                        <span aria-hidden="true" class="text-xs capitalize text-muted">@dia.DiaCorto</span>
                        <span aria-hidden="true" class="text-sm font-semibold tabular-nums text-ink">@dia.FechaCorta</span>
                        <span aria-hidden="true" class="text-xs font-semibold text-primary">@dia.TextoLibres</span>
                    </a>
                }
            </li>
        }
    </ul>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
        @if (Model.RutaAnteriores is not null)
        {
            <a asp-action="@Model.Accion" asp-all-route-data="Model.RutaAnteriores" class="boton-texto area-tactil">
                <icono nombre="chevron-izq" class="h-4 w-4" />
                Dos semanas antes
            </a>
        }
        <a asp-action="@Model.Accion" asp-all-route-data="Model.RutaSiguientes" class="boton-texto area-tactil ml-auto">
            Dos semanas después
            <icono nombre="chevron-der" class="h-4 w-4" />
        </a>
    </div>
</nav>
