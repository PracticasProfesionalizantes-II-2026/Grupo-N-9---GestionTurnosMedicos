@model ErrorViewModel
@{
    ViewData["Title"] = "Algo salió mal";

    // El manejador de errores vuelve a ejecutar el pedido con el mismo
    // método: si era un GET, se puede ofrecer probar de nuevo la misma
    // dirección. Un POST no se repite solo, para no mandar dos veces un
    // formulario.
    var origen = Context.Features.Get<Microsoft.AspNetCore.Diagnostics.IExceptionHandlerPathFeature>()?.Path;
    var puedeReintentar = HttpMethods.IsGet(Context.Request.Method) && !string.IsNullOrEmpty(origen);
}

@* Única decoración de la pantalla: el motivo de marca con el latido plano,
   porque algo se cortó. *@
@{ ViewData["MotivoPlano"] = true; }
<div class="mx-auto max-w-lg tarjeta overflow-hidden text-center">
    <div class="mx-auto h-20 max-w-sm px-6 pt-6 sm:h-24">
        <partial name="_MotivoMarca" />
    </div>
    <div class="px-6 pt-4 pb-10 sm:px-10">
        <h1 class="text-2xl font-bold tracking-tight text-ink">Algo salió mal</h1>
        <p class="mx-auto mt-2 max-w-sm text-sm text-muted">
            Hubo un error inesperado procesando tu pedido. Probá de nuevo en un
            momento; si vuelve a pasar, avisale al equipo.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="mt-4 text-xs text-muted">
                Código para el reporte:
                <code class="rounded-badge bg-surface px-1.5 py-0.5 font-mono text-ink" translate="no">@Model.RequestId</code>
            </p>
        }

        <div class="mt-6 flex flex-wrap justify-center gap-3">
            @if (puedeReintentar)
            {
                <a href="@origen" class="boton boton-primario">Probar de nuevo</a>
            }
            <a asp-controller="Home" asp-action="Index"
               class="boton @(puedeReintentar ? "boton-secundario" : "boton-primario")">
                Volver al inicio
            </a>
        </div>
    </div>
</div>
