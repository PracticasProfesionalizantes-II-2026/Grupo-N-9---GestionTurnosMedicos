@using Microsoft.Extensions.Options
@inject IOptions<ClinicaOpciones> OpcionesClinica
@{
    // "¿Necesitás ayuda?": un botón chico en el pie que abre una ventanita con
    // las formas de pedir ayuda (WhatsApp, teléfono…). La lista sale de
    // OpcionesDeAyuda, así que sumar una opción no toca esta vista.
    var clinica = OpcionesClinica.Value;
    var opciones = OpcionesDeAyuda.Armar(clinica);

    const string ClaseFila = "flex min-h-11 items-center gap-3 rounded-input px-3 py-2";
}

@* El atributo popover lo maneja el navegador, igual que el menú de la
   cuenta: abre con el botón, cierra con Escape, con un clic afuera o con
   "Cerrar", y devuelve el foco al botón. Todo sin JavaScript.
   Html.Raw es seguro acá: IconosLucide.Trazos devuelve literales del código. *@
<button type="button" popovertarget="ventana-ayuda"
        class="inline-flex min-h-11 cursor-pointer items-center gap-1.5 rounded-input px-2 text-sm text-muted hover:text-primary">
    <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        @Html.Raw(IconosLucide.Trazos("ayuda"))
    </svg>
    ¿Necesitás ayuda?
</button>

<div id="ventana-ayuda" popover role="dialog" aria-labelledby="ventana-ayuda-titulo"
     class="menu-flotante menu-ayuda">
    <div class="flex items-start justify-between gap-2 px-3 pt-2">
        <div>
            <h2 id="ventana-ayuda-titulo" class="text-base font-semibold text-ink">¿Necesitás ayuda?</h2>
            <p class="mt-0.5 text-sm text-muted">
                Si te trabás con algo, escribinos o llamanos.
                @if (clinica.TieneHorario)
                {
                    <span>Atendemos @clinica.Horario.</span>
                }
            </p>
        </div>
        <button type="button" popovertarget="ventana-ayuda" popovertargetaction="hide"
                class="flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-input text-muted hover:bg-primary-soft hover:text-primary-hover">
            <svg class="size-5" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                @Html.Raw(IconosLucide.Trazos("cerrar"))
            </svg>
            <span class="sr-only">Cerrar</span>
        </button>
    </div>

    <ul class="mt-2 border-t border-border pt-1 text-sm font-medium">
        @foreach (var opcion in opciones)
        {
            <li>
                @if (opcion.Disponible)
                {
                    <a href="@opcion.Url" rel="noopener"
                       class="@ClaseFila text-ink hover:bg-primary-soft hover:text-primary-hover">
                        <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            @Html.Raw(IconosLucide.Trazos(opcion.Icono))
                        </svg>
                        @opcion.Titulo
                    </a>
                }
                else
                {
                    @* Todavía sin el dato en appsettings.json (sección "Clinica"):
                       se ve, pero no es un enlace ni recibe foco. *@
                    <span aria-disabled="true" class="@ClaseFila text-ink">
                        <svg class="size-5 shrink-0 opacity-60" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            @Html.Raw(IconosLucide.Trazos(opcion.Icono))
                        </svg>
                        <span class="flex-1 opacity-60">@opcion.Titulo</span>
                        <partial name="_Chip" model='new ChipViewModel { Texto = "Próximamente", Tono = TonoChip.Proximamente }' />
                    </span>
                }
            </li>
        }
    </ul>
</div>
