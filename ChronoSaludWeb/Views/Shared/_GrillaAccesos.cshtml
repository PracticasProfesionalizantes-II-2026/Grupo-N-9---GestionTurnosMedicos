@model IReadOnlyList<AccesoRapidoViewModel>

@* La grilla de accesos rápidos. Está en su propio parcial porque los tres
   tableros la ubican en lugares distintos. *@
@if (Model.Count > 0)
{
    <section aria-labelledby="titulo-accesos">
        <h2 id="titulo-accesos" class="text-base font-semibold text-ink">Accesos rápidos</h2>
        <ul class="mt-3 grid grid-cols-2 gap-4 sm:grid-cols-4">
            @foreach (var acceso in Model)
            {
                <li>
                    <partial name="_AccesoRapido" model="acceso" />
                </li>
            }
        </ul>
    </section>
}
