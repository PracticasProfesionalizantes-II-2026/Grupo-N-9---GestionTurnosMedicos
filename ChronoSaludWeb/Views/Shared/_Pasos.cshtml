@model PasoViewModel

@functions {
    // Tailwind escanea texto, no ejecuta Razor: cada rama devuelve las clases
    // completas para que las encuentre al compilar el CSS.
    static string ClaseCirculo(EstadoPaso estado) => estado switch
    {
        EstadoPaso.Hecho  => "circulo-icono",
        EstadoPaso.Actual => "circulo-icono ring-4 ring-primary-soft",
        _                 => "border-[1.5px] border-control bg-card text-muted",
    };
}

@* El título de un paso, con su número en un círculo: hecho lleva un tilde,
   el actual va en teal con un halo y el que falta, con borde. El estado
   se dice también con palabras para el lector de pantalla. *@
<h2 class="flex items-center gap-3 text-base font-semibold text-ink">
    <span aria-hidden="true"
          class="flex size-8 shrink-0 items-center justify-center rounded-full text-sm font-bold tabular-nums @ClaseCirculo(Model.Estado)">
        @if (Model.Estado == EstadoPaso.Hecho)
        {
            <icono nombre="check" class="size-4" stroke-width="2.5" />
        }
        else
        {
            @Model.Numero
        }
    </span>
    <span>
        <span class="sr-only">Paso @Model.Numero:</span>
        @Model.Titulo
        @if (Model.Estado == EstadoPaso.Hecho)
        {
            <span class="sr-only">(listo)</span>
        }
    </span>
</h2>
