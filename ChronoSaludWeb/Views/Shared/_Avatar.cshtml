@model AvatarViewModel

@functions {
    // Tailwind escanea texto, no ejecuta Razor: cada rama devuelve las clases
    // completas para que las encuentre al compilar el CSS.
    static string ClaseCirculo(TamanoAvatar tamano) => tamano switch
    {
        TamanoAvatar.Grande     => "size-16 text-lg",
        TamanoAvatar.Intermedio => "size-12 text-base",
        TamanoAvatar.Mediano    => "size-10 text-sm",
        _                       => "size-9 text-xs",
    };

    static string ClaseIcono(TamanoAvatar tamano) => tamano switch
    {
        TamanoAvatar.Grande     => "size-8",
        TamanoAvatar.Intermedio => "size-6",
        TamanoAvatar.Mediano    => "size-5",
        _                       => "size-5",
    };

    // Fondo y texto del círculo sin foto. El teal va en tres variantes que
    // reparte el nombre (AvatarViewModel.Variante), todas con contraste de
    // texto: teal claro con teal profundo (8,73:1), teal lleno con on-primary
    // (6,00:1) y tarjeta con borde teal y letras teal (6,00:1).
    static string ClaseTono(TonoAvatar tono, int variante) => (tono, variante) switch
    {
        (TonoAvatar.Terracota, _) => "bg-accent-soft text-accent-ink ring-1 ring-contorno-suave",
        (_, 1)                    => "bg-primary text-on-primary",
        (_, 2)                    => "bg-card text-primary ring-[1.5px] ring-contorno",
        _                         => "bg-primary-soft text-primary-deep ring-1 ring-contorno",
    };

    // Ancho y alto del <img> en píxeles, para que reserve su lugar antes de
    // cargar. El tamaño real lo manda la clase size-*, que acompaña la escala.
    static int Lado(TamanoAvatar tamano) => tamano switch
    {
        TamanoAvatar.Grande     => 64,
        TamanoAvatar.Intermedio => 48,
        TamanoAvatar.Mediano    => 40,
        _                       => 36,
    };
}

@* Siempre decorativo: el nombre va escrito al lado en la vista que lo usa. *@
@if (Model.TieneFoto)
{
    <img src="@Model.FotoUrl" alt="" aria-hidden="true" loading="lazy"
         width="@Lado(Model.Tamano)" height="@Lado(Model.Tamano)"
         class="shrink-0 rounded-full object-cover ring-1 ring-contorno @ClaseCirculo(Model.Tamano)" />
}
else
{
    <span aria-hidden="true"
          class="flex shrink-0 items-center justify-center rounded-full font-semibold @ClaseTono(Model.Tono, Model.Variante) @ClaseCirculo(Model.Tamano)">
        @if (Model.Iniciales is { } iniciales)
        {
            @iniciales
        }
        else
        {
            <icono nombre="persona" class="@ClaseIcono(Model.Tamano)" />
        }
    </span>
}
