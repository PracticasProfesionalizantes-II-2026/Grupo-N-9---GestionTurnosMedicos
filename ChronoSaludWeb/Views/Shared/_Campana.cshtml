@model CampanaViewModel

@* La campana del encabezado: un enlace a Notificaciones con el número de las
   sin leer en un globito rojo. El globito es solo visual (aria-hidden); el
   lector de pantalla lee el texto completo del sr-only. Usa el mismo rojo y
   texto que el botón de peligro, que pasan el contraste en los dos temas.
   El borde del globito es del color de la barra superior (surface), así
   parece recortado de la campana. En el inicio, con avisos sin leer, la
   campana se balancea una vez (campana-con-avisos en app.css). *@
<a asp-controller="Notificaciones" asp-action="Index" aria-current="@(Model.Activa ? "page" : null)"
   class="boton boton-secundario relative shrink-0 @(Model.Llamar ? "campana-con-avisos" : null) px-2.5 py-1 aria-[current=page]:border-primary aria-[current=page]:bg-primary-soft aria-[current=page]:text-primary-hover">
    <icono nombre="campana" class="size-5 shrink-0" />
    <span class="sr-only">@Model.TextoAccesible</span>
    @if (Model.Globito is { } globito)
    {
        <span aria-hidden="true"
              class="globito absolute -top-1.5 -right-1.5 flex h-5 min-w-5 items-center justify-center rounded-full border-2 border-surface bg-status-cancelado px-1 text-xs font-bold tabular-nums text-on-primary">
            @globito
        </span>
    }
</a>
