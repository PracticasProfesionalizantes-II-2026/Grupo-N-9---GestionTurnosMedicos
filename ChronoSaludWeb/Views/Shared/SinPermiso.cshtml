@model string
@{
    var titulo = ViewData["Titulo"] as string ?? "No tenés permiso para esta acción";
    var motivo = ViewData["Motivo"] as string;
    var rol = string.IsNullOrWhiteSpace(Model) ? null : Model;
    ViewData["AyudaEnLaPagina"] = true;
    ViewData["Title"] = "Permiso insuficiente";

    // Por defecto se vuelve al Index del controlador que la usa. Si ese
    // Index tampoco es para este rol, el controlador pide volver al inicio.
    var alInicio = ViewData["VolverAlInicio"] is true;
    var controladorDeVuelta = alInicio ? "Home" : null;
}

<a asp-controller="@controladorDeVuelta" asp-action="Index"
   class="boton-texto text-muted hover:text-primary">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    @(alInicio ? "Volver al inicio" : "Volver al listado")
</a>

<div class="mt-6 tarjeta p-10 text-center">
    <span class="mx-auto flex size-14 items-center justify-center rounded-full bg-accent-soft text-accent-ink">
        <svg class="size-7" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="11" x="3" y="11" rx="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
    </span>
    <h1 class="mt-4 text-base font-semibold text-ink">@titulo</h1>
    @if (motivo is not null)
    {
        <p class="mx-auto mt-2 max-w-md text-sm text-muted">
            @motivo
            @if (rol is not null)
            {
                <span>
                    Tu sesión está abierta como <span class="font-medium capitalize text-ink">@rol</span>.
                </span>
            }
        </p>
    }
    <a asp-controller="@controladorDeVuelta" asp-action="Index"
       class="boton boton-primario mt-6">
        Volver
    </a>
</div>

@* Una salida humana: quien llega acá suele estar trabado. *@
<partial name="_Ayuda" model='"tarjeta"' />
