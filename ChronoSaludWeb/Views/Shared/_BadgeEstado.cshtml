@model string
@inject AuthService Auth

@functions {
    // El estado de un turno, como chip. Un estado que no se conoce cae en el
    // tono neutro en vez de romper.
    static TonoChip Tono(string? estado) => estado?.ToLowerInvariant() switch
    {
        "confirmado" => TonoChip.Exito,
        "pendiente"  => TonoChip.Aviso,
        "completado" => TonoChip.Info,
        "cancelado"  => TonoChip.Peligro,
        "ausente"    => TonoChip.Neutro,
        _            => TonoChip.Neutro,
    };
}

@{
    // Al paciente se le dice el estado con palabras ("Esperando confirmación");
    // el personal sigue viendo la palabra corta.
    var texto = EstadoTurnoTexto.Para(Model, Auth.SesionActual?.Rol == "paciente");
}

<partial name="_Chip" model="new ChipViewModel { Texto = texto, Tono = Tono(Model) }" />
