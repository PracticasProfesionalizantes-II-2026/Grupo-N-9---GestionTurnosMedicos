@model string

@functions {
    // El estado de un turno, como chip. Un estado que no se conoce cae en el
    // tono neutro en vez de romper.
    static TonoChip Tono(string? estado) => estado?.ToLowerInvariant() switch
    {
        "confirmado" => TonoChip.Exito,
        "pendiente"  => TonoChip.Aviso,
        "completado" => TonoChip.Info,
        "cancelado"  => TonoChip.Peligro,
        "ausente"    => TonoChip.Neutro,
        _            => TonoChip.Neutro,
    };
}

<partial name="_Chip" model="new ChipViewModel { Texto = Model, Tono = Tono(Model), Capitalizar = true }" />
