@model PanelActividadViewModel

@* Mismo esqueleto que _PanelTurnos, pero con las consultas y recetas del
   paciente. Tiene su propio estado de error porque se arma con dos llamadas
   que pueden fallar sin que eso deba voltear el tablero entero. *@
<section aria-labelledby="titulo-actividad" class="tarjeta overflow-hidden">
    <header class="tarjeta-encabezado flex flex-wrap items-center justify-between gap-x-3 gap-y-1 px-5 py-4">
        <h2 id="titulo-actividad" class="text-base font-semibold text-primary-deep">@Model.Titulo</h2>
        @if (Model.VerMas is { } verMas)
        {
            <a asp-controller="@verMas.Controlador" asp-action="@verMas.Accion" asp-all-route-data="verMas.Ruta"
               class="rounded-badge text-sm font-semibold text-primary hover:text-primary-hover hover:underline">@verMas.Descripcion</a>
        }
    </header>

    @if (Model.HuboError)
    {
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Titulo = "No pudimos traer tu historial", Ayuda = Model.Error }' />
    }
    else if (Model.Entradas.Count == 0)
    {
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "historia", Titulo = Model.TextoVacio, Ayuda = Model.AyudaVacio, Accion = Model.AccionVacio }' />
    }
    else
    {
        @* Una línea de tiempo corta: la consulta o receta más reciente con el
           punto lleno, y un ícono que distingue una de otra además del texto. *@
        <div class="px-5 py-4">
            <ol class="linea-tiempo">
                @{ var fila = 0; }
                @foreach (var entrada in Model.Entradas)
                {
                    <li class="fila-animada @(fila == 0 ? "linea-tiempo-reciente" : null) flex items-center gap-3 py-1"
                        style="--i: @(fila++)">
                        <icono nombre="@(entrada.Tipo == "Receta" ? "pastilla" : "historia")" class="size-5 shrink-0 text-primary" />
                        <span class="min-w-0">
                            <span class="block font-medium text-ink">@entrada.Tipo</span>
                            <span class="block truncate text-sm tabular-nums text-muted">@entrada.FechaCorta</span>
                        </span>
                    </li>
                }
            </ol>
        </div>
    }
</section>
