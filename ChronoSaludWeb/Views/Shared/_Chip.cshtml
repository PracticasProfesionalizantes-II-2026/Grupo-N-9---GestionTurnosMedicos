@model ChipViewModel

@functions {
    // Tailwind escanea texto, no ejecuta Razor: cada rama devuelve las clases
    // completas para que las encuentre al compilar el CSS. Cada tono de
    // estado lleva su fondo suave, su borde y su texto oscuro (los tres
    // tokens -soft, -line e -ink del estado en app.css).
    static string ClaseTono(TonoChip tono) => tono switch
    {
        TonoChip.Exito        => "border border-status-confirmado-line bg-status-confirmado-soft text-status-confirmado-ink",
        TonoChip.Aviso        => "border border-status-pendiente-line bg-status-pendiente-soft text-status-pendiente-ink",
        TonoChip.Info         => "border border-status-completado-line bg-status-completado-soft text-status-completado-ink",
        TonoChip.Peligro      => "border border-status-cancelado-line bg-status-cancelado-soft text-status-cancelado-ink",
        TonoChip.Proximamente => "border border-contorno-suave bg-accent-soft text-accent-ink",
        _                     => "border border-control bg-card text-muted",
    };
}

@* La forma sale de la clase chip de app.css; acá se elige el color. *@
<span class="chip shrink-0 @ClaseTono(Model.Tono) @(Model.Capitalizar ? "capitalize" : null)">@Model.Texto</span>
