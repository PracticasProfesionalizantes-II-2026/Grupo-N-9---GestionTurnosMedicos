@model int
@{
    var titulo = ViewData["Titulo"] as string ?? "No encontrado";
    var entidad = ViewData["Entidad"] as string ?? "registro";
    ViewData["Title"] = titulo;
}

<a asp-action="Index"
   class="boton-texto area-tactil text-muted hover:text-primary">
    <icono nombre="volver" class="h-4 w-4" />
    Volver al listado
</a>

@* Única decoración de la pantalla: el motivo de marca con el latido plano,
   porque lo que se buscaba no está. *@
@{ ViewData["MotivoPlano"] = true; }
<div class="mt-6 tarjeta overflow-hidden text-center">
    <div class="mx-auto h-20 max-w-sm px-6 pt-6 sm:h-24">
        <partial name="_MotivoMarca" />
    </div>
    <div class="px-6 pt-4 pb-10 sm:px-10">
        <h1 class="text-2xl font-bold tracking-tight text-ink">@titulo</h1>
        <p class="mx-auto mt-2 max-w-sm text-sm text-muted">
            No existe ningún @entidad con el número <span class="font-medium tabular-nums text-ink">@Model</span>.
            Puede que lo hayan eliminado o que el enlace esté mal.
        </p>
        <a asp-action="Index"
           class="boton boton-primario mt-6">
            Ir al listado
        </a>
    </div>
</div>
