@model IReadOnlyList<MetricaViewModel>

@if (Model.Count > 0)
{
    <div class="grid grid-cols-2 gap-4">
        @{ var indice = 0; }
        @foreach (var metrica in Model)
        {
            @* El acento alterna entre los dos tokens de marca para que dos
               tarjetas contiguas no se lean como una sola. *@
            var claseIcono = indice++ % 2 == 0 ? "text-primary" : "text-accent";

            <div class="rounded-card neu-elevado p-5">
                <div class="flex items-start justify-between gap-2">
                    <div class="flex items-center gap-2 text-sm text-muted">
                        <svg class="h-4 w-4 @claseIcono" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            @Html.Raw(IconosLucide.Trazos(metrica.Icono))
                        </svg>
                        @metrica.Titulo
                    </div>
                    @if (metrica.VerMas is not null)
                    {
                        <partial name="_VerMas" model="metrica.VerMas" />
                    }
                </div>
                <p class="mt-2 text-3xl font-bold tabular-nums text-ink">@metrica.Valor</p>
            </div>
        }
    </div>
}
