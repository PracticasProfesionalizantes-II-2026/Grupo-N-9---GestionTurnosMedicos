@model IReadOnlyList<MetricaViewModel>

@if (Model.Count > 0)
{
    @* Dos columnas mientras cada tarjeta tenga al menos 10rem; si no, una.
       Como es en rem, con la letra extra grande en el celular las tarjetas
       pasan solas a una columna en vez de salirse de la pantalla. *@
    <div class="grid grid-cols-[repeat(auto-fit,minmax(10rem,1fr))] gap-4">
        @{ var indice = 0; }
        @foreach (var metrica in Model)
        {
            @* El acento alterna entre los dos tokens de marca para que dos
               tarjetas contiguas no se lean como una sola. El castaño va con
               accent-ink, que es el que pasa contraste. *@
            var claseIcono = indice++ % 2 == 0 ? "text-primary" : "text-accent-ink";

            <div class="tarjeta p-5">
                <div class="flex items-start justify-between gap-2">
                    <div class="flex items-center gap-2 text-sm text-muted">
                        <svg class="size-4 shrink-0 @claseIcono" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            @Html.Raw(IconosLucide.Trazos(metrica.Icono))
                        </svg>
                        @metrica.Titulo
                    </div>
                    @if (metrica.VerMas is not null)
                    {
                        <partial name="_VerMas" model="metrica.VerMas" />
                    }
                </div>
                <p class="mt-2 text-3xl font-bold tabular-nums text-primary-hover">@metrica.Valor</p>
            </div>
        }
    </div>
}
