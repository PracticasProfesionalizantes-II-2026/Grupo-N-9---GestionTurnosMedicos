@model PanelTurnosViewModel

<section aria-labelledby="titulo-turnos" class="tarjeta overflow-hidden">
    <header class="tarjeta-encabezado flex flex-wrap items-center justify-between gap-x-3 gap-y-1 px-5 py-4">
        <h2 id="titulo-turnos" class="text-base font-semibold text-primary-deep">@Model.Titulo</h2>
        @if (Model.VerMas is { } verMas)
        {
            <a asp-controller="@verMas.Controlador" asp-action="@verMas.Accion" asp-all-route-data="verMas.Ruta"
               class="rounded-badge text-sm font-semibold text-primary hover:text-primary-hover hover:underline">@verMas.Descripcion</a>
        }
    </header>

    @if (Model.Turnos.Count == 0)
    {
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "calendario", Titulo = Model.TextoVacio, Ayuda = Model.AyudaVacio, Accion = Model.AccionVacio }' />
    }
    else
    {
        <ul>
            @{ var fila = 0; }
            @foreach (var turno in Model.Turnos)
            {
                var principal = Model.Vista == VistaPanel.Paciente
                    ? turno.DoctorMostrado
                    : turno.PacienteMostrado;

                var secundario = Model.Vista switch
                {
                    // Al paciente, el día con palabras: "mañana", "viernes 16 de octubre".
                    VistaPanel.Paciente      => turno.DiaParaPaciente,
                    // El panel del doctor muestra los próximos turnos, no solo
                    // los de hoy: sin la fecha no se sabe de qué día es cada uno.
                    VistaPanel.Doctor        => turno.FechaCorta,
                    VistaPanel.Administrador => turno.DoctorMostrado,
                    _                        => null
                };

                // El administrativo ve la agenda del día: le alcanza la hora.
                // Paciente y doctor ven turnos de varios días, y el bloque de
                // calendario les dice de un vistazo cuál es cuál.
                var conCalendario = Model.Vista != VistaPanel.Administrador;

                @* flex-wrap: en el celular con la letra grande, el estado y
                   "Cancelar" bajan a otra línea en vez de salirse de la pantalla.
                   La franja de la izquierda lleva el color del estado, que
                   también dice el chip. *@
                <li class="fila-animada @FranjaEstado.Clase(turno.Estado) flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-border px-5 py-4 last:border-0 hover:bg-primary-soft/50"
                    style="--i: @(fila++)">
                    @if (conCalendario)
                    {
                        <partial name="_FechaTile" model="new FechaTileViewModel { Fecha = turno.FechaInicio }" />
                    }
                    else
                    {
                        <span class="w-12 shrink-0 text-sm font-semibold tabular-nums text-ink">@(turno.Hora ?? "—")</span>
                    }

                    @* basis-36: el nombre nunca queda más angosto que 9rem; si no
                       entra al lado, el chip y "Cancelar" pasan al renglón de abajo. *@
                    <span class="min-w-0 flex-1 basis-36">
                        <a asp-controller="Turnos" asp-action="Detalle" asp-route-id="@turno.IdTurno"
                           class="block truncate rounded-badge font-medium text-ink after:absolute after:inset-0 hover:text-primary">
                            @principal
                            <span class="sr-only">— ver el turno @turno.CuandoParaLector</span>
                        </a>
                        @if (conCalendario)
                        {
                            <span class="block truncate text-sm text-muted">
                                <span class="font-semibold tabular-nums text-ink">@(turno.Hora is null ? "Sin hora" : $"{turno.Hora} hs")</span>
                                @if (secundario is not null)
                                {
                                    <span aria-hidden="true"> · </span>
                                    @secundario
                                }
                            </span>
                        }
                        else if (secundario is not null)
                        {
                            <span class="block truncate text-sm text-muted">
                                @secundario
                                @if (turno.EspecialidadMostrada is not null)
                                {
                                    <span aria-hidden="true"> · </span>
                                    <span class="capitalize">@turno.EspecialidadMostrada</span>
                                }
                            </span>
                        }
                    </span>

                    <partial name="_BadgeEstado" model="turno.Estado" />

                    @* El paciente puede cancelar sus próximos turnos desde acá, mientras
                       no hayan empezado: lleva a la pantalla de confirmación y después
                       vuelve al inicio. El z-10 lo deja por encima del enlace que cubre
                       toda la fila. *@
                    @if (Model.Vista == VistaPanel.Paciente && turno.PuedeCancelarse && !turno.YaEmpezo)
                    {
                        <a asp-controller="Turnos" asp-action="Cancelar" asp-route-id="@turno.IdTurno"
                           asp-route-volver="@Url.Action("Index", "Home")"
                           class="boton-texto area-tactil relative z-10 shrink-0 px-2 py-1 text-status-cancelado">
                            Cancelar
                            <span class="sr-only">el turno con @principal @turno.CuandoParaLector</span>
                        </a>
                    }
                </li>
            }
        </ul>
    }
</section>
