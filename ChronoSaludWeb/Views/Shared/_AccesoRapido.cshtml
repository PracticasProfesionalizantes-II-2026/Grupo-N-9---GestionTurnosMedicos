@model AccesoRapidoViewModel

@if (Model.Habilitado)
{
    @* Tarjeta secundaria: al pasar el mouse el borde pasa a teal y al
       presionar la sombra se achica. *@
    <a asp-controller="@Model.Controlador" asp-action="@Model.Accion" asp-all-route-data="Model.Ruta"
       class="tarjeta tarjeta-enlace flex h-full flex-col items-center justify-center gap-3 px-3 py-5 text-center">
        <span class="circulo-icono flex size-12 items-center justify-center rounded-full">
            <icono nombre="@Model.Icono" class="size-6" />
        </span>
        <span class="text-sm font-medium text-ink">@Model.Titulo</span>
    </a>
}
else
{
    @* Deshabilitado: plano (sin fondo ni sombra, solo el borde arena),
       atenuado y con la etiqueta a opacidad completa. No es un enlace ni
       recibe foco. *@
    <span aria-disabled="true"
          class="flex h-full flex-col items-center justify-center gap-3 rounded-card border-[1.5px] border-dashed border-contorno-suave px-3 py-5 text-center">
        <span class="circulo-icono flex size-12 items-center justify-center rounded-full opacity-60">
            <icono nombre="@Model.Icono" class="size-6" />
        </span>
        <span class="text-sm font-medium text-ink opacity-60">@Model.Titulo</span>
        <partial name="_Chip" model='new ChipViewModel { Texto = "Próximamente", Tono = TonoChip.Proximamente }' />
        @if (Model.Motivo is not null)
        {
            <span class="sr-only">@Model.Motivo</span>
        }
    </span>
}
