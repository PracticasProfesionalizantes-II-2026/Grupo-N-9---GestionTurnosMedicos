@model AccesoRapidoViewModel

@functions {
    // Íconos estilo Lucide: trazo 1.5, sin relleno. Se resuelven acá para que
    // el controlador solo maneje una clave y no marcado.
    static string Trazos(string icono) => icono switch
    {
        "calendario-mas" => """<path d="M8 2v4" /><path d="M16 2v4" /><path d="M21 13V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8" /><path d="M3 10h18" /><path d="M16 19h6" /><path d="M19 16v6" />""",
        "calendario"     => """<path d="M8 2v4" /><path d="M16 2v4" /><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M3 10h18" /><path d="M8 14h.01" /><path d="M12 14h.01" /><path d="M16 14h.01" />""",
        "pastilla"       => """<path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z" /><path d="m8.5 8.5 7 7" />""",
        "escudo"         => """<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" />""",
        "historia"       => """<path d="M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1" /><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><path d="M9 14h6" /><path d="M9 18h4" />""",
        "personas"       => """<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />""",
        "persona-mas"    => """<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M19 8v6" /><path d="M22 11h-6" />""",
        "lupa"           => """<circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />""",
        _                => """<circle cx="12" cy="12" r="10" />""",
    };
}

@* Html.Raw es seguro acá: lo que devuelve Trazos son literales del propio
   archivo, nunca datos de la API ni del usuario. *@
@if (Model.Habilitado)
{
    <a asp-controller="@Model.Controlador" asp-action="@Model.Accion" asp-all-route-data="Model.Ruta"
       class="flex flex-col items-center justify-center gap-2 rounded-card border border-border bg-surface px-3 py-5 text-center transition-colors hover:border-primary-line hover:bg-primary-soft/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">
        <svg class="h-6 w-6 text-primary" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            @Html.Raw(Trazos(Model.Icono))
        </svg>
        <span class="text-sm font-medium text-ink">@Model.Titulo</span>
    </a>
}
else
{
    <span aria-disabled="true" title="@Model.Motivo"
          class="flex cursor-not-allowed flex-col items-center justify-center gap-2 rounded-card border border-dashed border-border bg-surface px-3 py-5 text-center opacity-60">
        <svg class="h-6 w-6 text-muted" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            @Html.Raw(Trazos(Model.Icono))
        </svg>
        <span class="text-sm font-medium text-muted">@Model.Titulo</span>
        <span class="sr-only">No disponible: @Model.Motivo</span>
    </span>
}
