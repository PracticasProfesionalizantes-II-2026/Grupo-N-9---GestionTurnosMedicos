@model AccesoRapidoViewModel

@* Html.Raw es seguro acá: lo que devuelve IconosLucide.Trazos son literales
   del propio código, nunca datos de la API ni del usuario. *@
@if (Model.Habilitado)
{
    <a asp-controller="@Model.Controlador" asp-action="@Model.Accion" asp-all-route-data="Model.Ruta"
       class="flex flex-col items-center justify-center gap-2 rounded-card neu-elevado px-3 py-5 text-center transition-colors hover:bg-primary-soft/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">
        <svg class="h-6 w-6 text-primary" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            @Html.Raw(IconosLucide.Trazos(Model.Icono))
        </svg>
        <span class="text-sm font-medium text-ink">@Model.Titulo</span>
    </a>
}
else
{
    <span aria-disabled="true" title="@Model.Motivo"
          class="flex cursor-not-allowed flex-col items-center justify-center gap-2 rounded-card neu-hundido px-3 py-5 text-center">
        <svg class="h-6 w-6 text-muted" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            @Html.Raw(IconosLucide.Trazos(Model.Icono))
        </svg>
        <span class="text-sm font-medium text-muted">@Model.Titulo</span>
        <span class="sr-only">No disponible: @Model.Motivo</span>
    </span>
}
