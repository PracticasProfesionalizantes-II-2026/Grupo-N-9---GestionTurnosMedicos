@inject AuthService Auth
@functions {
    // Enlace del encabezado. Lo seleccionado va relleno en teal y en negrita,
    // para que no dependa solo del color; el hover es un teal claro.
    const string ClaseEnlace = "block rounded-input px-3 py-2 hover:bg-primary-soft hover:text-primary-hover aria-[current=page]:bg-primary aria-[current=page]:font-semibold aria-[current=page]:text-on-primary aria-[current=page]:hover:bg-primary-hover";
}
@{
    // Tema y escala salen de la cookie del cliente y se emiten en el <html>,
    // donde app.css los espera. Si no hay cookie (o trae basura) quedan los
    // valores por defecto, que no matchean ninguna regla: el aspecto de siempre.
    var preferencias = Context.Request.LeerPreferencias();

    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();

    // El menú se arma una sola vez: lo leen el encabezado, el menú de cuenta y
    // la barra inferior del celular.
    var menu = MenuViewModel.Armar(Auth, controlador, accion);

    var enRegistro = string.Equals(controlador, "Cuenta", StringComparison.OrdinalIgnoreCase)
                     && string.Equals(accion, "Registro", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es" data-theme="@preferencias.Tema" data-scale="@preferencias.Escala">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        var titulo = ViewData["Title"] as string;
    }
    <title>@(string.IsNullOrWhiteSpace(titulo) ? "ChronoSalud" : $"{titulo} · ChronoSalud")</title>

    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />

    <link rel="stylesheet" href="~/css/app.build.css" asp-append-version="true" />

    @* Para lo poco que una vista necesite sumar al <head>, después de la hoja
       de estilos para que le gane (hoy: Recetas/Crear apaga ahí la transición
       entre páginas). *@
    @await RenderSectionAsync("Head", required: false)
</head>
@* Con sesión, en el celular hay una barra fija abajo: el margen inferior evita
   que tape el final de la página (el botón de un formulario, por ejemplo). *@
<body class="min-h-screen bg-canvas font-sans text-ink antialiased @(menu.HaySesion ? "pb-24 md:pb-0" : null)">
    <a href="#contenido" class="saltar boton boton-primario print:hidden">Saltar al contenido</a>

    @* El encabezado no es fijo a propósito: hay pantallas que vuelven ancladas
       a una fila (Recetas/Crear) y un encabezado fijo taparía el ancla. Al
       imprimir (Recetas/Imprimir) no sale, como el pie y la barra del celular. *@
    <header class="barra-superior print:hidden">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-x-4 gap-y-2 px-6 py-3 @(menu.HaySesion ? null : "flex-wrap")">
            <a class="flex items-center gap-2 rounded-input text-lg font-bold tracking-tight text-primary" asp-controller="Home" asp-action="Index">
                <svg class="size-7 shrink-0" viewBox="0 0 32 32" aria-hidden="true">
                    <rect width="32" height="32" rx="7" class="fill-primary" />
                    <path d="M16 8v8l5 3" fill="none" class="stroke-on-primary" stroke-width="3"
                          stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                ChronoSalud
            </a>

            @if (menu.HaySesion)
            {
                @* En el celular estos destinos van en la barra inferior. Si no
                   entran en un renglón (tablet, texto grande) la lista baja a
                   dos en vez de desbordar. *@
                <nav aria-label="Principal" class="hidden min-w-0 flex-1 md:block">
                    <ul class="flex flex-wrap items-center justify-center gap-x-1 text-sm font-medium text-muted">
                        @foreach (var item in menu.Items)
                        {
                            <li>
                                <a asp-controller="@item.Controlador" asp-action="@item.Accion"
                                   aria-current="@(item.Activo ? "page" : null)" class="@ClaseEnlace">@item.Titulo</a>
                            </li>
                        }
                    </ul>
                </nav>

                <partial name="_MenuCuenta" model="menu" />
            }
            else
            {
                @* El tema y el tamaño del texto son del navegador, así que
                   Ajustes también aplica sin estar logueado. *@
                <nav aria-label="Principal">
                    <ul class="flex flex-wrap items-center justify-end gap-x-1 gap-y-2 text-sm font-medium text-muted">
                        <li>
                            <a asp-controller="Ajustes" asp-action="Index"
                               aria-current="@(menu.AjustesActivo ? "page" : null)" class="@ClaseEnlace">Ajustes</a>
                        </li>
                        <li>
                            <a asp-controller="Cuenta" asp-action="Registro"
                               aria-current="@(enRegistro ? "page" : null)" class="@ClaseEnlace">Crear cuenta</a>
                        </li>
                        <li>
                            <a class="boton boton-primario ml-2" asp-controller="Cuenta" asp-action="Login">Ingresar</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </header>

    <main id="contenido" class="mx-auto max-w-6xl px-6 py-10">
        @if (TempData["Exito"] is string mensajeExito)
        {
            <div class="mb-8 flex items-start gap-3 rounded-input border border-status-confirmado-line bg-status-confirmado-soft px-4 py-3 text-sm text-status-confirmado">
                <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="m9 12 2 2 4-4" />
                </svg>
                <span>@mensajeExito</span>
            </div>
        }
        @if (TempData["Error"] is string mensajeError)
        {
            <div class="mb-8 flex items-start gap-3 rounded-input border border-status-cancelado-line bg-status-cancelado-soft px-4 py-3 text-sm text-status-cancelado">
                <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
                    <path d="M12 9v4" />
                    <path d="M12 17h.01" />
                </svg>
                <span>@mensajeError</span>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="border-t border-border print:hidden">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-6 py-6 text-sm text-muted">
            <span>&copy; 2026 ChronoSalud</span>
            <a class="hover:text-primary" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>

    @if (menu.HaySesion)
    {
        <partial name="_BarraInferior" model="menu" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
