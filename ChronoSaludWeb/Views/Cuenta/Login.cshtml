@model LoginViewModel
@{
    ViewData["Title"] = "Ingresar";
    var erroresGenerales = ViewData.ModelState[string.Empty]?.Errors;
}

@* Tarjeta de acceso: el formulario y, como única decoración de la pantalla,
   el motivo de marca. En el celular el motivo va arriba y chico; desde md
   pasa a una segunda columna a la derecha. *@
<div class="tarjeta mx-auto max-w-md overflow-hidden md:grid md:max-w-4xl md:grid-cols-2">
    <div class="h-24 px-6 pt-6 md:order-last md:flex md:h-auto md:items-center md:p-10">
        <partial name="_MotivoMarca" />
    </div>

    <div class="p-6 sm:p-8">
        <h1 class="text-2xl font-bold tracking-tight text-ink">Ingresar</h1>
        <p class="mt-2 text-sm text-muted">Usá el email y la contraseña de tu cuenta de ChronoSalud.</p>

        @if (erroresGenerales is { Count: > 0 })
        {
            <div role="alert" class="mt-6 rounded-input border border-status-cancelado-line bg-status-cancelado-soft px-4 py-3 text-sm text-status-cancelado">
                @foreach (var error in erroresGenerales)
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="Login" method="post" novalidate class="mt-6">
            <input type="hidden" asp-for="ReturnUrl" />

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-ink"></label>
                <input asp-for="Email" autocomplete="email" autofocus placeholder="tu@@email.com" class="campo mt-1.5" />
                <span asp-validation-for="Email" class="mt-1 block text-xs text-status-cancelado"></span>
            </div>

            <div class="mt-5">
                <label asp-for="Contrasena" class="block text-sm font-medium text-ink"></label>
                <input asp-for="Contrasena" autocomplete="current-password" placeholder="••••••••" class="campo mt-1.5" />
                <span asp-validation-for="Contrasena" class="mt-1 block text-xs text-status-cancelado"></span>
                @* Donde lo busca cualquiera: debajo de la contraseña. *@
                <a asp-action="Recuperar" class="mt-2 inline-block rounded-badge text-sm font-semibold text-primary hover:underline">¿Olvidaste tu contraseña?</a>
            </div>

            <button type="submit" class="boton boton-primario mt-7 w-full">Ingresar</button>
        </form>

        <p class="mt-6 text-sm text-muted">
            ¿No tenés cuenta?
            <a asp-controller="Cuenta" asp-action="Registro" class="rounded-badge font-semibold text-primary hover:underline">Crear cuenta</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
