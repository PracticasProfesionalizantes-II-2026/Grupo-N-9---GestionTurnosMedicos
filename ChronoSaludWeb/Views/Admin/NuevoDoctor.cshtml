@model NuevoDoctorViewModel
@{
    ViewData["Title"] = "Nuevo doctor";
    var erroresGenerales = ViewData.ModelState[string.Empty]?.Errors;
    const string claseCampo = "mt-1.5 w-full rounded-input border border-primary-line bg-field px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary-soft";
    const string claseError = "mt-1 block text-xs text-status-cancelado";
}

<a asp-action="Index"
   class="inline-flex items-center gap-1.5 rounded-badge text-sm font-medium text-muted hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    Volver a Cuentas
</a>

<div class="mt-6 max-w-2xl">
    <h1 class="text-2xl font-bold tracking-tight text-ink">Nuevo doctor</h1>
    <p class="mt-1 text-sm text-muted">
        Se hacen dos llamadas a la API: primero se crea el usuario con rol
        doctor y después se completa su perfil (especialidad, matrícula,
        consultorio).
    </p>

    <div class="mt-6 rounded-card border border-border bg-surface p-8">
        @if (erroresGenerales is { Count: > 0 })
        {
            <div class="mb-6 flex items-start gap-3 rounded-input border border-status-cancelado/40 bg-status-cancelado/10 px-4 py-3 text-sm text-status-cancelado">
                <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
                    <path d="M12 9v4" />
                    <path d="M12 17h.01" />
                </svg>
                <span>
                    @foreach (var error in erroresGenerales)
                    {
                        <span class="block">@error.ErrorMessage</span>
                    }
                    @if (Model.IdUsuarioCreado is { } idUsuarioCreado)
                    {
                        <span class="mt-2 block">
                            <a asp-controller="Admin" asp-action="CompletarDoctor" asp-route-idUsuario="@idUsuarioCreado"
                               class="font-semibold underline hover:no-underline">
                                Completar el perfil de doctor del usuario Id @idUsuarioCreado
                            </a>
                        </span>
                    }
                </span>
            </div>
        }

        <form asp-action="NuevoDoctor" method="post" novalidate>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Datos de la cuenta</h2>
            <div class="mt-3 grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="Nombre" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Nombre" class="@claseCampo" />
                    <span asp-validation-for="Nombre" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Apellido" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Apellido" class="@claseCampo" />
                    <span asp-validation-for="Apellido" class="@claseError"></span>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="Email" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Email" autocomplete="off" placeholder="doctor@@email.com" class="@claseCampo" />
                    <span asp-validation-for="Email" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Contrasena" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Contrasena" autocomplete="new-password" placeholder="••••••••" class="@claseCampo" />
                    <span asp-validation-for="Contrasena" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Telefono" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Telefono" placeholder="Opcional" class="@claseCampo" />
                    <span asp-validation-for="Telefono" class="@claseError"></span>
                </div>
            </div>

            <h2 class="mt-7 text-sm font-semibold uppercase tracking-wide text-muted">Perfil profesional</h2>
            <div class="mt-3 grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="Especialidad" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Especialidad" class="@claseCampo" />
                    <span asp-validation-for="Especialidad" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Matricula" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Matricula" class="@claseCampo" />
                    <span asp-validation-for="Matricula" class="@claseError"></span>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="Consultorio" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Consultorio" placeholder="Opcional" class="@claseCampo" />
                    <span asp-validation-for="Consultorio" class="@claseError"></span>
                </div>
            </div>

            <div class="mt-7 flex flex-wrap items-center gap-3">
                <button type="submit"
                        class="rounded-input bg-primary px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-hover focus:outline-none focus:ring-2 focus:ring-primary-soft">
                    Crear doctor
                </button>
                <a asp-action="Index"
                   class="rounded-input border border-border px-4 py-2.5 text-sm font-semibold text-muted hover:bg-canvas hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
