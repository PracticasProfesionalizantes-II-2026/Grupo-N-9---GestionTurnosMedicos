@model NuevoDoctorViewModel
@{
    ViewData["Title"] = "Nuevo doctor";
    var erroresGenerales = ViewData.ModelState[string.Empty]?.Errors;
    const string claseCampo = "campo mt-1.5";
    const string claseError = "mt-1 block text-xs text-status-cancelado";
}

<a asp-action="Index"
   class="boton-texto area-tactil text-muted hover:text-primary">
    <icono nombre="volver" class="h-4 w-4" />
    Volver a Cuentas
</a>

<div class="mt-6 max-w-2xl">
    <h1 class="text-2xl font-bold tracking-tight text-ink">Nuevo doctor</h1>
    <p class="mt-1 text-sm text-muted">
        El alta se hace en dos pasos: primero se crea la cuenta con rol
        doctor y después se completa su perfil (especialidad, matrícula,
        consultorio).
    </p>

    <div class="mt-6 tarjeta p-5 sm:p-8">
        @if (erroresGenerales is { Count: > 0 })
        {
            <div role="alert" class="aviso aviso-error mb-6">
                <icono nombre="alerta" class="mt-0.5 h-4 w-4 shrink-0" />
                <span>
                    @foreach (var error in erroresGenerales)
                    {
                        <span class="block">@error.ErrorMessage</span>
                    }
                    @if (Model.IdUsuarioCreado is { } idUsuarioCreado)
                    {
                        <span class="mt-2 block">
                            <a asp-controller="Usuarios" asp-action="Editar" asp-route-id="@idUsuarioCreado"
                               class="font-semibold underline hover:no-underline">
                                Completar el perfil profesional de la cuenta recién creada
                            </a>
                        </span>
                    }
                </span>
            </div>
        }

        <form asp-action="NuevoDoctor" method="post" novalidate>
            <h2 class="text-base font-semibold text-ink">Datos de la cuenta</h2>
            <div class="mt-3 grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="Nombre" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Nombre" autocomplete="off" spellcheck="false" class="@claseCampo" />
                    <span asp-validation-for="Nombre" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Apellido" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Apellido" autocomplete="off" spellcheck="false" class="@claseCampo" />
                    <span asp-validation-for="Apellido" class="@claseError"></span>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="Email" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Email" autocomplete="off" spellcheck="false" autocapitalize="none" placeholder="doctor@@email.com" class="@claseCampo" />
                    <span asp-validation-for="Email" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Contrasena" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Contrasena" autocomplete="new-password" placeholder="••••••••" class="@claseCampo" />
                    <span asp-validation-for="Contrasena" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Telefono" class="block text-sm font-medium text-ink">Teléfono <span class="font-normal text-muted">(opcional)</span></label>
                    <input asp-for="Telefono" type="tel" autocomplete="off" placeholder="11 2345-6789" class="@claseCampo" />
                    <span asp-validation-for="Telefono" class="@claseError"></span>
                </div>
            </div>

            <h2 class="mt-7 text-base font-semibold text-ink">Perfil profesional</h2>
            <div class="mt-3 grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="Especialidad" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Especialidad" autocomplete="off" placeholder="Cardiología" class="@claseCampo" />
                    <span asp-validation-for="Especialidad" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Matricula" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Matricula" autocomplete="off" spellcheck="false" placeholder="MN 123456" class="@claseCampo" />
                    <span asp-validation-for="Matricula" class="@claseError"></span>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="Consultorio" class="block text-sm font-medium text-ink">Consultorio <span class="font-normal text-muted">(opcional)</span></label>
                    <input asp-for="Consultorio" autocomplete="off" placeholder="Consultorio 101" class="@claseCampo" />
                    <span asp-validation-for="Consultorio" class="@claseError"></span>
                </div>
            </div>

            <div class="mt-7 flex flex-wrap items-center gap-3">
                <button type="submit" data-cargando="Creando…"
                        class="boton boton-primario">
                    Crear doctor
                </button>
                <a asp-action="Index"
                   class="boton boton-secundario">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
