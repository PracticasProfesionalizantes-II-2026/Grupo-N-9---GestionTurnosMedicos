@model NuevoAdministradorViewModel
@{
    ViewData["Title"] = "Nuevo administrador";
    var erroresGenerales = ViewData.ModelState[string.Empty]?.Errors;
    const string claseCampo = "campo mt-1.5";
    const string claseError = "mt-1 block text-xs text-status-cancelado";
}

<a asp-action="Index"
   class="boton-texto area-tactil text-muted hover:text-primary">
    <icono nombre="volver" class="h-4 w-4" />
    Volver a Cuentas
</a>

<div class="mt-6 max-w-2xl">
    <h1 class="text-2xl font-bold tracking-tight text-ink">Nuevo administrador</h1>
    <p class="mt-1 text-sm text-muted">
        Un solo paso: los administradores no tienen datos de perfil para completar.
    </p>

    <div class="mt-6 tarjeta p-5 sm:p-8">
        @if (erroresGenerales is { Count: > 0 })
        {
            <div role="alert" class="aviso aviso-error mb-6">
                <icono nombre="alerta" />
                <div>
                    @foreach (var error in erroresGenerales)
                    {
                        <p>@error.ErrorMessage</p>
                    }
                </div>
            </div>
        }

        <form asp-action="NuevoAdministrador" method="post" novalidate>
            <h2 class="text-base font-semibold text-ink">Datos de la cuenta</h2>
            <div class="mt-3 grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="Nombre" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Nombre" autocomplete="off" spellcheck="false" class="@claseCampo" />
                    <span asp-validation-for="Nombre" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Apellido" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Apellido" autocomplete="off" spellcheck="false" class="@claseCampo" />
                    <span asp-validation-for="Apellido" class="@claseError"></span>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="Email" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Email" autocomplete="off" spellcheck="false" autocapitalize="none" placeholder="admin@@email.com" class="@claseCampo" />
                    <span asp-validation-for="Email" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Contrasena" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Contrasena" autocomplete="new-password" placeholder="••••••••" class="@claseCampo" />
                    <span asp-validation-for="Contrasena" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Telefono" class="block text-sm font-medium text-ink">Teléfono <span class="font-normal text-muted">(opcional)</span></label>
                    <input asp-for="Telefono" type="tel" autocomplete="off" placeholder="11 2345-6789" class="@claseCampo" />
                    <span asp-validation-for="Telefono" class="@claseError"></span>
                </div>
            </div>

            <div class="mt-7 flex flex-wrap items-center gap-3">
                <button type="submit" data-cargando="Creando…"
                        class="boton boton-primario">
                    Crear administrador
                </button>
                <a asp-action="Index"
                   class="boton boton-secundario">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
