@model CoberturasIndexViewModel
@{
    ViewData["Title"] = "Coberturas";
}

<div>
    <h1 class="text-2xl font-bold tracking-tight text-ink">Coberturas</h1>
    <p class="mt-1 text-sm text-muted">Obras sociales y prepagas dadas de alta en el sistema.</p>
</div>

@* Buscador por GET: la API resuelve el nombre como «contiene». *@
<form method="get" asp-action="Index"
      class="mt-6 flex flex-wrap items-end gap-4 tarjeta p-5">
    <div class="w-full flex-1 sm:min-w-64">
        <label for="nombre" class="block text-sm font-medium text-ink">Buscar por nombre</label>
        <input id="nombre" name="nombre" type="search" value="@Model.Nombre" placeholder="Por ejemplo: OSDE…"
               autocomplete="off" spellcheck="false"
               class="campo mt-1.5" />
    </div>

    <div class="flex items-center gap-2">
        <button type="submit"
                class="boton boton-primario">
            Buscar
        </button>
        @if (Model.HayFiltro)
        {
            <a asp-action="Index"
               class="boton boton-secundario">
                Limpiar
            </a>
        }
    </div>
</form>

@if (Model.HuboError)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudieron cargar las coberturas", Ayuda = Model.Error, Accion = new EnlaceViewModel { Controlador = "Coberturas", Accion = "Index", Descripcion = "Reintentar" } }' />
    </div>
}
else if (Model.Coberturas.Count == 0)
{
    <div class="tarjeta mt-6">
        @if (Model.SinResultados)
        {
            <partial name="_EstadoVacio"
                     model='new EstadoVacioViewModel { Icono = "escudo", Nivel = 2, Titulo = "Ninguna cobertura coincide con la búsqueda", Ayuda = "Probá con otro nombre, o con una parte más corta.", Accion = new EnlaceViewModel { Controlador = "Coberturas", Accion = "Index", Descripcion = "Limpiar búsqueda" } }' />
        }
        else
        {
            <partial name="_EstadoVacio"
                     model='new EstadoVacioViewModel { Icono = "escudo", Nivel = 2, Titulo = "No hay coberturas cargadas", Ayuda = "Cuando se den de alta coberturas van a aparecer en esta lista." }' />
        }
    </div>
}
else
{
    <div class="mt-6 overflow-hidden tarjeta">
        <ul>
            @{ var fila = 0; }
            @foreach (var cobertura in Model.Coberturas)
            {
                <li class="fila-animada flex items-center gap-4 border-b border-border px-5 py-4 last:border-0"
                    style="--i: @(fila++)">
                    <span aria-hidden="true"
                          class="flex size-9 shrink-0 items-center justify-center rounded-full circulo-icono">
                        <icono nombre="escudo" class="size-4" />
                    </span>
                    <span class="min-w-0 flex-1">
                        <span class="block truncate font-medium text-ink">@cobertura.Nombre</span>
                        @if (!string.IsNullOrWhiteSpace(cobertura.Plan))
                        {
                            <span class="block truncate text-sm text-muted">Plan @cobertura.Plan</span>
                        }
                    </span>
                </li>
            }
        </ul>
    </div>
}
