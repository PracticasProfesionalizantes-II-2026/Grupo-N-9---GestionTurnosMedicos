@model ChronoSaludWeb.Models.ViewModels.PacienteCreateViewModel
@{
    ViewData["Title"] = "Agregar paciente";
    var erroresGenerales = ViewData.ModelState[string.Empty]?.Errors;
    // asp-for agrega input-validation-error al campo con error: la variante
    // arbitraria pinta el borde con el color de error sin JavaScript.
    const string claseCampo = "mt-1.5 w-full rounded-input border border-primary-line bg-white px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary-soft [&.input-validation-error]:border-status-cancelado [&.input-validation-error]:focus:ring-status-cancelado/20";
    const string claseEtiqueta = "block text-sm font-medium text-ink";
    const string claseError = "mt-1 block text-xs text-status-cancelado";
    const string claseSeccion = "text-sm font-semibold uppercase tracking-wide text-muted";
    const string claseBotonSecundario = "rounded-input border border-border px-4 py-2.5 text-sm font-semibold text-muted hover:bg-canvas hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft";
}

<a asp-action="Index"
   class="inline-flex items-center gap-1.5 rounded-badge text-sm font-medium text-muted hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    Volver a Pacientes
</a>

<div class="mt-6">
    <h1 class="text-2xl font-bold tracking-tight text-ink">Agregar Nuevo Paciente</h1>
    <p class="mt-1 text-sm text-muted">
        Crea la cuenta del paciente: con el email y la contraseña va a poder ingresar al sistema.
    </p>

    <div class="mt-6 rounded-card border border-border bg-surface p-8">
        @if (erroresGenerales is { Count: > 0 })
        {
            <div class="mb-6 rounded-input border border-status-cancelado/40 bg-status-cancelado/10 px-4 py-3 text-sm text-status-cancelado">
                @foreach (var error in erroresGenerales)
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="Crear" method="post" enctype="multipart/form-data" novalidate>
            <h2 class="@claseSeccion">Datos personales</h2>
            <div class="mt-3 grid gap-6 lg:grid-cols-[1fr_auto]">
                <div class="grid content-start gap-5 sm:grid-cols-2">
                    <div>
                        <label asp-for="Nombre" class="@claseEtiqueta"></label>
                        <input asp-for="Nombre" autocomplete="off" class="@claseCampo" />
                        <span asp-validation-for="Nombre" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="Apellido" class="@claseEtiqueta"></label>
                        <input asp-for="Apellido" autocomplete="off" class="@claseCampo" />
                        <span asp-validation-for="Apellido" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="TipoDocumento" class="@claseEtiqueta"></label>
                        <select asp-for="TipoDocumento" asp-items="Model.TiposDocumento" class="@claseCampo">
                            <option value="">Seleccionar</option>
                        </select>
                        <span asp-validation-for="TipoDocumento" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="NumeroDocumento" class="@claseEtiqueta"></label>
                        <input asp-for="NumeroDocumento" autocomplete="off" class="@claseCampo" />
                        <span asp-validation-for="NumeroDocumento" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="FechaNacimiento" class="@claseEtiqueta"></label>
                        <input asp-for="FechaNacimiento" type="date" class="@claseCampo" />
                        <span asp-validation-for="FechaNacimiento" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="Genero" class="@claseEtiqueta"></label>
                        <select asp-for="Genero" asp-items="Model.Generos" class="@claseCampo">
                            <option value="">Seleccionar</option>
                        </select>
                        <span asp-validation-for="Genero" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="Nacionalidad" class="@claseEtiqueta"></label>
                        <input asp-for="Nacionalidad" class="@claseCampo" />
                        <span asp-validation-for="Nacionalidad" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="EstadoCivil" class="@claseEtiqueta"></label>
                        <select asp-for="EstadoCivil" asp-items="Model.EstadosCiviles" class="@claseCampo">
                            <option value="">Seleccionar</option>
                        </select>
                        <span asp-validation-for="EstadoCivil" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="GrupoSanguineo" class="@claseEtiqueta"></label>
                        <select asp-for="GrupoSanguineo" asp-items="Model.GruposSanguineos" class="@claseCampo">
                            <option value="">Sin especificar</option>
                        </select>
                        <span asp-validation-for="GrupoSanguineo" class="@claseError"></span>
                    </div>

                    <div class="flex items-end pb-2">
                        <label class="inline-flex items-center gap-2 text-sm font-medium text-ink">
                            <input asp-for="TieneObraSocial" class="h-4 w-4 rounded-badge accent-primary" />
                            Tiene obra social
                        </label>
                    </div>

                    <div>
                        <label asp-for="ObraSocial" class="@claseEtiqueta"></label>
                        <input asp-for="ObraSocial" placeholder="Opcional" class="@claseCampo" />
                        <span asp-validation-for="ObraSocial" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="NumeroAfiliado" class="@claseEtiqueta"></label>
                        <input asp-for="NumeroAfiliado" placeholder="Opcional" class="@claseCampo" />
                        <span asp-validation-for="NumeroAfiliado" class="@claseError"></span>
                    </div>
                </div>

                @* El input de archivo queda oculto y el label for="Foto" funciona
                   como botón: abrir el selector no necesita JavaScript. *@
                <div>
                    <div class="flex size-50 flex-col items-center justify-center gap-3 rounded-card border-2 border-dashed border-primary-line bg-white p-4 text-center">
                        <svg class="h-10 w-10 text-primary-line" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="8" r="5" />
                            <path d="M20 21a8 8 0 0 0-16 0" />
                        </svg>
                        <span class="text-sm text-muted">Foto del paciente</span>
                        <label for="Foto"
                               class="cursor-pointer rounded-input border border-primary-line px-3 py-1.5 text-sm font-semibold text-primary hover:bg-primary-soft">
                            Seleccionar foto
                        </label>
                    </div>
                    <input asp-for="Foto" type="file" accept="image/*" class="sr-only" />
                    <span asp-validation-for="Foto" class="@claseError"></span>
                </div>
            </div>

            <h2 class="@claseSeccion mt-8 border-t border-border pt-6">Datos de contacto</h2>
            <div class="mt-3 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                <div>
                    <label asp-for="Email" class="@claseEtiqueta"></label>
                    <input asp-for="Email" autocomplete="off" placeholder="paciente@@email.com" class="@claseCampo" />
                    <span asp-validation-for="Email" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Contrasena" class="@claseEtiqueta"></label>
                    <input asp-for="Contrasena" autocomplete="new-password" placeholder="••••••••"
                           aria-describedby="ayuda-contrasena" class="@claseCampo" />
                    <span asp-validation-for="Contrasena" class="@claseError"></span>
                    <p id="ayuda-contrasena" class="mt-1 text-xs text-muted">
                        Contraseña inicial con la que el paciente va a ingresar.
                    </p>
                </div>

                <div>
                    <label asp-for="ConfirmarContrasena" class="@claseEtiqueta"></label>
                    <input asp-for="ConfirmarContrasena" autocomplete="new-password" placeholder="••••••••" class="@claseCampo" />
                    <span asp-validation-for="ConfirmarContrasena" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Telefono" class="@claseEtiqueta"></label>
                    <input asp-for="Telefono" class="@claseCampo" />
                    <span asp-validation-for="Telefono" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Direccion" class="@claseEtiqueta"></label>
                    <input asp-for="Direccion" class="@claseCampo" />
                    <span asp-validation-for="Direccion" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="CodigoPostal" class="@claseEtiqueta"></label>
                    <input asp-for="CodigoPostal" placeholder="Opcional" class="@claseCampo" />
                    <span asp-validation-for="CodigoPostal" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Provincia" class="@claseEtiqueta"></label>
                    <select asp-for="Provincia" asp-items="Model.Provincias" class="@claseCampo">
                        <option value="">Seleccionar</option>
                    </select>
                    <span asp-validation-for="Provincia" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Localidad" class="@claseEtiqueta"></label>
                    <input asp-for="Localidad" class="@claseCampo" />
                    <span asp-validation-for="Localidad" class="@claseError"></span>
                </div>
            </div>

            <h2 class="@claseSeccion mt-8 border-t border-border pt-6">Contacto de emergencia</h2>
            <div class="mt-3 grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="ContactoEmergenciaNombre" class="@claseEtiqueta"></label>
                    <input asp-for="ContactoEmergenciaNombre" placeholder="Opcional" class="@claseCampo" />
                    <span asp-validation-for="ContactoEmergenciaNombre" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="ContactoEmergenciaTelefono" class="@claseEtiqueta"></label>
                    <input asp-for="ContactoEmergenciaTelefono" placeholder="Opcional" class="@claseCampo" />
                    <span asp-validation-for="ContactoEmergenciaTelefono" class="@claseError"></span>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="Alergias" class="@claseEtiqueta"></label>
                    <textarea asp-for="Alergias" rows="3" placeholder="Opcional" class="@claseCampo"></textarea>
                    <span asp-validation-for="Alergias" class="@claseError"></span>
                </div>
            </div>

            <div class="mt-8 flex flex-wrap items-center justify-end gap-3">
                <button type="submit"
                        class="rounded-input bg-primary px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-hover focus:outline-none focus:ring-2 focus:ring-primary-soft">
                    Guardar
                </button>
                @* Enlace y no type="reset": tras un POST fallido, reset volvería a
                   los valores enviados en lugar de vaciar el formulario. *@
                <a asp-action="Crear" class="@claseBotonSecundario">
                    Limpiar campos
                </a>
                <a asp-action="Index" class="@claseBotonSecundario">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>
