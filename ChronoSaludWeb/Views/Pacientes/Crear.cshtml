@model ChronoSaludWeb.Models.ViewModels.PacienteCreateViewModel
@{
    ViewData["Title"] = "Agregar paciente";
    var erroresGenerales = ViewData.ModelState[string.Empty]?.Errors;
    // asp-for agrega input-validation-error al campo con error: la clase
    // campo de app.css le pinta el borde con el color de error, sin JavaScript.
    const string claseCampo = "campo mt-1.5";
    const string claseEtiqueta = "block text-sm font-medium text-ink";
    const string claseError = "mt-1 block text-xs text-status-cancelado";
    const string claseSeccion = "text-base font-semibold text-ink";
    const string claseBotonSecundario = "boton boton-secundario";
}

<a asp-action="Index"
   class="boton-texto area-tactil text-muted hover:text-primary">
    <icono nombre="volver" class="h-4 w-4" />
    Volver a pacientes
</a>

<div class="mt-6">
    <h1 class="text-2xl font-bold tracking-tight text-ink">Agregar nuevo paciente</h1>
    <p class="mt-1 text-sm text-muted">
        Crea la cuenta del paciente: con el email y la contraseña va a poder ingresar al sistema.
    </p>

    <div class="mt-6 tarjeta p-5 sm:p-8">
        @if (erroresGenerales is { Count: > 0 })
        {
            <div role="alert" class="aviso aviso-error mb-6">
                <icono nombre="alerta" />
                <div>
                    @foreach (var error in erroresGenerales)
                    {
                        <p>@error.ErrorMessage</p>
                    }
                </div>
            </div>
        }

        <form asp-action="Crear" method="post" enctype="multipart/form-data" novalidate data-avisar-cambios>
            <h2 class="@claseSeccion">Datos personales</h2>
            <div class="mt-3 grid gap-6 lg:grid-cols-[1fr_auto]">
                <div class="grid content-start gap-5 sm:grid-cols-2">
                    <div>
                        <label asp-for="Nombre" class="@claseEtiqueta"></label>
                        <input asp-for="Nombre" autocomplete="off" spellcheck="false" class="@claseCampo" />
                        <span asp-validation-for="Nombre" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="Apellido" class="@claseEtiqueta"></label>
                        <input asp-for="Apellido" autocomplete="off" spellcheck="false" class="@claseCampo" />
                        <span asp-validation-for="Apellido" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="TipoDocumento" class="@claseEtiqueta"></label>
                        <select asp-for="TipoDocumento" asp-items="Model.TiposDocumento" class="@claseCampo">
                            <option value="">Seleccionar</option>
                        </select>
                        <span asp-validation-for="TipoDocumento" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="NumeroDocumento" class="@claseEtiqueta"></label>
                        <input asp-for="NumeroDocumento" autocomplete="off" inputmode="numeric" spellcheck="false" placeholder="30111222" class="@claseCampo tabular-nums" />
                        <span asp-validation-for="NumeroDocumento" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="FechaNacimiento" class="@claseEtiqueta"></label>
                        <input asp-for="FechaNacimiento" type="date" autocomplete="off" class="@claseCampo tabular-nums" />
                        <span asp-validation-for="FechaNacimiento" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="Sexo" class="@claseEtiqueta"></label>
                        <select asp-for="Sexo" asp-items="Model.Sexos" class="@claseCampo capitalize">
                            <option value="">Sin especificar</option>
                        </select>
                        <span asp-validation-for="Sexo" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="Nacionalidad" class="@claseEtiqueta"></label>
                        <input asp-for="Nacionalidad" autocomplete="off" class="@claseCampo" />
                        <span asp-validation-for="Nacionalidad" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="EstadoCivil" class="@claseEtiqueta"></label>
                        <select asp-for="EstadoCivil" asp-items="Model.EstadosCiviles" class="@claseCampo">
                            <option value="">Seleccionar</option>
                        </select>
                        <span asp-validation-for="EstadoCivil" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="GrupoSanguineo" class="@claseEtiqueta"></label>
                        <select asp-for="GrupoSanguineo" asp-items="Model.GruposSanguineos" class="@claseCampo">
                            <option value="">Sin especificar</option>
                        </select>
                        <span asp-validation-for="GrupoSanguineo" class="@claseError"></span>
                    </div>
                </div>

                @* La foto es opcional. El campo de archivo queda a la vista: sin
                   JavaScript es la única forma de ver qué archivo se eligió, y
                   así se usa con el teclado como cualquier otro campo. Acepta
                   los mismos formatos que revisa ValidadorDeImagen. *@
                <div class="self-start rounded-card border-[1.5px] border-dashed border-contorno bg-surface p-4 lg:w-64">
                    <div class="flex items-center gap-3">
                        <icono nombre="persona" class="size-10 shrink-0 text-primary-line" />
                        <label asp-for="Foto" class="@claseEtiqueta">Foto del paciente (opcional)</label>
                    </div>
                    <input asp-for="Foto" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="ayuda-foto"
                           class="mt-3 block w-full text-sm text-ink file:mr-3 file:cursor-pointer file:rounded-input file:border file:border-solid file:border-control file:bg-card file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-primary hover:file:bg-primary-soft" />
                    <p id="ayuda-foto" class="mt-2 text-xs text-muted">
                        JPG, PNG o WebP, hasta 2 MB. Si el formulario vuelve con un error, elegí la foto de nuevo.
                    </p>
                    <span asp-validation-for="Foto" class="@claseError"></span>
                </div>
            </div>

            <h2 class="@claseSeccion mt-8 border-t border-border pt-6">Datos de contacto</h2>
            <div class="mt-3 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                <div>
                    <label asp-for="Email" class="@claseEtiqueta"></label>
                    <input asp-for="Email" autocomplete="off" spellcheck="false" autocapitalize="none" placeholder="paciente@@email.com" class="@claseCampo" />
                    <span asp-validation-for="Email" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Contrasena" class="@claseEtiqueta"></label>
                    <input asp-for="Contrasena" autocomplete="new-password" placeholder="••••••••"
                           aria-describedby="ayuda-contrasena" class="@claseCampo" />
                    <span asp-validation-for="Contrasena" class="@claseError"></span>
                    <p id="ayuda-contrasena" class="mt-1 text-xs text-muted">
                        Contraseña inicial con la que el paciente va a ingresar.
                    </p>
                </div>

                <div>
                    <label asp-for="ConfirmarContrasena" class="@claseEtiqueta"></label>
                    <input asp-for="ConfirmarContrasena" autocomplete="new-password" placeholder="••••••••" class="@claseCampo" />
                    <span asp-validation-for="ConfirmarContrasena" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Telefono" class="@claseEtiqueta"></label>
                    <input asp-for="Telefono" type="tel" autocomplete="off" placeholder="11 2345-6789" class="@claseCampo" />
                    <span asp-validation-for="Telefono" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Direccion" class="@claseEtiqueta"></label>
                    <input asp-for="Direccion" autocomplete="off" class="@claseCampo" />
                    <span asp-validation-for="Direccion" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="CodigoPostal" class="@claseEtiqueta">@Html.DisplayNameFor(m => m.CodigoPostal) <span class="font-normal text-muted">(opcional)</span></label>
                    <input asp-for="CodigoPostal" autocomplete="off" spellcheck="false" autocapitalize="characters" placeholder="C1425" class="@claseCampo" />
                    <span asp-validation-for="CodigoPostal" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Provincia" class="@claseEtiqueta"></label>
                    <select asp-for="Provincia" asp-items="Model.Provincias" class="@claseCampo">
                        <option value="">Seleccionar</option>
                    </select>
                    <span asp-validation-for="Provincia" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Localidad" class="@claseEtiqueta"></label>
                    <input asp-for="Localidad" autocomplete="off" class="@claseCampo" />
                    <span asp-validation-for="Localidad" class="@claseError"></span>
                </div>
            </div>

            <h2 class="@claseSeccion mt-8 border-t border-border pt-6">Contacto de emergencia</h2>
            <div class="mt-3 grid gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="ContactoEmergenciaNombre" class="@claseEtiqueta">@Html.DisplayNameFor(m => m.ContactoEmergenciaNombre) <span class="font-normal text-muted">(opcional)</span></label>
                    <input asp-for="ContactoEmergenciaNombre" autocomplete="off" spellcheck="false" class="@claseCampo" />
                    <span asp-validation-for="ContactoEmergenciaNombre" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="ContactoEmergenciaTelefono" class="@claseEtiqueta">@Html.DisplayNameFor(m => m.ContactoEmergenciaTelefono) <span class="font-normal text-muted">(opcional)</span></label>
                    <input asp-for="ContactoEmergenciaTelefono" type="tel" autocomplete="off" placeholder="11 2345-6789" class="@claseCampo" />
                    <span asp-validation-for="ContactoEmergenciaTelefono" class="@claseError"></span>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="Alergias" class="@claseEtiqueta">@Html.DisplayNameFor(m => m.Alergias) <span class="font-normal text-muted">(opcional)</span></label>
                    <textarea asp-for="Alergias" rows="3" placeholder="Por ejemplo: penicilina…" class="@claseCampo"></textarea>
                    <span asp-validation-for="Alergias" class="@claseError"></span>
                </div>
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-3">
                <button type="submit" data-cargando="Guardando…"
                        class="boton boton-primario">
                    Guardar
                </button>
                @* Enlace y no type="reset": tras un POST fallido, reset volvería a
                   los valores enviados en lugar de vaciar el formulario. Si ya
                   se escribió algo, el navegador pregunta antes de borrarlo
                   (data-avisar-cambios). *@
                <a asp-action="Crear" class="@claseBotonSecundario">
                    Limpiar campos
                </a>
                <a asp-action="Index" class="@claseBotonSecundario">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>
