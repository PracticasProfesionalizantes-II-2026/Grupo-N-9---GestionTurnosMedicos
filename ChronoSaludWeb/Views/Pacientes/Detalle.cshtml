@model PacienteDetalleViewModel
@inject AuthService Auth
@{
    ViewData["Title"] = Model.HuboError ? "Paciente" : Model.NombreCompleto;
}

<a asp-action="Index"
   class="boton-texto text-muted hover:text-primary">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    Volver a pacientes
</a>

@if (Model.HuboError)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudo cargar el paciente", Ayuda = Model.Error, Accion = new EnlaceViewModel { Controlador = "Pacientes", Accion = "Detalle", Ruta = new Dictionary<string, string> { ["id"] = $"{Model.IdPaciente}" }, Descripcion = "Reintentar" } }' />
    </div>
}
else
{
    <div class="mt-6 flex items-center gap-4">
        <partial name="_Avatar"
         model='new AvatarViewModel { Nombre = $"{Model.Nombre} {Model.Apellido}", FotoUrl = Model.FotoUrl, Tamano = TamanoAvatar.Grande }' />
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-ink">@Model.NombreCompleto</h1>
            <p class="mt-0.5 text-sm text-muted">Paciente #@Model.IdPaciente</p>
        </div>
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-3">
        <div class="tarjeta p-6">
            <h2 class="text-base font-semibold text-ink">Datos personales</h2>
            <dl class="mt-4 space-y-4">
                <div>
                    <dt class="text-sm text-muted">Fecha de nacimiento</dt>
                    <dd class="mt-0.5 text-ink">
                        @if (Model.FechaNacimientoLarga is not null)
                        {
                            <span>@Model.FechaNacimientoLarga</span>
                            @if (Model.Edad is not null)
                            {
                                <span class="text-muted"> · @Model.Edad años</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Sin datos</span>
                        }
                    </dd>
                </div>
                <div>
                    <dt class="text-sm text-muted">Sexo</dt>
                    <dd class="mt-0.5 capitalize text-ink">
                        @(string.IsNullOrWhiteSpace(Model.Sexo) ? "Sin datos" : Model.Sexo)
                    </dd>
                </div>
            </dl>
        </div>

        <div class="tarjeta p-6">
            <h2 class="text-base font-semibold text-ink">Datos clínicos</h2>
            <dl class="mt-4 space-y-4">
                <div>
                    <dt class="text-sm text-muted">Grupo sanguíneo</dt>
                    <dd class="mt-1">
                        @if (!string.IsNullOrWhiteSpace(Model.GrupoSanguineo))
                        {
                            <span class="inline-block rounded-badge bg-accent-soft px-2 py-1 text-sm font-semibold tabular-nums text-accent-ink">
                                @Model.GrupoSanguineo
                            </span>
                        }
                        else
                        {
                            <span class="text-sm text-muted">Sin datos</span>
                        }
                    </dd>
                </div>
                <div>
                    <dt class="text-sm text-muted">Alergias</dt>
                    <dd class="mt-0.5 whitespace-pre-line text-ink">
                        @if (!string.IsNullOrWhiteSpace(Model.Alergias))
                        {
                            <span class="font-medium text-status-pendiente">@Model.Alergias</span>
                        }
                        else
                        {
                            <span class="text-muted">Sin alergias registradas</span>
                        }
                    </dd>
                </div>
                <div>
                    <dt class="text-sm text-muted">Condiciones</dt>
                    <dd class="mt-0.5 whitespace-pre-line text-ink">
                        @if (!string.IsNullOrWhiteSpace(Model.Condiciones))
                        {
                            <span>@Model.Condiciones</span>
                        }
                        else
                        {
                            <span class="text-muted">Sin condiciones registradas</span>
                        }
                    </dd>
                </div>
                <div>
                    <dt class="text-sm text-muted">Último turno</dt>
                    <dd class="mt-0.5 text-ink">
                        @(Model.UltimoTurnoLargo ?? "Sin turnos registrados")
                    </dd>
                </div>
            </dl>
        </div>

        <div class="tarjeta p-6">
            <h2 class="text-base font-semibold text-ink">Cobertura</h2>
            @if (Model.Coberturas.Count == 0)
            {
                <p class="mt-4 text-sm text-muted">Sin coberturas registradas.</p>
            }
            else
            {
                <dl class="mt-4 space-y-4">
                    @foreach (var cobertura in Model.Coberturas)
                    {
                        <div>
                            <dt class="font-medium text-ink">@cobertura.NombreCobertura</dt>
                            <dd class="mt-0.5 text-sm text-muted">
                                @if (!string.IsNullOrWhiteSpace(cobertura.Plan))
                                {
                                    <span>Plan @cobertura.Plan · </span>
                                }
                                <span>Nº de afiliado @cobertura.IdAfiliado</span>
                            </dd>
                        </div>
                    }
                </dl>
            }
        </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
        <a asp-controller="Historial" asp-action="Index" asp-route-paciente="@Model.IdPaciente"
           class="boton boton-secundario">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1" />
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                <path d="M9 14h6" />
                <path d="M9 18h4" />
            </svg>
            Historia clínica
        </a>
        <a asp-controller="Recetas" asp-action="Index" asp-route-paciente="@Model.IdPaciente"
           class="boton boton-secundario">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z" />
                <path d="m8.5 8.5 7 7" />
            </svg>
            Recetas
        </a>
        @* Agendar turno sí crea datos (a diferencia de los dos anteriores, que
           solo navegan), por eso va con el estilo primario relleno. *@
        @if (Auth.PuedeCargarTurnos)
        {
            <a asp-controller="Turnos" asp-action="Crear" asp-route-paciente="@Model.IdPaciente"
               class="boton boton-primario">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M8 2v4" />
                    <path d="M16 2v4" />
                    <rect width="18" height="18" x="3" y="4" rx="2" />
                    <path d="M3 10h18" />
                    <path d="M12 14v4" />
                    <path d="M10 16h4" />
                </svg>
                Agendar turno
            </a>
        }
        @* Solo el administrador edita perfiles ajenos; Usuarios/Editar lo
           vuelve a verificar en el servidor. *@
        @if (Auth.EsAdministrador)
        {
            <a asp-controller="Usuarios" asp-action="Editar" asp-route-id="@Model.IdUsuario" asp-route-idPaciente="@Model.IdPaciente"
               class="boton boton-secundario">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
                    <path d="m15 5 4 4" />
                </svg>
                Editar perfil
            </a>
        }
    </div>
}
