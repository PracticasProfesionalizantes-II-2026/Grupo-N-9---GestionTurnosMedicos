@model PacienteDetalleViewModel
@inject AuthService Auth
@{
    ViewData["Title"] = Model.HuboError ? "Paciente" : Model.NombreCompleto;
}

<a asp-action="Index"
   class="boton-texto area-tactil text-muted hover:text-primary">
    <icono nombre="volver" class="h-4 w-4" />
    Volver a pacientes
</a>

@if (Model.HuboError)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudo cargar el paciente", Ayuda = Model.Error, Accion = new EnlaceViewModel { Controlador = "Pacientes", Accion = "Detalle", Ruta = new Dictionary<string, string> { ["id"] = $"{Model.IdPaciente}" }, Descripcion = "Reintentar" } }' />
    </div>
}
else
{
    // Para el enlace tel: solo dígitos y el +, sin espacios ni guiones.
    var telefonoMarcable = string.IsNullOrWhiteSpace(Model.Telefono)
        ? null
        : new string(Model.Telefono.Where(c => char.IsDigit(c) || c == '+').ToArray());

    @* Encabezado: foto, nombre y lo que se mira primero (edad y grupo
       sanguíneo) como chips, con las acciones al costado. *@
    <div class="mt-6 tarjeta tarjeta-hero flex flex-wrap items-center gap-4 p-5 sm:p-6">
        <partial name="_Avatar"
                 model='new AvatarViewModel { Nombre = $"{Model.Nombre} {Model.Apellido}", FotoUrl = Model.FotoUrl, Tamano = TamanoAvatar.Grande }' />
        <div class="min-w-0 flex-1 basis-56">
            <p class="text-xs font-medium tabular-nums text-muted">Paciente #@Model.IdPaciente</p>
            <h1 class="mt-0.5 text-2xl font-bold tracking-tight wrap-break-word text-ink">@Model.NombreCompleto</h1>
            <p class="mt-2 flex flex-wrap items-center gap-2">
                @if (Model.Edad is not null)
                {
                    <partial name="_Chip" model='new ChipViewModel { Texto = $"{Model.Edad} años" }' />
                }
                @if (!string.IsNullOrWhiteSpace(Model.GrupoSanguineo))
                {
                    <partial name="_Chip" model='new ChipViewModel { Texto = $"Grupo {Model.GrupoSanguineo}", Tono = TonoChip.Info }' />
                }
                @if (Model.Coberturas.Count > 0)
                {
                    <partial name="_Chip" model='new ChipViewModel { Texto = Model.Coberturas[0].NombreCobertura }' />
                }
            </p>
        </div>
        <div class="flex flex-wrap gap-3">
            @* Agendar turno sí crea datos (a diferencia de los enlaces de abajo,
               que solo navegan), por eso va con el estilo primario relleno. *@
            @if (Auth.PuedeCargarTurnos)
            {
                <a asp-controller="Turnos" asp-action="Crear" asp-route-paciente="@Model.IdPaciente"
                   class="boton boton-primario">
                    <icono nombre="calendario-mas" class="h-4 w-4" />
                    Agendar turno
                </a>
            }
            @* Solo el administrador edita perfiles ajenos; Usuarios/Editar lo
               vuelve a verificar en el servidor. *@
            @if (Auth.EsAdministrador)
            {
                <a asp-controller="Usuarios" asp-action="Editar" asp-route-id="@Model.IdUsuario" asp-route-idPaciente="@Model.IdPaciente"
                   class="boton boton-secundario">
                    <icono nombre="lapiz" class="h-4 w-4" />
                    Editar perfil
                </a>
            }
        </div>
    </div>

    @* Las alergias van arriba de todo y como aviso: es lo que no se puede
       pasar por alto antes de indicar algo. *@
    @if (!string.IsNullOrWhiteSpace(Model.Alergias))
    {
        <div class="aviso aviso-pendiente mt-4">
            <icono nombre="alerta" />
            <div class="min-w-0">
                <p class="font-semibold">Alergias</p>
                <p class="mt-0.5 whitespace-pre-line wrap-break-word">@Model.Alergias</p>
            </div>
        </div>
    }

    <div class="mt-6 grid items-start gap-4 lg:grid-cols-3">
        <div class="tarjeta p-5 sm:p-6">
            <h2 class="text-base font-semibold text-ink">Datos personales</h2>
            <dl class="lista-datos mt-4">
                <div>
                    <dt><icono nombre="calendario" /> Fecha de nacimiento</dt>
                    @if (Model.FechaNacimientoLarga is not null)
                    {
                        <dd>
                            @Model.FechaNacimientoLarga
                            @if (Model.Edad is not null)
                            {
                                <span class="font-normal tabular-nums text-muted"> · @Model.Edad años</span>
                            }
                        </dd>
                    }
                    else
                    {
                        <dd class="sin-dato">Sin datos</dd>
                    }
                </div>
                <div>
                    <dt><icono nombre="persona" /> Sexo</dt>
                    @if (string.IsNullOrWhiteSpace(Model.Sexo))
                    {
                        <dd class="sin-dato">Sin datos</dd>
                    }
                    else
                    {
                        <dd class="capitalize">@Model.Sexo</dd>
                    }
                </div>
                <div>
                    <dt><icono nombre="documento" /> Documento</dt>
                    @if (Model.Documento is null)
                    {
                        <dd class="sin-dato">Sin datos</dd>
                    }
                    else
                    {
                        <dd class="tabular-nums">@Model.Documento</dd>
                    }
                </div>
                <div>
                    <dt><icono nombre="globo" /> Nacionalidad</dt>
                    @if (string.IsNullOrWhiteSpace(Model.Nacionalidad))
                    {
                        <dd class="sin-dato">Sin datos</dd>
                    }
                    else
                    {
                        <dd>@Model.Nacionalidad</dd>
                    }
                </div>
                <div>
                    <dt><icono nombre="personas" /> Estado civil</dt>
                    @if (string.IsNullOrWhiteSpace(Model.EstadoCivil))
                    {
                        <dd class="sin-dato">Sin datos</dd>
                    }
                    else
                    {
                        <dd>@Model.EstadoCivil</dd>
                    }
                </div>
                <div>
                    <dt><icono nombre="telefono" /> Teléfono</dt>
                    @if (telefonoMarcable is null)
                    {
                        <dd class="sin-dato">Sin datos</dd>
                    }
                    else
                    {
                        @* En el celular, tocarlo llama. *@
                        <dd>
                            <a href="tel:@telefonoMarcable" class="rounded-badge tabular-nums text-primary underline-offset-2 hover:underline">@Model.Telefono</a>
                        </dd>
                    }
                </div>
                <div>
                    <dt><icono nombre="ubicacion" /> Dirección</dt>
                    @if (Model.DireccionCompleta is null)
                    {
                        <dd class="sin-dato">Sin datos</dd>
                    }
                    else
                    {
                        <dd>@Model.DireccionCompleta</dd>
                    }
                </div>
                <div>
                    <dt><icono nombre="telefono" /> Contacto de emergencia</dt>
                    @if (Model.ContactoEmergencia is null)
                    {
                        <dd class="sin-dato">Sin datos</dd>
                    }
                    else
                    {
                        <dd>@Model.ContactoEmergencia</dd>
                    }
                </div>
            </dl>
        </div>

        <div class="tarjeta p-5 sm:p-6">
            <h2 class="text-base font-semibold text-ink">Datos clínicos</h2>
            <dl class="lista-datos mt-4">
                <div>
                    <dt><icono nombre="gota" /> Grupo sanguíneo</dt>
                    @if (string.IsNullOrWhiteSpace(Model.GrupoSanguineo))
                    {
                        <dd class="sin-dato">Sin datos</dd>
                    }
                    else
                    {
                        <dd class="tabular-nums">@Model.GrupoSanguineo</dd>
                    }
                </div>
                <div>
                    <dt><icono nombre="alerta" /> Alergias</dt>
                    @if (string.IsNullOrWhiteSpace(Model.Alergias))
                    {
                        <dd class="sin-dato">Sin alergias registradas</dd>
                    }
                    else
                    {
                        <dd class="whitespace-pre-line">@Model.Alergias</dd>
                    }
                </div>
                <div>
                    <dt><icono nombre="nota" /> Condiciones</dt>
                    @if (string.IsNullOrWhiteSpace(Model.Condiciones))
                    {
                        <dd class="sin-dato">Sin condiciones registradas</dd>
                    }
                    else
                    {
                        <dd class="whitespace-pre-line">@Model.Condiciones</dd>
                    }
                </div>
                <div>
                    <dt><icono nombre="completado" /> Último turno atendido</dt>
                    @if (Model.UltimoTurnoLargo is null)
                    {
                        <dd class="sin-dato">Todavía no tiene turnos atendidos</dd>
                    }
                    else
                    {
                        <dd>@Model.UltimoTurnoLargo</dd>
                    }
                </div>
            </dl>
        </div>

        <div class="tarjeta p-5 sm:p-6">
            <h2 class="text-base font-semibold text-ink">Cobertura</h2>
            @if (Model.Coberturas.Count == 0)
            {
                <p class="mt-4 text-sm text-muted">Sin coberturas registradas.</p>
            }
            else
            {
                <dl class="lista-datos mt-4">
                    @foreach (var cobertura in Model.Coberturas)
                    {
                        <div>
                            <dt><icono nombre="escudo" /> @cobertura.NombreCobertura</dt>
                            <dd class="font-normal text-muted">
                                @if (!string.IsNullOrWhiteSpace(cobertura.Plan))
                                {
                                    <span>Plan @cobertura.Plan · </span>
                                }
                                <span>Nº de afiliado <span class="tabular-nums text-ink">@cobertura.IdAfiliado</span></span>
                            </dd>
                        </div>
                    }
                </dl>
            }
        </div>
    </div>

    @* A dónde seguir: tarjetas que son enlaces, con su ícono. *@
    <nav aria-label="Más sobre el paciente" class="mt-6">
        <ul class="grid gap-4 sm:grid-cols-3">
            @{
                var destinos = new (string Controlador, string Icono, string Titulo, string Texto)[]
                {
                    ("Historial", "historia", "Historia clínica", "Consultas registradas"),
                    ("Recetas", "pastilla", "Recetas", "Emitidas y vigentes"),
                    ("Estudios", "estudio", "Estudios", "Pedidos y resultados"),
                };
                var orden = 0;
            }
            @foreach (var (controlador, icono, titulo, texto) in destinos)
            {
                <li class="entrada" style="--i: @(orden++)">
                    <a asp-controller="@controlador" asp-action="Index" asp-route-paciente="@Model.IdPaciente"
                       class="tarjeta tarjeta-enlace flex items-center gap-3 p-4">
                        <span class="circulo-icono flex size-10 shrink-0 items-center justify-center rounded-full">
                            <icono nombre="@icono" class="size-5" />
                        </span>
                        <span class="min-w-0 flex-1">
                            <span class="block font-semibold text-ink">@titulo</span>
                            <span class="block text-sm text-muted">@texto</span>
                        </span>
                        <icono nombre="chevron-der" class="size-4 shrink-0 text-muted" />
                    </a>
                </li>
            }
        </ul>
    </nav>
}
