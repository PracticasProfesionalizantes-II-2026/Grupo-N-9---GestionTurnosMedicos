@model PacientesIndexViewModel
@{
    ViewData["Title"] = "Pacientes";
}

<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-ink">Pacientes</h1>
        <p class="mt-1 text-sm text-muted">Personas registradas en el sistema.</p>
    </div>
    @if (!Model.HuboError)
    {
        <p class="text-sm text-muted">
            <span class="font-semibold tabular-nums text-ink">@Model.Total</span>
            @(Model.Total == 1 ? "paciente" : "pacientes")
        </p>
    }
</div>

@* Buscador por GET: la API resuelve el nombre como "contiene", sobre el
   nombre o el apellido. *@
<form method="get" asp-action="Index"
      class="mt-6 flex flex-wrap items-end gap-4 rounded-card border border-border bg-surface p-5">
    <div class="w-full flex-1 sm:min-w-64">
        <label for="nombre" class="block text-sm font-medium text-ink">Buscar por nombre o apellido</label>
        <input id="nombre" name="nombre" type="search" value="@Model.Nombre" placeholder="Por ejemplo: Gomez"
               class="mt-1.5 w-full rounded-input border border-primary-line bg-white px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary-soft" />
    </div>

    <div class="flex items-center gap-2">
        <button type="submit"
                class="rounded-input bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-primary-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft">
            Buscar
        </button>
        @if (Model.HayFiltro)
        {
            <a asp-action="Index"
               class="rounded-input border border-border px-4 py-2 text-sm font-semibold text-muted hover:bg-canvas hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft">
                Limpiar
            </a>
        }
    </div>
</form>

@if (Model.HuboError)
{
    <div class="mt-8 rounded-card border border-border bg-surface p-10 text-center">
        <svg class="mx-auto h-8 w-8 text-status-cancelado" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
        </svg>
        <h2 class="mt-4 text-base font-semibold text-ink">No se pudieron cargar los pacientes</h2>
        <p class="mx-auto mt-1 max-w-sm text-sm text-muted">@Model.Error</p>
        <a asp-action="Index"
           class="mt-6 inline-block rounded-input border border-primary-line px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-soft">
            Reintentar
        </a>
    </div>
}
else if (Model.Pacientes.Count == 0)
{
    <div class="mt-6 rounded-card border border-border bg-surface p-10 text-center">
        <svg class="mx-auto h-8 w-8 text-primary-line" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
        </svg>
        @if (Model.SinResultados)
        {
            <h2 class="mt-4 text-base font-semibold text-ink">Ningún paciente coincide con la búsqueda</h2>
            <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
                Probá con otro nombre o apellido, o con una parte más corta.
            </p>
            <a asp-action="Index"
               class="mt-6 inline-block rounded-input border border-primary-line px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-soft">
                Limpiar búsqueda
            </a>
        }
        else
        {
            <h2 class="mt-4 text-base font-semibold text-ink">No hay pacientes cargados</h2>
            <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
                Cuando se registren pacientes van a aparecer en esta lista.
            </p>
        }
    </div>
}
else
{
    <div class="mt-6 overflow-hidden rounded-card border border-border bg-surface">
        <ul>
            @{ var fila = 0; }
            @foreach (var paciente in Model.Pacientes)
            {
                <li class="fila-animada relative flex items-center gap-4 border-b border-border px-5 py-4 last:border-0 hover:bg-canvas"
                    style="animation-delay: @(Math.Min(fila++, 12) * 40)ms">
                    <span aria-hidden="true"
                          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-soft text-xs font-semibold text-primary">
                        @paciente.Iniciales
                    </span>
                    <span class="min-w-0 flex-1">
                        <a asp-action="Detalle" asp-route-id="@paciente.IdPaciente"
                           class="block truncate rounded-badge font-medium text-ink after:absolute after:inset-0 hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                            @paciente.NombreCompleto
                            <span class="sr-only">— ver ficha del paciente</span>
                        </a>
                    </span>
                    <span class="shrink-0 text-sm tabular-nums text-muted">#@paciente.IdPaciente</span>
                </li>
            }
        </ul>
    </div>

    @if (Model.HayMas)
    {
        <p class="mt-3 text-xs text-muted">Mostrando @Model.Pacientes.Count de @Model.Total pacientes.</p>
    }
}
