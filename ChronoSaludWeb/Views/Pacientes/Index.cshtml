@model PacientesIndexViewModel
@inject AuthService Auth
@{
    ViewData["Title"] = "Pacientes";
}

<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-ink">Pacientes</h1>
        <p class="mt-1 text-sm text-muted">Personas registradas en el sistema.</p>
    </div>
    <div class="flex flex-wrap items-center justify-end gap-x-5 gap-y-3">
        @if (!Model.HuboError)
        {
            <p class="text-sm text-muted">
                <span class="font-semibold tabular-nums text-ink">@Model.Total</span>
                @(Model.Total == 1 ? "paciente" : "pacientes")
            </p>
        }
        @* El alta de pacientes vive en Pacientes/Crear, reservada al rol
           administrador (la API crea al paciente vía registro de usuario). *@
        @if (Auth.EsAdministrador)
        {
            <a asp-action="Crear"
               class="boton boton-primario">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="M12 5v14" />
                </svg>
                Agregar paciente
            </a>
        }
    </div>
</div>

@* Buscador por GET: la API resuelve el nombre como "contiene", sobre el
   nombre o el apellido. *@
<form method="get" asp-action="Index"
      class="mt-6 flex flex-wrap items-end gap-4 tarjeta p-5">
    <div class="w-full flex-1 sm:min-w-64">
        <label for="nombre" class="block text-sm font-medium text-ink">Buscar por nombre o apellido</label>
        <input id="nombre" name="nombre" type="search" value="@Model.Nombre" placeholder="Por ejemplo: Gomez"
               class="campo mt-1.5" />
    </div>

    <div class="flex items-center gap-2">
        <button type="submit"
                class="boton boton-primario">
            Buscar
        </button>
        @if (Model.HayFiltro)
        {
            <a asp-action="Index"
               class="boton boton-secundario">
                Limpiar
            </a>
        }
    </div>
</form>

@if (Model.HuboError)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudieron cargar los pacientes", Ayuda = Model.Error, Accion = new EnlaceViewModel { Controlador = "Pacientes", Accion = "Index", Descripcion = "Reintentar" } }' />
    </div>
}
else if (Model.Pacientes.Count == 0)
{
    <div class="tarjeta mt-6">
        @if (Model.SinResultados)
        {
            <partial name="_EstadoVacio"
                     model='new EstadoVacioViewModel { Icono = "personas", Nivel = 2, Titulo = "Ningún paciente coincide con la búsqueda", Ayuda = "Probá con otro nombre o apellido, o con una parte más corta.", Accion = new EnlaceViewModel { Controlador = "Pacientes", Accion = "Index", Descripcion = "Limpiar búsqueda" } }' />
        }
        else
        {
            @* El alta es solo del administrador, igual que el botón de arriba. *@
            <partial name="_EstadoVacio"
                     model='new EstadoVacioViewModel { Icono = "personas", Nivel = 2, Titulo = "No hay pacientes cargados", Ayuda = "Cuando se registren pacientes van a aparecer en esta lista.", Accion = Auth.EsAdministrador ? new EnlaceViewModel { Controlador = "Pacientes", Accion = "Crear", Descripcion = "Agregar paciente" } : null }' />
        }
    </div>
}
else
{
    <div class="mt-6 overflow-hidden tarjeta">
        <ul>
            @{ var fila = 0; }
            @foreach (var paciente in Model.Pacientes)
            {
                <li class="fila-animada relative flex items-center gap-4 border-b border-border px-5 py-4 last:border-0 hover:bg-primary-soft/50"
                    style="animation-delay: @(Math.Min(fila++, 12) * 40)ms">
                    <partial name="_Avatar"
                             model='new AvatarViewModel { Nombre = $"{paciente.Nombre} {paciente.Apellido}", FotoUrl = paciente.FotoUrl, Tamano = TamanoAvatar.Chico }' />
                    <span class="min-w-0 flex-1">
                        <a asp-action="Detalle" asp-route-id="@paciente.IdPaciente"
                           class="block truncate rounded-badge font-medium text-ink after:absolute after:inset-0 hover:text-primary">
                            @paciente.NombreCompleto
                            <span class="sr-only">— ver ficha del paciente</span>
                        </a>
                    </span>
                    <span class="shrink-0 text-right text-sm text-muted">
                        <span class="block text-xs font-medium">Nº paciente</span>
                        <span class="tabular-nums text-ink">@paciente.IdPaciente</span>
                    </span>
                </li>
            }
        </ul>
    </div>

    @if (Model.HayMas)
    {
        <p class="mt-3 text-xs text-muted">Mostrando @Model.Pacientes.Count de @Model.Total pacientes.</p>
    }
}
