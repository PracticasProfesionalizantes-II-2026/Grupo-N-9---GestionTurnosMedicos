@model MiPerfilViewModel
@{
    ViewData["Title"] = "Mi perfil";
    const string claseSeccion = "text-base font-semibold text-ink";

    // Un dato de la ficha, con su ícono, o "Sin datos" en gris si está vacío.
    async Task Dato(string titulo, string? valor, string? icono = null)
    {
        <div>
            <dt>
                @if (icono is not null)
                {
                    <icono nombre="@icono" />
                }
                @titulo
            </dt>
            @if (string.IsNullOrWhiteSpace(valor))
            {
                <dd class="sin-dato">Sin datos</dd>
            }
            else
            {
                <dd class="whitespace-pre-line">@valor</dd>
            }
        </div>
    }
}

@* Encabezado con la foto (o las iniciales), el nombre y el rol. *@
<div class="tarjeta tarjeta-hero flex flex-wrap items-center gap-4 p-5 sm:p-6">
    <partial name="_Avatar"
             model='new AvatarViewModel { Nombre = $"{Model.Nombre} {Model.Apellido}", Tamano = TamanoAvatar.Grande }' />
    <div class="min-w-0 flex-1">
        <h1 class="text-2xl font-bold tracking-tight text-ink">Mi perfil</h1>
        <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
            <span class="font-medium wrap-break-word text-ink">@Model.NombreCompleto</span>
            <partial name="_Chip" model="new ChipViewModel { Texto = Model.Rol, Capitalizar = true }" />
        </p>
    </div>
</div>

<div class="mt-6 grid gap-4 lg:grid-cols-3">
    <div class="tarjeta p-6 lg:col-span-2">
        <h2 class="@claseSeccion">Tu cuenta</h2>
        <dl class="lista-datos mt-4 sm:grid-cols-2">
            @{ await Dato("Nombre", Model.Nombre, "persona"); }
            @{ await Dato("Apellido", Model.Apellido, "persona"); }
            @{ await Dato("Email", Model.Email, "email"); }
            @{ await Dato("Teléfono", Model.Telefono, "telefono"); }
        </dl>
        <div class="mt-6">
            <a asp-action="Editar" class="boton boton-primario">Editar mis datos</a>
        </div>
    </div>

    <div class="tarjeta p-6">
        <h2 class="@claseSeccion">Contraseña</h2>
        <p class="mt-4 text-sm text-muted">
            Para cambiarla te vamos a pedir la que usás hoy.
        </p>
        <div class="mt-6">
            <a asp-action="Contrasena" class="boton boton-secundario">Cambiar contraseña</a>
        </div>
    </div>
</div>

@if (Model.FaltaFicha)
{
    <div class="mt-4 tarjeta p-6">
        <h2 class="@claseSeccion">Tu ficha</h2>
        <p class="mt-4 text-sm text-muted">
            Tu usuario todavía no tiene un perfil de paciente asociado. Pedile a la administración que lo cree.
        </p>
    </div>
}

@if (Model.Ficha is { } ficha)
{
    <div class="mt-4 tarjeta p-6">
        <h2 class="@claseSeccion">Tu ficha</h2>
        <dl class="lista-datos mt-4 sm:grid-cols-2 lg:grid-cols-3">
            <div>
                <dt><icono nombre="calendario" /> Fecha de nacimiento</dt>
                @if (ficha.FechaNacimientoLarga is not null)
                {
                    <dd>
                        <span>@ficha.FechaNacimientoLarga</span>
                        @if (ficha.Edad is not null)
                        {
                            <span class="font-normal tabular-nums text-muted"> · @ficha.Edad años</span>
                        }
                    </dd>
                }
                else
                {
                    <dd class="sin-dato">Sin datos</dd>
                }
            </div>
            <div>
                <dt><icono nombre="persona" /> Sexo</dt>
                @if (string.IsNullOrWhiteSpace(ficha.Sexo))
                {
                    <dd class="sin-dato">Sin datos</dd>
                }
                else
                {
                    <dd class="capitalize">@ficha.Sexo</dd>
                }
            </div>
            @{ await Dato("Documento", ficha.Documento, "documento"); }
            @{ await Dato("Nacionalidad", ficha.Nacionalidad, "globo"); }
            @{ await Dato("Estado civil", ficha.EstadoCivil, "personas"); }
            @{ await Dato("Grupo sanguíneo", ficha.GrupoSanguineo, "gota"); }
            @{ await Dato("Dirección", ficha.DireccionCompleta, "ubicacion"); }
            @{ await Dato("Contacto de emergencia", ficha.ContactoEmergencia, "telefono"); }
            @{ await Dato("Alergias", ficha.Alergias, "alerta"); }
            @{ await Dato("Condiciones preexistentes", ficha.Condiciones, "nota"); }
        </dl>
        <div class="mt-6">
            <a asp-action="Editar" class="boton boton-secundario">Editar mi ficha</a>
        </div>
    </div>
}

@if (Model.IdDoctor is { } idDoctor)
{
    <div class="mt-4 tarjeta p-6">
        <h2 class="@claseSeccion">Datos profesionales</h2>
        <dl class="lista-datos mt-4 sm:grid-cols-3">
            @{ await Dato("Especialidad", Model.Especialidad, "estetoscopio"); }
            <div>
                <dt><icono nombre="documento" /> Matrícula</dt>
                @if (string.IsNullOrWhiteSpace(Model.Matricula))
                {
                    <dd class="sin-dato">Sin datos</dd>
                }
                else
                {
                    <dd class="tabular-nums">@Model.Matricula</dd>
                }
            </div>
            @{ await Dato("Consultorio", Model.Consultorio, "ubicacion"); }
        </dl>
        <p class="mt-4 text-xs text-muted">Si hay que corregir alguno de estos datos, pedíselo a la administración.</p>
        <div class="mt-6 flex flex-wrap gap-3">
            <a asp-controller="Doctores" asp-action="Horario" asp-route-id="@idDoctor" class="boton boton-secundario">
                Mi horario de atención
            </a>
            <a asp-controller="Actividad" asp-action="Mia" class="boton boton-secundario">
                Mi actividad
            </a>
        </div>
    </div>
}
