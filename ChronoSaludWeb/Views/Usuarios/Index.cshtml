@model UsuariosIndexViewModel
@{
    ViewData["Title"] = "Usuarios";
    const string claseCampo = "campo mt-1.5";
    const string clasePaso = "boton boton-secundario";
    const string clasePasoInactivo = "boton cursor-default border border-border text-muted opacity-60";

    // Los filtros de la búsqueda actual, para que "Reintentar" la repita. Un
    // filtro vacío no viaja: así la URL queda igual que sin él.
    var filtros = new Dictionary<string, string>();
    if (!string.IsNullOrEmpty(Model.Buscar)) filtros["buscar"] = Model.Buscar;
    if (!string.IsNullOrEmpty(Model.Rol)) filtros["rol"] = Model.Rol;
}

<a asp-controller="Admin" asp-action="Index"
   class="boton-texto text-muted hover:text-primary">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    Volver a Cuentas
</a>

<div class="mt-6 flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-ink">Usuarios</h1>
        <p class="mt-1 text-sm text-muted">Pacientes, doctores y administradores con la cuenta activa.</p>
    </div>
    @if (!Model.HuboError)
    {
        <p class="text-sm text-muted">
            <span class="font-semibold tabular-nums text-ink">@Model.Total</span>
            @(Model.Total == 1 ? "usuario" : "usuarios")
        </p>
    }
</div>

@* Buscador por GET: la API resuelve el texto como "contiene" sobre nombre,
   apellido o email. Buscar siempre vuelve a la primera página. *@
<form method="get" asp-action="Index"
      class="mt-6 flex flex-wrap items-end gap-4 tarjeta p-5">
    <div class="w-full flex-1 sm:min-w-64">
        <label for="buscar" class="block text-sm font-medium text-ink">Buscar por nombre, apellido o email</label>
        <input id="buscar" name="buscar" type="search" value="@Model.Buscar" placeholder="Por ejemplo: Gomez o @@gmail"
               class="@claseCampo" />
    </div>

    <div class="w-full sm:w-48">
        <label for="rol" class="block text-sm font-medium text-ink">Rol</label>
        <select id="rol" name="rol" asp-items="Model.Roles" class="@claseCampo">
            <option value="">Todos</option>
        </select>
    </div>

    <div class="flex items-center gap-2">
        <button type="submit"
                class="boton boton-primario">
            Buscar
        </button>
        @if (Model.HayFiltro)
        {
            <a asp-action="Index"
               class="boton boton-secundario">
                Limpiar
            </a>
        }
    </div>
</form>

@if (Model.HuboError)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudieron cargar los usuarios", Ayuda = Model.Error, Accion = new EnlaceViewModel { Controlador = "Usuarios", Accion = "Index", Ruta = filtros, Descripcion = "Reintentar" } }' />
    </div>
}
else if (Model.Usuarios.Count == 0)
{
    <div class="tarjeta mt-6">
        @if (Model.SinResultados)
        {
            <partial name="_EstadoVacio"
                     model='new EstadoVacioViewModel { Icono = "personas", Nivel = 2, Titulo = "Ningún usuario coincide con la búsqueda", Ayuda = "Probá con otro nombre o email, con una parte más corta o con otro rol.", Accion = new EnlaceViewModel { Controlador = "Usuarios", Accion = "Index", Descripcion = "Limpiar búsqueda" } }' />
        }
        else
        {
            <partial name="_EstadoVacio"
                     model='new EstadoVacioViewModel { Icono = "personas", Nivel = 2, Titulo = "No hay usuarios activos", Ayuda = "Cuando se den de alta cuentas van a aparecer en esta lista." }' />
        }
    </div>
}
else
{
    <div class="mt-6 overflow-hidden tarjeta">
        <ul>
            @{ var fila = 0; }
            @foreach (var usuario in Model.Usuarios)
            {
                <li class="fila-animada relative flex items-center gap-4 border-b border-border px-5 py-4 last:border-0 hover:bg-primary-soft/50"
                    style="animation-delay: @(Math.Min(fila++, 12) * 40)ms">
                    <partial name="_Avatar"
                             model='new AvatarViewModel { Nombre = usuario.NombreCrudo, FotoUrl = usuario.TieneFoto ? Url.Action("Foto", new { id = usuario.IdUsuario }) : null, Tamano = TamanoAvatar.Chico }' />
                    <span class="min-w-0 flex-1">
                        <a asp-action="Editar" asp-route-id="@usuario.IdUsuario"
                           class="block truncate rounded-badge font-medium text-ink after:absolute after:inset-0 hover:text-primary">
                            @usuario.NombreCompleto
                            <span class="sr-only">— editar perfil</span>
                        </a>
                        <span class="block truncate text-sm text-muted">@usuario.Email</span>
                    </span>
                    <partial name="_Chip" model="new ChipViewModel { Texto = usuario.Rol, Capitalizar = true }" />
                </li>
            }
        </ul>
    </div>

    @* Paginación con enlaces: conservan el texto y el rol de la búsqueda. *@
    <nav aria-label="Páginas de resultados" class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-muted">
            Página <span class="font-semibold tabular-nums text-ink">@Model.Pagina</span>
            de <span class="font-semibold tabular-nums text-ink">@Model.TotalPaginas</span>
        </p>
        <div class="flex items-center gap-2">
            @if (Model.HayAnterior)
            {
                <a asp-action="Index" asp-route-buscar="@Model.Buscar" asp-route-rol="@Model.Rol" asp-route-pagina="@(Model.Pagina - 1)"
                   rel="prev" class="@clasePaso">Anterior</a>
            }
            else
            {
                <span aria-disabled="true" class="@clasePasoInactivo">Anterior</span>
            }
            @if (Model.HaySiguiente)
            {
                <a asp-action="Index" asp-route-buscar="@Model.Buscar" asp-route-rol="@Model.Rol" asp-route-pagina="@(Model.Pagina + 1)"
                   rel="next" class="@clasePaso">Siguiente</a>
            }
            else
            {
                <span aria-disabled="true" class="@clasePasoInactivo">Siguiente</span>
            }
        </div>
    </nav>
}
