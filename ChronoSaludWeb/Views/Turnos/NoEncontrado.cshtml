@model int
@{
    ViewData["Title"] = "Turno no encontrado";
}

<a asp-action="Index"
   class="inline-flex items-center gap-1.5 rounded-badge text-sm font-medium text-muted hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    Volver al listado
</a>

<div class="mt-6 rounded-card border border-border bg-surface p-10 text-center">
    <svg class="mx-auto h-8 w-8 text-primary-line" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M8 2v4" />
        <path d="M16 2v4" />
        <rect width="18" height="18" x="3" y="4" rx="2" />
        <path d="M3 10h18" />
        <path d="m14 14-4 4" />
        <path d="m10 14 4 4" />
    </svg>
    <h1 class="mt-4 text-base font-semibold text-ink">Turno no encontrado</h1>
    <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
        No existe ningún turno con el número <span class="font-medium tabular-nums text-ink">@Model</span>.
        Puede que lo hayan eliminado o que el enlace esté mal.
    </p>
    <a asp-action="Index"
       class="mt-6 inline-block rounded-input bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-primary-hover">
        Ir al listado de turnos
    </a>
</div>
