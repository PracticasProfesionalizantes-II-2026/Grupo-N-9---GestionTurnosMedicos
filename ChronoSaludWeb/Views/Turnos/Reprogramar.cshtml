@model TurnoReprogramarViewModel
@{
    ViewData["Title"] = $"Reprogramar turno #{Model.Turno.IdTurno}";
}

<a asp-action="Detalle" asp-route-id="@Model.Turno.IdTurno"
   class="boton-texto text-muted hover:text-primary">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    Volver al turno
</a>

<div class="mt-6 max-w-3xl">
    <h1 class="text-2xl font-bold tracking-tight text-ink">Reprogramar el turno #@Model.Turno.IdTurno</h1>
    <p class="mt-1 text-sm text-muted">
        Elegí otro día y horario con el mismo doctor. Antes de cambiarlo vas a ver el resumen.
    </p>

    <div class="mt-6 tarjeta p-6">
        <h2 class="text-base font-semibold text-ink">Ahora</h2>
        <dl class="mt-4 grid gap-4 sm:grid-cols-3">
            <div>
                <dt class="text-sm text-muted">Paciente</dt>
                <dd class="mt-0.5 font-medium text-ink">@Model.Turno.PacienteMostrado</dd>
            </div>
            <div>
                <dt class="text-sm text-muted">Doctor</dt>
                <dd class="mt-0.5 text-ink">@Model.Turno.DoctorMostrado</dd>
            </div>
            <div>
                <dt class="text-sm text-muted">Día y horario</dt>
                <dd class="mt-0.5 capitalize text-ink">@Model.Turno.FechaLarga</dd>
                <dd class="text-sm font-medium tabular-nums text-ink">@Model.Turno.Horario</dd>
            </div>
        </dl>
    </div>

    <div class="mt-4 tarjeta p-6">
        <h2 class="text-base font-semibold text-ink">Nuevo día y horario</h2>

        @if (Model.AvisoFranjas is not null)
        {
            <p role="alert" class="mt-4 flex items-start gap-3 rounded-input border border-status-cancelado-line bg-status-cancelado-soft px-4 py-3 text-sm text-status-cancelado">
                <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
                    <path d="M12 9v4" />
                    <path d="M12 17h.01" />
                </svg>
                <span>@Model.AvisoFranjas</span>
            </p>
        }

        @if (Model.Tira is not null)
        {
            <partial name="_TiraDeDias" model="Model.Tira" />

            @if (Model.Tira.SinLugarEnNingunDia)
            {
                <p class="mt-4 text-sm text-muted">No hay horarios libres en estas dos semanas. Mirá las siguientes.</p>
            }
        }

        @if (Model.Fecha is not null && Model.AvisoFranjas is null)
        {
            <h3 class="mt-6 text-sm font-medium text-ink">Horarios libres del @Model.FechaLarga</h3>

            @if (Model.Franjas.Count == 0)
            {
                <p class="mt-2 text-sm text-muted">No hay horarios libres ese día. Elegí otro día de la tira.</p>
            }
            else
            {
                @* Cada horario lleva a la confirmación: todavía no cambia nada. *@
                <ul class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
                    @foreach (var franja in Model.Franjas)
                    {
                        <li>
                            <a asp-action="ConfirmarReprogramacion" asp-all-route-data="Model.RutaConfirmar(franja)"
                               class="boton boton-secundario w-full min-w-0 text-sm font-semibold tabular-nums">
                                @franja.HoraInicio
                                <span aria-hidden="true">–</span><span class="sr-only">a</span>
                                @franja.HoraFin
                            </a>
                        </li>
                    }
                </ul>
            }
        }
    </div>
</div>
