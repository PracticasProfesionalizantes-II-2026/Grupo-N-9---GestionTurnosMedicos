@model ConfirmarReprogramacionViewModel
@{
    ViewData["Title"] = $"Reprogramar turno #{Model.Turno.IdTurno}";
}

<a asp-action="Reprogramar" asp-all-route-data="Model.RutaElegirOtro"
   class="boton-texto text-muted hover:text-primary">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    Elegir otro horario
</a>

<div class="mt-6 max-w-xl">
    <h1 class="text-2xl font-bold tracking-tight text-ink">¿Reprogramar el turno #@Model.Turno.IdTurno?</h1>
    <p class="mt-1 text-sm text-muted">
        El turno conserva su estado (@Model.Turno.Estado) y al paciente le llega un aviso con el día y la hora nuevos.
    </p>

    @if (Model.Error is not null)
    {
        <div class="mt-6 flex items-start gap-3 rounded-input border border-status-cancelado-line bg-status-cancelado-soft px-4 py-3 text-sm text-status-cancelado">
            <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
                <path d="M12 9v4" />
                <path d="M12 17h.01" />
            </svg>
            <span>
                <span class="block">@Model.Error</span>
                <a asp-action="Reprogramar" asp-all-route-data="Model.RutaElegirOtro"
                   class="mt-1 inline-block font-semibold underline">Elegir otro horario</a>
            </span>
        </div>
    }

    <div class="mt-6 tarjeta p-6">
        <p class="text-sm text-muted">
            <span class="font-medium text-ink">@Model.Turno.PacienteMostrado</span>
            con @Model.Turno.DoctorMostrado
        </p>

        @* De dónde a dónde se mueve. *@
        <dl class="mt-5 grid gap-4 border-t border-border pt-5 sm:grid-cols-2">
            <div>
                <dt class="text-sm text-muted">De</dt>
                <dd class="mt-0.5 capitalize text-ink line-through decoration-muted">@Model.FechaActualLarga</dd>
                <dd class="text-sm tabular-nums text-muted line-through">@Model.Turno.Horario</dd>
            </div>
            <div>
                <dt class="text-sm text-muted">A</dt>
                <dd class="mt-0.5 font-medium capitalize text-ink">@Model.FechaNuevaLarga</dd>
                <dd class="text-sm font-semibold tabular-nums text-ink">@Model.HorarioNuevo</dd>
            </div>
        </dl>

        <form asp-action="ConfirmarReprogramacion" asp-route-id="@Model.Turno.IdTurno" method="post"
              class="mt-7 flex flex-wrap items-center gap-3">
            <input type="hidden" name="fecha" value="@Model.FechaIso" />
            <input type="hidden" name="inicio" value="@Model.HoraInicio" />
            <input type="hidden" name="fin" value="@Model.HoraFin" />
            <button type="submit" class="boton boton-primario">
                Sí, reprogramar
            </button>
            <a asp-action="Detalle" asp-route-id="@Model.Turno.IdTurno" class="boton boton-secundario">
                No, volver al turno
            </a>
        </form>
    </div>
</div>
