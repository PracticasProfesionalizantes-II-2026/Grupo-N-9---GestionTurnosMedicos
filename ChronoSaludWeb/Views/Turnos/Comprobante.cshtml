@model TurnoComprobanteViewModel
@{
    ViewData["Title"] = $"Comprobante del turno #{Model.IdTurno}";
}

@* La hoja del comprobante, con letra grande. Sin JavaScript: se imprime con
   el menú del navegador. Lo que lleva print:hidden no sale en el papel, y el
   bloque @media print de app.css (el mismo de la receta, por la clase
   hoja-receta) deja la hoja en blanco y negro. *@

<a asp-action="Detalle" asp-route-id="@Model.IdTurno"
   class="boton-texto area-tactil text-muted hover:text-primary print:hidden">
    <icono nombre="volver" class="h-4 w-4" />
    Volver al turno
</a>

@if (Model.HuboError || Model.Turno is null)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudo cargar el comprobante", Ayuda = Model.Error }' />
    </div>
}
else
{
    var turno = Model.Turno;

    <div class="aviso aviso-info mx-auto mt-6 max-w-3xl print:hidden">
        <icono nombre="info" />
        <p>
            Para imprimirlo o guardarlo como PDF, usá <span class="font-medium text-ink">Imprimir</span>
            en el menú del navegador (Ctrl + P). Sale solo la hoja.
        </p>
    </div>

    <article class="hoja-receta tarjeta mx-auto mt-6 max-w-3xl overflow-hidden p-6 sm:p-10" aria-labelledby="titulo-comprobante">
        <header class="flex flex-wrap items-start justify-between gap-4 border-b border-border pb-5">
            <p class="flex items-center gap-2 text-lg font-bold tracking-tight text-primary">
                <partial name="_Logo" />
                <span translate="no">ChronoSalud</span>
            </p>
            <div class="sm:text-right">
                <h1 id="titulo-comprobante" class="text-xl font-bold text-ink">Comprobante de turno</h1>
                <p class="mt-1 text-sm tabular-nums text-muted">Turno N.º @turno.IdTurno</p>
            </div>
        </header>

        @* Lo más importante, bien grande: el día y la hora. El día va como se
           dice ("viernes 16 de octubre"), para que no haya que interpretar números. *@
        <section class="py-6 print:border-b print:border-border" aria-labelledby="titulo-cuando">
            <h2 id="titulo-cuando" class="text-sm font-semibold uppercase tracking-wide text-muted">Cuándo</h2>
            <div class="mt-3 flex flex-wrap items-center gap-5">
                <partial name="_FechaTile" model="new FechaTileViewModel { Fecha = turno.FechaInicio, Grande = true }" />
                <div class="min-w-0">
                    <p class="text-3xl font-bold text-ink first-letter:uppercase">@turno.DiaParaPaciente</p>
                    <p class="mt-1 text-2xl font-semibold tabular-nums text-ink">@turno.Horario hs</p>
                </div>
            </div>
            @* La fecha completa, con el año, por si el papel se lee otro día. *@
            <p class="mt-3 text-lg text-muted first-letter:uppercase">@turno.FechaLarga</p>
        </section>

        @* Línea de corte de talón, solo en pantalla: en el papel la separa
           un borde común. *@
        <div class="talon-corte -mx-6 sm:-mx-10 print:hidden" aria-hidden="true"></div>

        <section class="border-b border-border py-6" aria-labelledby="titulo-con-quien">
            <h2 id="titulo-con-quien" class="text-sm font-semibold uppercase tracking-wide text-muted">Con quién y dónde</h2>
            <p class="mt-2 text-2xl font-semibold text-ink">@turno.DoctorMostrado</p>
            @if (!string.IsNullOrWhiteSpace(turno.Especialidad))
            {
                <p class="text-xl capitalize text-ink">@turno.Especialidad</p>
            }
            @if (!string.IsNullOrWhiteSpace(turno.Consultorio))
            {
                <p class="mt-2 text-xl text-ink">@ConsultorioTexto.Para(turno.Consultorio)</p>
            }
            @if (Model.Direccion is not null)
            {
                <p class="mt-1 text-xl text-ink">@Model.Direccion</p>
            }
        </section>

        <section class="border-b border-border py-6" aria-labelledby="titulo-paciente">
            <h2 id="titulo-paciente" class="text-sm font-semibold uppercase tracking-wide text-muted">Paciente</h2>
            <p class="mt-2 text-xl font-medium text-ink">@turno.PacienteMostrado</p>
            <p class="mt-3 text-lg text-ink">
                <span class="text-muted">Estado:</span>
                @EstadoTurnoTexto.Para(turno.Estado, paciente: true)
            </p>
        </section>

        <section class="py-6" aria-labelledby="titulo-llevar">
            <h2 id="titulo-llevar" class="text-sm font-semibold uppercase tracking-wide text-muted">Qué llevar</h2>
            <ul class="mt-2 list-disc space-y-1 pl-6 text-xl text-ink">
                <li>Tu DNI.</li>
                <li>La credencial de tu cobertura médica, si tenés.</li>
            </ul>
        </section>

        <p class="mt-4 border-t border-border pt-3 text-xs text-muted">
            Generado en ChronoSalud el <span class="tabular-nums">@Model.GeneradoElTexto</span>.
        </p>
    </article>
}
