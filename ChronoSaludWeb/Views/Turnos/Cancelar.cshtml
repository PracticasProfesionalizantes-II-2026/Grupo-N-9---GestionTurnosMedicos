@model TurnoDetalleViewModel
@{
    ViewData["Title"] = $"Cancelar turno #{Model.IdTurno}";

    // El listado tal como estaba cuando se tocó "Cancelar". El controlador ya
    // lo validó como URL local; null si se llegó desde otro lado.
    var volver = ViewData["Volver"] as string;
}

<a href="@(volver ?? Url.Action("Index"))"
   class="boton-texto area-tactil text-muted hover:text-primary">
    <icono nombre="volver" class="h-4 w-4" />
    Volver
</a>

<div class="mt-6 max-w-xl">
    @* El círculo rojo marca que es una acción destructiva, además del texto. *@
    <span aria-hidden="true" class="flex size-12 items-center justify-center rounded-full circulo-icono bg-status-cancelado">
        <icono nombre="x-circulo" class="size-6" />
    </span>
    <h1 class="mt-4 text-2xl font-bold tracking-tight text-ink">¿Cancelar el turno #@Model.IdTurno?</h1>
    <p class="mt-1 text-sm text-muted">
        El turno queda en estado cancelado y el horario vuelve a quedar libre. No se borra: se puede
        seguir consultando desde el listado.
    </p>

    <div class="mt-6 tarjeta p-5 sm:p-6">
        <div class="flex items-center gap-3">
            <partial name="_Avatar"
                     model="new AvatarViewModel { Nombre = Model.PacienteNombre, FotoUrl = Model.PacienteFotoUrl, Tamano = TamanoAvatar.Mediano }" />
            <span>
                @* Los sr-only dicen quién es quién: sin ellos el lector leía dos
                   nombres seguidos sin aclarar cuál es el paciente y cuál el doctor. *@
                <span class="block font-medium text-ink"><span class="sr-only">Paciente: </span>@Model.PacienteMostrado</span>
                <span class="block text-sm text-muted">
                    <span class="sr-only">Doctor: </span>@Model.DoctorMostrado
                    @if (!string.IsNullOrWhiteSpace(Model.Especialidad))
                    {
                        <span aria-hidden="true"> · </span>
                        <span class="capitalize">@Model.Especialidad</span>
                    }
                </span>
            </span>
        </div>

        <dl class="lista-datos mt-5 border-t border-border pt-5 sm:grid-cols-3">
            <div>
                <dt><icono nombre="calendario" /> Fecha</dt>
                <dd class="first-letter:uppercase">@Model.FechaLarga</dd>
            </div>
            <div>
                <dt><icono nombre="reloj" /> Horario</dt>
                <dd class="tabular-nums">@Model.Horario</dd>
            </div>
            <div>
                <dt>Estado actual</dt>
                <dd>
                    <partial name="_BadgeEstado" model="Model.Estado" />
                </dd>
            </div>
        </dl>

        <form asp-action="Cancelar" asp-route-id="@Model.IdTurno" method="post" class="mt-7 flex flex-wrap items-center gap-3">
            @if (volver is not null)
            {
                <input type="hidden" name="volver" value="@volver" />
            }
            <button type="submit" data-cargando="Cancelando…"
                    class="boton boton-peligro">
                Sí, cancelar el turno
            </button>
            <a asp-action="Detalle" asp-route-id="@Model.IdTurno"
               class="boton boton-secundario">
                No, volver al turno
            </a>
        </form>
    </div>
</div>
