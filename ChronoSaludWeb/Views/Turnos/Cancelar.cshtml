@model TurnoDetalleViewModel
@{
    ViewData["Title"] = $"Cancelar turno #{Model.IdTurno}";

    // El listado tal como estaba cuando se tocó "Cancelar". El controlador ya
    // lo validó como URL local; null si se llegó desde otro lado.
    var volver = ViewData["Volver"] as string;
}

<a href="@(volver ?? Url.Action("Index"))"
   class="boton-texto text-muted hover:text-primary">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    Volver al listado
</a>

<div class="mt-6 max-w-xl">
    <h1 class="text-2xl font-bold tracking-tight text-ink">¿Cancelar el turno #@Model.IdTurno?</h1>
    <p class="mt-1 text-sm text-muted">
        El turno queda en estado cancelado. No se borra: se puede seguir consultando desde el listado.
    </p>

    <div class="mt-6 tarjeta p-6">
        <div class="flex items-center gap-3">
            <partial name="_Avatar"
                     model="new AvatarViewModel { Nombre = Model.PacienteNombre, FotoUrl = Model.PacienteFotoUrl, Tamano = TamanoAvatar.Mediano }" />
            <span>
                <span class="block font-medium text-ink">@Model.PacienteMostrado</span>
                <span class="block text-sm text-muted">
                    @Model.DoctorMostrado
                    @if (!string.IsNullOrWhiteSpace(Model.Especialidad))
                    {
                        <span aria-hidden="true"> · </span>
                        <span class="capitalize">@Model.Especialidad</span>
                    }
                </span>
            </span>
        </div>

        <dl class="mt-5 grid gap-4 border-t border-border pt-5 sm:grid-cols-3">
            <div>
                <dt class="text-sm text-muted">Fecha</dt>
                <dd class="mt-0.5 text-sm capitalize text-ink">@Model.FechaLarga</dd>
            </div>
            <div>
                <dt class="text-sm text-muted">Horario</dt>
                <dd class="mt-0.5 text-sm font-medium tabular-nums text-ink">@Model.Horario</dd>
            </div>
            <div>
                <dt class="text-sm text-muted">Estado actual</dt>
                <dd class="mt-1">
                    <partial name="_BadgeEstado" model="Model.Estado" />
                </dd>
            </div>
        </dl>

        <form asp-action="Cancelar" asp-route-id="@Model.IdTurno" method="post" class="mt-7 flex flex-wrap items-center gap-3">
            @if (volver is not null)
            {
                <input type="hidden" name="volver" value="@volver" />
            }
            <button type="submit"
                    class="boton boton-peligro">
                Sí, cancelar el turno
            </button>
            <a asp-action="Detalle" asp-route-id="@Model.IdTurno"
               class="boton boton-secundario">
                No, volver al turno
            </a>
        </form>
    </div>
</div>
