@model TurnoCrearViewModel
@{
    ViewData["Title"] = "Nuevo turno";

    // Una opción de los pasos 1 y 2: una tarjeta entera que es un enlace.
    const string claseOpcion = "tarjeta tarjeta-enlace flex min-h-11 items-center gap-3 px-4 py-3 text-sm font-semibold text-ink no-underline";

    // Una opción que no se puede elegir: plana, con borde punteado y sin
    // hover, como lo deshabilitado del resto del sitio.
    const string claseOpcionApagada = "flex min-h-11 items-center gap-3 rounded-card border-[1.5px] border-dashed border-contorno-suave px-4 py-3 text-sm font-semibold text-ink";
}

<a asp-action="Index"
   class="boton-texto area-tactil text-muted hover:text-primary">
    <icono nombre="volver" class="h-4 w-4" />
    Volver al listado
</a>

<div class="mt-6 max-w-3xl">
    <h1 class="text-2xl font-bold tracking-tight text-ink">Nuevo turno</h1>
    <p class="mt-1 text-sm text-muted">
        Elegí la especialidad, el doctor y el día, y tocá un horario libre. Antes de reservar vas a ver el resumen.
    </p>

    @* Un error al cargar las listas de los pasos 1 y 2 va arriba; el de los
       días y horarios, adentro del paso 3. *@
    @if (Model.AvisoFranjas is not null && Model.Paso < 3)
    {
        <p role="alert" class="aviso aviso-error mt-6">
            <icono nombre="alerta" class="mt-0.5 h-4 w-4 shrink-0" />
            <span>@Model.AvisoFranjas</span>
        </p>
    }

    @* Los tres pasos. Cada elección es un enlace que vuelve a esta pantalla
       con lo elegido en la URL; lo ya elegido queda resumido con «Cambiar».
       El número de cada paso se vuelve un tilde cuando está hecho (_Pasos). *@
    <ol class="mt-6 space-y-4">
        <li class="tarjeta p-5 sm:p-6" aria-current="@(Model.Paso == 1 ? "step" : null)">
            <partial name="_Pasos" model='new PasoViewModel { Numero = 1, Titulo = "Especialidad", Estado = PasoViewModel.Para(1, Model.Paso) }' />

            @if (Model.Paso == 1)
            {
                @if (Model.Especialidades.Count == 0 && Model.AvisoFranjas is null)
                {
                    <p class="mt-3 text-sm text-muted">Todavía no hay especialidades con doctores activos.</p>
                }
                else
                {
                    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
                        @{ var orden = 0; }
                        @foreach (var especialidad in Model.Especialidades)
                        {
                            <li class="entrada" style="--i: @(orden++)">
                                <a asp-action="Crear" asp-all-route-data="Model.Ruta(especialidad)" class="@claseOpcion">
                                    <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary-deep">
                                        <icono nombre="estetoscopio" class="size-4" />
                                    </span>
                                    <span class="min-w-0 flex-1 capitalize">@especialidad</span>
                                    <icono nombre="chevron-der" class="h-4 w-4 shrink-0 text-muted" />
                                </a>
                            </li>
                        }
                    </ul>
                }
            }
            else
            {
                <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 pl-11 text-sm">
                    <span class="font-medium capitalize text-ink">@Model.Especialidad</span>
                    <a asp-action="Crear" asp-all-route-data="Model.Ruta(null)" class="boton-texto area-tactil">
                        Cambiar<span class="sr-only"> la especialidad</span>
                    </a>
                </p>
            }
        </li>

        @if (Model.Paso >= 2)
        {
            <li class="tarjeta p-5 sm:p-6" aria-current="@(Model.Paso == 2 ? "step" : null)">
                <partial name="_Pasos" model='new PasoViewModel { Numero = 2, Titulo = "Doctor", Estado = PasoViewModel.Para(2, Model.Paso) }' />

                @if (Model.Doctores.Count == 0)
                {
                    <p class="mt-3 text-sm text-muted">No hay doctores activos en esa especialidad. Probá con otra.</p>
                }
                else if (Model.Paso == 2)
                {
                    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
                        <li class="entrada">
                            <a asp-action="Crear" asp-all-route-data="Model.Ruta(Model.Especialidad, TurnoCrearViewModel.Cualquiera)" class="@claseOpcion">
                                <span class="flex size-9 shrink-0 items-center justify-center rounded-full circulo-icono">
                                    <icono nombre="personas" class="size-4" />
                                </span>
                                <span class="min-w-0 flex-1">
                                    Cualquiera
                                    <span class="block text-xs font-normal text-muted">Los horarios de todos los doctores de la especialidad</span>
                                </span>
                                <icono nombre="chevron-der" class="h-4 w-4 shrink-0 text-muted" />
                            </a>
                        </li>
                        @{ var ordenDoctor = 1; }
                        @foreach (var doctor in Model.Doctores)
                        {
                            <li class="entrada" style="--i: @(ordenDoctor++)">
                                @if (doctor.TieneHorario == false)
                                {
                                    @* Sin horario cargado no tiene días para ofrecer: plano,
                                       sin hover y con el motivo escrito. *@
                                    <span aria-disabled="true" class="@claseOpcionApagada">
                                        <span class="opacity-60">
                                            <partial name="_Avatar" model="new AvatarViewModel { Nombre = doctor.Nombre, Tamano = TamanoAvatar.Chico, Tono = TonoAvatar.Terracota }" />
                                        </span>
                                        <span class="min-w-0 flex-1">
                                            <span class="opacity-60">@doctor.Nombre.Trim()</span>
                                            <span class="block text-xs font-normal text-muted">Todavía no tiene horario de atención</span>
                                        </span>
                                    </span>
                                }
                                else
                                {
                                    <a asp-action="Crear" asp-all-route-data="Model.Ruta(Model.Especialidad, doctor.IdDoctor)" class="@claseOpcion">
                                        <partial name="_Avatar" model="new AvatarViewModel { Nombre = doctor.Nombre, Tamano = TamanoAvatar.Chico, Tono = TonoAvatar.Terracota }" />
                                        <span class="min-w-0 flex-1">@doctor.Nombre.Trim()</span>
                                        <icono nombre="chevron-der" class="h-4 w-4 shrink-0 text-muted" />
                                    </a>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 pl-11 text-sm">
                        <span class="font-medium text-ink">@(Model.CualquierDoctor ? "Cualquiera de la especialidad" : Model.DoctorNombre)</span>
                        <a asp-action="Crear" asp-all-route-data="Model.Ruta(Model.Especialidad)" class="boton-texto area-tactil">
                            Cambiar<span class="sr-only"> el doctor</span>
                        </a>
                    </p>
                }
            </li>
        }

        @if (Model.Paso == 3 && Model.Doctores.Count > 0)
        {
            <li class="tarjeta p-5 sm:p-6" aria-current="step">
                <partial name="_Pasos" model='new PasoViewModel { Numero = 3, Titulo = "Día y horario", Estado = EstadoPaso.Actual }' />

                @if (Model.HorarioDoctor is { TieneHorario: true })
                {
                    <section class="mt-4 rounded-input border border-contorno-suave bg-surface px-4 py-3" aria-labelledby="titulo-horario">
                        <h3 id="titulo-horario" class="mb-1 text-sm font-semibold text-ink">Horario de atención</h3>
                        <partial name="_HorarioSemanal" model="Model.HorarioDoctor" />
                    </section>
                }

                @if (Model.HorarioDoctor is { TieneHorario: false })
                {
                    <p class="mt-3 text-sm text-muted">
                        Este doctor todavía no tiene horario de atención cargado. Elegí otro doctor o «Cualquiera».
                    </p>
                }
                else
                {
                    @if (Model.AvisoFranjas is not null)
                    {
                        <p role="alert" class="aviso aviso-error mt-4">
                            <icono nombre="alerta" class="mt-0.5 h-4 w-4 shrink-0" />
                            <span>@Model.AvisoFranjas</span>
                        </p>
                    }

                    @if (Model.Tira is not null)
                    {
                        <partial name="_TiraDeDias" model="Model.Tira" />

                        @if (Model.Tira.SinLugarEnNingunDia)
                        {
                            <p class="mt-4 text-sm text-muted">
                                No hay horarios libres en estas dos semanas. Mirá las siguientes.
                            </p>
                        }
                    }

                    @if (Model.Fecha is not null && Model.AvisoFranjas is null)
                    {
                        <h3 class="mt-6 text-sm font-medium text-ink">Horarios libres del @Model.FechaLarga</h3>

                        @if (Model.Franjas.Count == 0)
                        {
                            <p class="mt-2 text-sm text-muted">No hay horarios libres ese día. Elegí otro día de la tira.</p>
                        }
                        else
                        {
                            <p class="mt-1 text-sm text-muted">Tocá uno para ver el resumen antes de reservar.</p>

                            @* Cada horario es un enlace a la confirmación: todavía no reserva nada. *@
                            <ul class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
                                @{ var ordenFranja = 0; }
                                @foreach (var franja in Model.Franjas)
                                {
                                    <li class="entrada" style="--i: @(ordenFranja++)">
                                        <a asp-action="Confirmar" asp-all-route-data="Model.RutaConfirmar(franja)"
                                           class="boton boton-secundario w-full min-w-0 flex-col items-start gap-0 px-3 text-left">
                                            <span class="text-sm font-semibold tabular-nums text-ink">
                                                @franja.HoraInicio
                                                <span aria-hidden="true">–</span><span class="sr-only">a</span>
                                                @franja.HoraFin
                                            </span>
                                            @if (franja.DoctorNombre is not null)
                                            {
                                                <span class="mt-0.5 block w-full truncate text-xs text-muted">
                                                    <span class="sr-only">con</span>
                                                    @franja.DoctorNombre
                                                </span>
                                            }
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    }
                }
            </li>
        }
    </ol>

    <div class="mt-7">
        <a asp-action="Index"
           class="boton boton-secundario">
            Salir sin agendar
        </a>
    </div>
</div>
