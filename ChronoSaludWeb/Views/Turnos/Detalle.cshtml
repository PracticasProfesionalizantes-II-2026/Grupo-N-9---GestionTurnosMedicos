@model TurnoDetalleViewModel
@{
    ViewData["Title"] = $"Turno #{Model.IdTurno}";
}

<a asp-action="Index"
   class="inline-flex items-center gap-1.5 rounded-badge text-sm font-medium text-muted hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    Volver al listado
</a>

@if (Model.HuboError)
{
    <div class="mt-8 rounded-card border border-border bg-surface p-10 text-center">
        <svg class="mx-auto h-8 w-8 text-status-cancelado" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
        </svg>
        <h2 class="mt-4 text-base font-semibold text-ink">No se pudo cargar el turno</h2>
        <p class="mx-auto mt-1 max-w-sm text-sm text-muted">@Model.Error</p>
        <a asp-action="Detalle" asp-route-id="@Model.IdTurno"
           class="mt-6 inline-block rounded-input border border-primary-line px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-soft">
            Reintentar
        </a>
    </div>
}
else
{
    <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-ink">Turno #@Model.IdTurno</h1>
            <p class="mt-1 text-sm capitalize text-muted">@Model.FechaLarga</p>
        </div>
        <partial name="_BadgeEstado" model="Model.Estado" />
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-2">
        <div class="rounded-card border border-border bg-surface p-6">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Cuándo</h2>
            <dl class="mt-4 space-y-4">
                <div>
                    <dt class="text-sm text-muted">Fecha</dt>
                    <dd class="mt-0.5 capitalize text-ink">@Model.FechaLarga</dd>
                </div>
                <div>
                    <dt class="text-sm text-muted">Horario</dt>
                    <dd class="mt-0.5 font-medium tabular-nums text-ink">@Model.Horario</dd>
                </div>
                <div>
                    <dt class="text-sm text-muted">Estado</dt>
                    <dd class="mt-1">
                        <partial name="_BadgeEstado" model="Model.Estado" />
                    </dd>
                </div>
            </dl>
        </div>

        <div class="rounded-card border border-border bg-surface p-6">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Quiénes</h2>

            <div class="mt-4 flex items-center gap-3">
                <span aria-hidden="true"
                      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-soft text-sm font-semibold text-primary">
                    @Model.Iniciales
                </span>
                <span>
                    <span class="block font-medium text-ink">@Model.PacienteMostrado</span>
                    <span class="block text-sm text-muted">Paciente</span>
                </span>
            </div>

            <div class="mt-5 border-t border-border pt-5">
                <div class="flex items-start gap-3">
                    <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3" />
                        <path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4" />
                        <circle cx="20" cy="10" r="2" />
                    </svg>
                    <span>
                        <span class="block font-medium text-ink">@Model.DoctorMostrado</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Especialidad))
                        {
                            <span class="block text-sm capitalize text-muted">@Model.Especialidad</span>
                        }
                        <span class="mt-1 block text-sm text-muted">
                            @if (!string.IsNullOrWhiteSpace(Model.Matricula))
                            {
                                <span>Matrícula @Model.Matricula</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Consultorio))
                            {
                                <span aria-hidden="true"> · </span>
                                <span>Consultorio @Model.Consultorio</span>
                            }
                        </span>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 rounded-card border border-border bg-surface p-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Observaciones</h2>
        @if (Model.TieneObservaciones)
        {
            <p class="mt-3 whitespace-pre-line text-ink">@Model.Observaciones</p>
        }
        else
        {
            <p class="mt-3 text-sm text-muted">Este turno no tiene observaciones cargadas.</p>
        }
    </div>
}
