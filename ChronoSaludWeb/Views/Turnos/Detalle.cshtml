@model TurnoDetalleViewModel
@inject AuthService Auth
@{
    ViewData["Title"] = $"Turno #{Model.IdTurno}";
}

<a asp-action="Index"
   class="boton-texto area-tactil text-muted hover:text-primary">
    <icono nombre="volver" class="h-4 w-4" />
    Volver al listado
</a>

@if (Model.HuboError)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudo cargar el turno", Ayuda = Model.Error, Accion = new EnlaceViewModel { Controlador = "Turnos", Accion = "Detalle", Ruta = new Dictionary<string, string> { ["id"] = Model.IdTurno.ToString() }, Descripcion = "Reintentar" } }' />
    </div>
}
else
{
    var esPaciente = Auth.SesionActual?.Rol == "paciente";

    @* Encabezado: el bloque de calendario, con quién o de quién es el turno y
       cuándo, en vez de abrir con el número. La franja de la izquierda lleva
       el color del estado, que también dice el chip. *@
    <div class="mt-6 tarjeta @FranjaEstado.Clase(Model.Estado) flex flex-wrap items-center gap-4 p-5 sm:gap-5 sm:p-6">
        <partial name="_FechaTile" model="new FechaTileViewModel { Fecha = Model.FechaInicio, Grande = true }" />
        <div class="min-w-0 flex-1 basis-48">
            <p class="text-xs font-medium tabular-nums text-muted">Turno #@Model.IdTurno</p>
            <h1 class="mt-0.5 text-2xl font-bold tracking-tight wrap-break-word text-ink">
                @(esPaciente ? $"Turno con {Model.DoctorMostrado}" : $"Turno de {Model.PacienteMostrado}")
            </h1>
            @* El paciente lo lee como se dice: "mañana, 10:00 hs". *@
            @if (esPaciente)
            {
                <p class="mt-1 text-sm text-muted first-letter:uppercase">@Model.FechaParaPaciente</p>
            }
            else
            {
                <p class="mt-1 text-sm text-muted">
                    <span class="inline-block first-letter:uppercase">@Model.FechaLarga</span>
                    <span aria-hidden="true"> · </span>
                    <span class="tabular-nums">@Model.Horario</span>
                </p>
            }
        </div>
        <partial name="_BadgeEstado" model="Model.Estado" />
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-2">
        <div class="tarjeta p-5 sm:p-6">
            <h2 class="text-base font-semibold text-ink">Cuándo y dónde</h2>
            <dl class="lista-datos mt-4">
                <div>
                    <dt><icono nombre="calendario" /> Fecha</dt>
                    <dd class="first-letter:uppercase">@Model.FechaLarga</dd>
                </div>
                <div>
                    <dt><icono nombre="reloj" /> Horario</dt>
                    <dd class="tabular-nums">@Model.Horario</dd>
                </div>
                <div>
                    <dt><icono nombre="ubicacion" /> Consultorio</dt>
                    @if (string.IsNullOrWhiteSpace(Model.Consultorio))
                    {
                        <dd class="sin-dato">Sin asignar</dd>
                    }
                    else
                    {
                        <dd>@ConsultorioTexto.Para(Model.Consultorio)</dd>
                    }
                </div>
            </dl>
        </div>

        <div class="tarjeta p-5 sm:p-6">
            <h2 class="text-base font-semibold text-ink">Quiénes</h2>

            <div class="mt-4 flex items-center gap-3">
                <partial name="_Avatar"
                         model="new AvatarViewModel { Nombre = Model.PacienteNombre, FotoUrl = Model.PacienteFotoUrl, Tamano = TamanoAvatar.Mediano }" />
                <span>
                    @* El personal va de un clic a la ficha y a la historia clínica. *@
                    @if (Auth.PuedeVerPacientes)
                    {
                        <a asp-controller="Pacientes" asp-action="Detalle" asp-route-id="@Model.IdPaciente"
                           class="block rounded-badge font-medium text-primary hover:text-primary-hover hover:underline">
                            @Model.PacienteMostrado
                            <span class="sr-only">— ver la ficha del paciente</span>
                        </a>
                    }
                    else
                    {
                        <span class="block font-medium text-ink">@Model.PacienteMostrado</span>
                    }
                    <span class="block text-sm text-muted">Paciente</span>
                </span>
            </div>
            @if (Auth.PuedeVerPacientes)
            {
                <a asp-controller="Historial" asp-action="Index" asp-route-paciente="@Model.IdPaciente"
                   class="boton-texto area-tactil mt-3">
                    <icono nombre="historia" class="h-4 w-4" />
                    Ver historia clínica
                </a>
            }

            <div class="mt-5 border-t border-border pt-5">
                <div class="flex items-start gap-3">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent-ink">
                        <icono nombre="estetoscopio" class="size-5" />
                    </span>
                    <span>
                        <span class="block font-medium text-ink">@Model.DoctorMostrado</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Especialidad))
                        {
                            <span class="block text-sm capitalize text-muted">@Model.Especialidad</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Matricula))
                        {
                            <span class="mt-1 block text-sm tabular-nums text-muted">Matrícula @Model.Matricula</span>
                        }
                    </span>
                </div>
            </div>
        </div>
    </div>

    @* Para no olvidarse del turno: agendarlo en el calendario del celular (con
       avisos el día anterior y una hora antes) o tenerlo en papel. Solo
       mientras el turno sigue en pie. Después de reservar se llega acá, así
       que también es lo primero que ve el paciente con el turno recién sacado. *@
    @if (Model.EstaEnPie)
    {
        <div class="mt-4 tarjeta p-5 sm:p-6">
            <h2 class="text-base font-semibold text-ink">Para no olvidarte</h2>
            <p class="mt-1 text-sm text-muted">
                Agregalo a tu calendario y te avisa el día anterior y una hora antes. O imprimí el comprobante.
            </p>
            <div class="mt-4 flex flex-wrap items-center gap-3">
                <a asp-action="Calendario" asp-route-id="@Model.IdTurno"
                   class="boton boton-primario">
                    <icono nombre="calendario-mas" class="h-4 w-4" />
                    Agregar a mi calendario
                </a>
                <a asp-action="Comprobante" asp-route-id="@Model.IdTurno"
                   class="boton boton-secundario">
                    <icono nombre="imprimir" class="h-4 w-4" />
                    Ver comprobante para imprimir
                </a>
            </div>
        </div>
    }

    <div class="mt-4 tarjeta p-5 sm:p-6">
        <h2 class="text-base font-semibold text-ink">Observaciones</h2>
        @if (Model.TieneObservaciones)
        {
            <p class="mt-3 whitespace-pre-line wrap-break-word text-ink">@Model.Observaciones</p>
        }
        else
        {
            <p class="mt-3 text-sm text-muted">Este turno no tiene observaciones cargadas.</p>
        }
    </div>

    @* Atención: el doctor del turno registra la consulta, emite una receta o pide un estudio,
       ya vinculadas a este turno. Solo doctores (la Web y la API los
       reservan a ese rol), y el detalle de un doctor ya muestra solo turnos
       de su agenda. Un turno cancelado o ausente no tuvo atención. *@
    @if (Auth.PuedeEscribirHistorial && Auth.PuedeEmitirRecetas && Model.SePuedeAtender)
    {
        <div class="mt-4 tarjeta p-5 sm:p-6">
            <h2 class="text-base font-semibold text-ink">Atención</h2>
            <p class="mt-1 text-sm text-muted">Lo que registres desde acá queda vinculado a este turno.</p>
            <div class="mt-4 flex flex-wrap items-center gap-3">
                <a asp-controller="Historial" asp-action="Crear" asp-route-turno="@Model.IdTurno"
                   class="boton boton-primario">
                    <icono nombre="archivo-mas" class="h-4 w-4" />
                    Registrar consulta
                </a>
                <a asp-controller="Recetas" asp-action="Crear" asp-route-turno="@Model.IdTurno"
                   class="boton boton-secundario">
                    <icono nombre="pastilla" class="h-4 w-4" />
                    Emitir receta
                </a>
                @if (Auth.PuedePedirEstudios)
                {
                    <a asp-controller="Estudios" asp-action="Crear" asp-route-turno="@Model.IdTurno"
                       class="boton boton-secundario">
                        <icono nombre="estudio" class="h-4 w-4" />
                        Pedir estudio
                    </a>
                }
            </div>
        </div>
    }

    @* Acciones sobre el turno. Confirmar, completar, marcar ausente y
       reprogramar son del personal (cada doctor en su agenda y la
       administración en cualquiera);
       cancelar, también del paciente, mientras el turno no haya empezado.
       Completado, ausente y cancelado son finales: no muestran ninguna. *@
    var puedeCambiarEstado = Auth.PuedeCambiarEstadoTurno && !Model.EsTerminal;
    var puedeCancelar = Auth.PuedeCancelarTurnos && Model.PuedeCancelarse
                        && (Auth.PuedeCambiarEstadoTurno || !Model.YaEmpezo);

    @if (puedeCambiarEstado || puedeCancelar)
    {
        <div class="mt-4 tarjeta p-5 sm:p-6">
            <h2 class="text-base font-semibold text-ink">Acciones</h2>
            <div class="mt-4 flex flex-wrap items-center gap-3">
                @if (puedeCambiarEstado && Model.PuedeConfirmarse)
                {
                    <form asp-action="CambiarEstado" asp-route-id="@Model.IdTurno" method="post">
                        <input type="hidden" name="estado" value="confirmado" />
                        <button type="submit" data-cargando="Confirmando…"
                                class="boton boton-primario">
                            <icono nombre="check" class="h-4 w-4" />
                            Confirmar turno
                        </button>
                    </form>
                }
                @if (puedeCambiarEstado && Model.PuedeCompletarse)
                {
                    @* Completado y ausente no se deshacen: pasan por una confirmación. *@
                    <a asp-action="Marcar" asp-route-id="@Model.IdTurno" asp-route-estado="completado"
                       class="boton boton-secundario">
                        <icono nombre="completado" class="h-4 w-4" />
                        Marcar como completado
                    </a>
                }
                @if (puedeCambiarEstado && Model.PuedeMarcarAusente)
                {
                    <a asp-action="Marcar" asp-route-id="@Model.IdTurno" asp-route-estado="ausente"
                       class="boton boton-secundario">
                        <icono nombre="usuario-x" class="h-4 w-4" />
                        Marcar ausente
                    </a>
                }
                @if (puedeCambiarEstado)
                {
                    @* Otro día u hora con el mismo doctor. Lleva a elegir y después a confirmar. *@
                    <a asp-action="Reprogramar" asp-route-id="@Model.IdTurno"
                       class="boton boton-secundario">
                        <icono nombre="calendario-flecha" class="h-4 w-4" />
                        Reprogramar
                    </a>
                }
                @if (puedeCancelar)
                {
                    @* Lleva a la pantalla de confirmación: cancelar no se hace con un solo clic. *@
                    <a asp-action="Cancelar" asp-route-id="@Model.IdTurno"
                       class="boton boton-peligro-suave">
                        <icono nombre="x-circulo" class="h-4 w-4" />
                        Cancelar turno
                    </a>
                }
            </div>
            @if (puedeCambiarEstado && !Model.YaEmpezo)
            {
                <p class="mt-3 text-xs text-muted">
                    Cuando llegue la hora del turno vas a poder marcarlo como completado o ausente.
                </p>
            }
        </div>
    }
}
