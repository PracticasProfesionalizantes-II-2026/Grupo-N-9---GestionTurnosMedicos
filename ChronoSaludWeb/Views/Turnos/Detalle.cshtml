@model TurnoDetalleViewModel
@inject AuthService Auth
@{
    ViewData["Title"] = $"Turno #{Model.IdTurno}";
}

<a asp-action="Index"
   class="boton-texto text-muted hover:text-primary">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    Volver al listado
</a>

@if (Model.HuboError)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudo cargar el turno", Ayuda = Model.Error, Accion = new EnlaceViewModel { Controlador = "Turnos", Accion = "Detalle", Ruta = new Dictionary<string, string> { ["id"] = Model.IdTurno.ToString() }, Descripcion = "Reintentar" } }' />
    </div>
}
else
{
    <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-ink">Turno #@Model.IdTurno</h1>
            <p class="mt-1 text-sm capitalize text-muted">@Model.FechaLarga</p>
        </div>
        <partial name="_BadgeEstado" model="Model.Estado" />
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-2">
        <div class="tarjeta p-6">
            <h2 class="text-base font-semibold text-ink">Cuándo</h2>
            <dl class="mt-4 space-y-4">
                <div>
                    <dt class="text-sm text-muted">Fecha</dt>
                    <dd class="mt-0.5 capitalize text-ink">@Model.FechaLarga</dd>
                </div>
                <div>
                    <dt class="text-sm text-muted">Horario</dt>
                    <dd class="mt-0.5 font-medium tabular-nums text-ink">@Model.Horario</dd>
                </div>
                <div>
                    <dt class="text-sm text-muted">Estado</dt>
                    <dd class="mt-1">
                        <partial name="_BadgeEstado" model="Model.Estado" />
                    </dd>
                </div>
            </dl>
        </div>

        <div class="tarjeta p-6">
            <h2 class="text-base font-semibold text-ink">Quiénes</h2>

            <div class="mt-4 flex items-center gap-3">
                <partial name="_Avatar"
                         model="new AvatarViewModel { Nombre = Model.PacienteNombre, FotoUrl = Model.PacienteFotoUrl, Tamano = TamanoAvatar.Mediano }" />
                <span>
                    <span class="block font-medium text-ink">@Model.PacienteMostrado</span>
                    <span class="block text-sm text-muted">Paciente</span>
                </span>
            </div>

            <div class="mt-5 border-t border-border pt-5">
                <div class="flex items-start gap-3">
                    <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3" />
                        <path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4" />
                        <circle cx="20" cy="10" r="2" />
                    </svg>
                    <span>
                        <span class="block font-medium text-ink">@Model.DoctorMostrado</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Especialidad))
                        {
                            <span class="block text-sm capitalize text-muted">@Model.Especialidad</span>
                        }
                        <span class="mt-1 block text-sm text-muted">
                            @if (!string.IsNullOrWhiteSpace(Model.Matricula))
                            {
                                <span>Matrícula @Model.Matricula</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Consultorio))
                            {
                                <span aria-hidden="true"> · </span>
                                <span>Consultorio @Model.Consultorio</span>
                            }
                        </span>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 tarjeta p-6">
        <h2 class="text-base font-semibold text-ink">Observaciones</h2>
        @if (Model.TieneObservaciones)
        {
            <p class="mt-3 whitespace-pre-line text-ink">@Model.Observaciones</p>
        }
        else
        {
            <p class="mt-3 text-sm text-muted">Este turno no tiene observaciones cargadas.</p>
        }
    </div>

    @* Acciones sobre el turno. Confirmar, completar, marcar ausente y
       reprogramar son del personal (cada doctor en su agenda y la
       administración en cualquiera);
       cancelar, también del paciente, mientras el turno no haya empezado.
       Completado, ausente y cancelado son finales: no muestran ninguna. *@
    var puedeCambiarEstado = Auth.PuedeCambiarEstadoTurno && !Model.EsTerminal;
    var puedeCancelar = Auth.PuedeCancelarTurnos && Model.PuedeCancelarse
                        && (Auth.PuedeCambiarEstadoTurno || !Model.YaEmpezo);

    @if (puedeCambiarEstado || puedeCancelar)
    {
        <div class="mt-4 tarjeta p-6">
            <h2 class="text-base font-semibold text-ink">Acciones</h2>
            <div class="mt-4 flex flex-wrap items-center gap-3">
                @if (puedeCambiarEstado && Model.PuedeConfirmarse)
                {
                    <form asp-action="CambiarEstado" asp-route-id="@Model.IdTurno" method="post">
                        <input type="hidden" name="estado" value="confirmado" />
                        <button type="submit"
                                class="boton boton-primario">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M20 6 9 17l-5-5" />
                            </svg>
                            Confirmar turno
                        </button>
                    </form>
                }
                @if (puedeCambiarEstado && Model.PuedeCompletarse)
                {
                    <form asp-action="CambiarEstado" asp-route-id="@Model.IdTurno" method="post">
                        <input type="hidden" name="estado" value="completado" />
                        <button type="submit"
                                class="boton boton-secundario">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21.801 10A10 10 0 1 1 17 3.335" />
                                <path d="m9 11 3 3L22 4" />
                            </svg>
                            Marcar como completado
                        </button>
                    </form>
                }
                @if (puedeCambiarEstado && Model.PuedeMarcarAusente)
                {
                    <form asp-action="CambiarEstado" asp-route-id="@Model.IdTurno" method="post">
                        <input type="hidden" name="estado" value="ausente" />
                        <button type="submit"
                                class="boton boton-secundario">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                <path d="m17 8 5 5" />
                                <path d="m22 8-5 5" />
                            </svg>
                            Marcar ausente
                        </button>
                    </form>
                }
                @if (puedeCambiarEstado)
                {
                    @* Otro día u hora con el mismo doctor. Lleva a elegir y después a confirmar. *@
                    <a asp-action="Reprogramar" asp-route-id="@Model.IdTurno"
                       class="boton boton-secundario">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M8 2v4" />
                            <path d="M16 2v4" />
                            <rect width="18" height="18" x="3" y="4" rx="2" />
                            <path d="M3 10h18" />
                            <path d="m14 14 2 2-2 2" />
                            <path d="M8 16h8" />
                        </svg>
                        Reprogramar
                    </a>
                }
                @if (puedeCancelar)
                {
                    @* Lleva a la pantalla de confirmación: cancelar no se hace con un solo clic. *@
                    <a asp-action="Cancelar" asp-route-id="@Model.IdTurno"
                       class="boton boton-secundario text-status-cancelado">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" />
                            <path d="m15 9-6 6" />
                            <path d="m9 9 6 6" />
                        </svg>
                        Cancelar turno
                    </a>
                }
            </div>
            @if (puedeCambiarEstado && !Model.YaEmpezo)
            {
                <p class="mt-3 text-xs text-muted">
                    Cuando llegue la hora del turno vas a poder marcarlo como completado o ausente.
                </p>
            }
        </div>
    }
}
