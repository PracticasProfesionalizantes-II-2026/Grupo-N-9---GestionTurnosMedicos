@model TurnosIndexViewModel
@{
    ViewData["Title"] = "Turnos";
}

@functions {
    // Tailwind escanea texto, no ejecuta Razor: cada rama devuelve la clase
    // completa para que las encuentre al compilar el CSS.
    static string ClaseBadge(string estado) => estado?.ToLowerInvariant() switch
    {
        "confirmado" => "bg-status-confirmado/10 text-status-confirmado",
        "pendiente"  => "bg-status-pendiente/10 text-status-pendiente",
        "completado" => "bg-status-completado/10 text-status-completado",
        "cancelado"  => "bg-status-cancelado/10 text-status-cancelado",
        _            => "bg-canvas text-muted",
    };
}

<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-ink">Turnos</h1>
        <p class="mt-1 text-sm capitalize text-muted">@Model.FechaDeHoy</p>
    </div>
    @if (!Model.HuboError)
    {
        <p class="text-sm text-muted">
            <span class="font-semibold tabular-nums text-ink">@Model.Total</span>
            @(Model.Total == 1 ? "turno" : "turnos") en total
        </p>
    }
</div>

@if (Model.HuboError)
{
    <div class="mt-8 rounded-card border border-border bg-surface p-10 text-center">
        <svg class="mx-auto h-8 w-8 text-status-cancelado" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
        </svg>
        <h2 class="mt-4 text-base font-semibold text-ink">No se pudieron cargar los turnos</h2>
        <p class="mx-auto mt-1 max-w-sm text-sm text-muted">@Model.Error</p>
        <a asp-action="Index"
           class="mt-6 inline-block rounded-input border border-primary-line px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-soft">
            Reintentar
        </a>
    </div>
}
else
{
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-card border border-border bg-surface p-5">
            <div class="flex items-center gap-2 text-sm text-muted">
                <svg class="h-4 w-4 text-status-confirmado" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="m9 12 2 2 4-4" />
                </svg>
                Confirmados
            </div>
            <p class="mt-2 text-2xl font-bold tabular-nums text-ink">@Model.Confirmados</p>
        </div>

        <div class="rounded-card border border-border bg-surface p-5">
            <div class="flex items-center gap-2 text-sm text-muted">
                <svg class="h-4 w-4 text-status-pendiente" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
                Pendientes
            </div>
            <p class="mt-2 text-2xl font-bold tabular-nums text-ink">@Model.Pendientes</p>
        </div>

        <div class="rounded-card border border-border bg-surface p-5">
            <div class="flex items-center gap-2 text-sm text-muted">
                <svg class="h-4 w-4 text-status-cancelado" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="m15 9-6 6" />
                    <path d="m9 9 6 6" />
                </svg>
                Cancelados
            </div>
            <p class="mt-2 text-2xl font-bold tabular-nums text-ink">@Model.Cancelados</p>
        </div>
    </div>

    @if (Model.Turnos.Count == 0)
    {
        <div class="mt-6 rounded-card border border-border bg-surface p-10 text-center">
            <svg class="mx-auto h-8 w-8 text-primary-line" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 2v4" />
                <path d="M16 2v4" />
                <rect width="18" height="18" x="3" y="4" rx="2" />
                <path d="M3 10h18" />
            </svg>
            <h2 class="mt-4 text-base font-semibold text-ink">No hay turnos cargados</h2>
            <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
                Cuando se registren turnos en el sistema van a aparecer en esta lista.
            </p>
        </div>
    }
    else
    {
        <div class="mt-6 overflow-hidden rounded-card border border-border bg-surface">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="border-b border-border text-xs font-semibold uppercase tracking-wide text-muted">
                            <th scope="col" class="px-5 py-3 font-semibold">Hora</th>
                            <th scope="col" class="px-5 py-3 font-semibold">Paciente</th>
                            <th scope="col" class="px-5 py-3 font-semibold">Fecha</th>
                            <th scope="col" class="px-5 py-3 text-right font-semibold">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var turno in Model.Turnos)
                        {
                            <tr class="border-b border-border last:border-0 hover:bg-canvas">
                                <td class="whitespace-nowrap px-5 py-4 text-sm font-medium tabular-nums text-ink">
                                    @(turno.Hora ?? "—")
                                </td>
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        <span aria-hidden="true"
                                              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-soft text-xs font-semibold text-primary">
                                            @turno.Iniciales
                                        </span>
                                        <span>
                                            <span class="block font-medium text-ink">@turno.PacienteMostrado</span>
                                            <span class="block text-sm text-muted">@turno.DoctorMostrado</span>
                                        </span>
                                    </div>
                                </td>
                                <td class="whitespace-nowrap px-5 py-4 text-sm tabular-nums text-muted">
                                    @turno.FechaCorta
                                </td>
                                <td class="px-5 py-4 text-right">
                                    <span class="inline-block rounded-badge px-2 py-1 text-xs font-semibold capitalize @ClaseBadge(turno.Estado)">
                                        @turno.Estado
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.HayMas || Model.FaltaHora)
        {
            <div class="mt-3 space-y-1 text-xs text-muted">
                @if (Model.HayMas)
                {
                    <p>Mostrando @Model.Turnos.Count de @Model.Total turnos.</p>
                }
                @if (Model.FaltaHora)
                {
                    <p>La API no informa el horario en el listado (GET /turnos), por eso la columna aparece vacía.</p>
                }
            </div>
        }
    }
}
