@model TurnosIndexViewModel
@inject AuthService Auth
@{
    ViewData["Title"] = Model.Titulo;

    // La URL de este mismo listado, con la tarjeta activa, el orden, las
    // fechas y la página. Viaja en "volver" al confirmar o cancelar un turno,
    // para volver a esta vista y no al listado sin filtros.
    var volver = Url.Action("Index", "Turnos", Model.Filtros.RutaDePagina(Model.Filtros.Pagina));

    // Al paciente los estados y las fechas se le dicen con palabras (A4).
    var esPaciente = Model.Rol == "paciente";

    // Las acciones de una fila (confirmar, completado, ausente, cancelar).
    // Las usan la tabla y las tarjetas del celular. Cada una lleva un área
    // táctil más alta que el texto (area-tactil) y el z-10 que la deja por
    // encima del enlace que cubre la fila.
    async Task Acciones(TurnoFilaViewModel turno)
    {
        @if (Auth.PuedeCambiarEstadoTurno && turno.PuedeConfirmarse)
        {
            <form asp-action="CambiarEstado" asp-route-id="@turno.IdTurno" method="post" class="relative z-10">
                <input type="hidden" name="estado" value="confirmado" />
                <input type="hidden" name="volverA" value="Index" />
                <input type="hidden" name="volver" value="@volver" />
                <button type="submit" data-cargando="Confirmando…"
                        class="boton-texto area-tactil px-2 py-1">
                    Confirmar
                    <span class="sr-only">el turno de @turno.PacienteMostrado @turno.CuandoParaLector</span>
                </button>
            </form>
        }
        @* Completado y ausente, cuando ya llegó la hora: llevan a
           una confirmación porque no se deshacen. *@
        @if (Auth.PuedeCambiarEstadoTurno && turno.PuedeCerrarse)
        {
            <a asp-action="Marcar" asp-route-id="@turno.IdTurno" asp-route-estado="completado" asp-route-volver="@volver"
               class="boton-texto area-tactil relative z-10 px-2 py-1">
                Completado
                <span class="sr-only">: marcar el turno de @turno.PacienteMostrado @turno.CuandoParaLector</span>
            </a>
            <a asp-action="Marcar" asp-route-id="@turno.IdTurno" asp-route-estado="ausente" asp-route-volver="@volver"
               class="boton-texto area-tactil relative z-10 px-2 py-1">
                Ausente
                <span class="sr-only">: marcar el turno de @turno.PacienteMostrado @turno.CuandoParaLector</span>
            </a>
        }
        @* El paciente no cancela un turno que ya empezó. *@
        @if (turno.PuedeCancelarse && (Auth.PuedeCambiarEstadoTurno || !turno.YaEmpezo))
        {
            <a asp-action="Cancelar" asp-route-id="@turno.IdTurno" asp-route-volver="@volver"
               class="boton-texto area-tactil relative z-10 px-2 py-1 text-status-cancelado">
                Cancelar
                <span class="sr-only">el turno @(esPaciente ? $"con {turno.DoctorMostrado}" : $"de {turno.PacienteMostrado}") @turno.CuandoParaLector</span>
            </a>
        }
    }

    // Si una fila tiene alguna acción para mostrar.
    bool TieneAcciones(TurnoFilaViewModel turno) =>
        Auth.PuedeCancelarTurnos
        && ((Auth.PuedeCambiarEstadoTurno && (turno.PuedeConfirmarse || turno.PuedeCerrarse))
            || (turno.PuedeCancelarse && (Auth.PuedeCambiarEstadoTurno || !turno.YaEmpezo)));

    // Encabezado de una columna ordenable: un enlace que vuelve al listado
    // ordenado por ella. En la que ya ordena la tabla lleva la flecha y el
    // aria-sort, y tocarla de nuevo invierte la dirección.
    async Task Encabezado(string columna, string titulo, string? alineacion = null)
    {
        var activa = Model.Filtros.OrdenaPor(columna);
        var sentido = !activa ? null : Model.Filtros.Descendente ? "descending" : "ascending";

        <th scope="col" aria-sort="@sentido" class="px-5 py-3 font-semibold @alineacion">
            <a asp-action="Index" asp-all-route-data="Model.Filtros.RutaDeOrden(columna)"
               class="inline-flex items-center gap-1 rounded-badge hover:text-primary">
                @titulo
                @* El lector de pantalla lee "Hora, ordenar por esta columna": sin
                   esto, un encabezado que es enlace no dice para qué sirve. *@
                <span class="sr-only">, ordenar por esta columna</span>
                @if (activa)
                {
                    <icono nombre="@(Model.Filtros.Descendente ? "flecha-abajo" : "flecha-arriba")" class="h-3.5 w-3.5" />
                }
            </a>
        </th>
    }
}

<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-ink">@Model.Titulo</h1>
        <p class="mt-1 text-sm text-muted first-letter:uppercase">@Model.FechaDeHoy</p>
        @if (Model.Subtitulo is not null)
        {
            <p class="mt-1 text-xs text-muted">@Model.Subtitulo</p>
        }
    </div>
    <div class="flex flex-wrap items-center justify-end gap-x-5 gap-y-3">
        @if (!Model.HuboError)
        {
            <p class="text-sm text-muted">
                <span class="font-semibold tabular-nums text-ink">@Model.Total</span>
                @(Model.Total == 1 ? "turno" : "turnos")@(Model.Filtros.SoloProximos ? " de hoy en adelante" : "")@(Model.Filtros.SinCerrar ? " sin cerrar" : "")
            </p>
        }
        @* Solo doctor y administrador pueden elegir el paciente de la lista. *@
        @if (Auth.PuedeCargarTurnos)
        {
            <a asp-action="Crear"
               class="boton boton-primario">
                <icono nombre="mas" class="h-4 w-4" />
                Nuevo turno
            </a>
        }
    </div>
</div>

@* "Sin cerrar" no tiene fechas ni tarjetas: es una lista fija de lo que
   quedó abierto. Solo ofrece volver a la agenda. *@
@if (Model.Filtros.SinCerrar)
{
    <p class="mt-4">
        <a asp-action="Index" class="boton-texto">
            <icono nombre="volver" class="h-4 w-4" />
            Volver a la agenda
        </a>
    </p>
}
else
{
@* Filtros por GET: los valores viajan en la query string, así el listado
   filtrado se puede compartir o recargar. El estado se elige con las tarjetas
   de abajo; acá viaja oculto para que "Filtrar" no lo pierda. *@
<form method="get" asp-action="Index"
      class="mt-6 flex flex-wrap items-end gap-4 tarjeta p-5">
    @if (Model.Filtros.Estado is not null)
    {
        <input type="hidden" name="estado" value="@Model.Filtros.Estado" />
    }
    @if (Model.Filtros.Orden is not null)
    {
        <input type="hidden" name="orden" value="@Model.Filtros.Orden" />
    }
    @if (Model.Filtros.Descendente)
    {
        <input type="hidden" name="dir" value="desc" />
    }
    @if (Model.Filtros.VerTodos)
    {
        <input type="hidden" name="ver" value="todos" />
    }

    <div>
        <label for="desde" class="block text-sm font-medium text-ink">Desde</label>
        <input id="desde" name="desde" type="date" value="@(Model.Filtros.Desde?.ToString("yyyy-MM-dd"))"
               class="campo mt-1.5 w-auto tabular-nums" />
    </div>

    <div>
        <label for="hasta" class="block text-sm font-medium text-ink">Hasta</label>
        <input id="hasta" name="hasta" type="date" value="@(Model.Filtros.Hasta?.ToString("yyyy-MM-dd"))"
               class="campo mt-1.5 w-auto tabular-nums" />
    </div>

    <div class="flex items-center gap-2">
        <button type="submit"
                class="boton boton-primario">
            Filtrar
        </button>
        @if (Model.Filtros.HayAlguno)
        {
            <a asp-action="Index"
               class="boton boton-secundario">
                Limpiar
            </a>
        }
    </div>

    @if (Model.Filtros.RangoInvertido)
    {
        <p class="w-full text-xs text-status-pendiente">
            La fecha «desde» es posterior a la «hasta», por eso no aparece ningún turno.
        </p>
    }
</form>

@* Sin fechas elegidas, el listado muestra los turnos de hoy en adelante, o
   todos si se pidió. Con fechas, mandan las fechas y esto no aparece. *@
@if (!Model.Filtros.HayFechas)
{
    <p class="mt-3 text-sm text-muted">
        @if (Model.Filtros.VerTodos)
        {
            <span>Se muestran todos los turnos, también los pasados.</span>
            <a asp-action="Index" asp-all-route-data="Model.Filtros.RutaVerTodos(false)"
               class="rounded-badge font-semibold text-primary hover:text-primary-hover hover:underline">Ver solo los próximos</a>
        }
        else
        {
            <span>Se muestran los turnos de hoy en adelante.</span>
            <a asp-action="Index" asp-all-route-data="Model.Filtros.RutaVerTodos(true)"
               class="rounded-badge font-semibold text-primary hover:text-primary-hover hover:underline">Ver todos, también los pasados</a>
        }
    </p>
}
}

@if (Model.Aviso is not null)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "info", Tono = TonoVacio.Aviso, Nivel = 2, Titulo = "No podemos mostrarte turnos", Ayuda = Model.Aviso }' />
    </div>
}
else if (Model.HuboError)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudieron cargar los turnos", Ayuda = Model.Error, Accion = new EnlaceViewModel { Controlador = "Turnos", Accion = "Index", Descripcion = "Reintentar" } }' />
    </div>
}
else
{
    @* Las tarjetas son el filtro de estado: cada una es un botón de un
       formulario GET que manda su estado, y la activa manda el valor vacío,
       que es lo que la apaga. El formulario es la grilla misma y se cierra
       antes de la tabla, así no queda anidado con los de las filas. Adentro
       van <span> porque un <button> no admite elementos de bloque. *@
    @if (!Model.Filtros.SinCerrar)
    {
    <form method="get" asp-action="Index" class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
        @if (Model.Filtros.Desde is { } desde)
        {
            <input type="hidden" name="desde" value="@desde.ToString("yyyy-MM-dd")" />
        }
        @if (Model.Filtros.Hasta is { } hasta)
        {
            <input type="hidden" name="hasta" value="@hasta.ToString("yyyy-MM-dd")" />
        }
        @if (Model.Filtros.Orden is not null)
        {
            <input type="hidden" name="orden" value="@Model.Filtros.Orden" />
        }
        @if (Model.Filtros.Descendente)
        {
            <input type="hidden" name="dir" value="desc" />
        }
        @if (Model.Filtros.VerTodos)
        {
            <input type="hidden" name="ver" value="todos" />
        }

        <button type="submit" name="estado"
                value="@(Model.Filtros.EstaActivo("confirmado") ? "" : "confirmado")"
                aria-pressed="@(Model.Filtros.EstaActivo("confirmado") ? "true" : "false")"
                class="tarjeta tarjeta-filtro w-full p-5 text-left">
            <span class="flex items-center gap-2 text-sm text-muted">
                <icono nombre="check-circulo" class="h-4 w-4 text-status-confirmado" />
                Confirmados
            </span>
            <span class="mt-2 block text-2xl font-bold tabular-nums text-status-confirmado">@Model.Confirmados</span>
        </button>

        <button type="submit" name="estado"
                value="@(Model.Filtros.EstaActivo("pendiente") ? "" : "pendiente")"
                aria-pressed="@(Model.Filtros.EstaActivo("pendiente") ? "true" : "false")"
                class="tarjeta tarjeta-filtro w-full p-5 text-left">
            <span class="flex items-center gap-2 text-sm text-muted">
                <icono nombre="reloj" class="h-4 w-4 text-status-pendiente" />
                @(esPaciente ? "Esperando confirmación" : "Pendientes")
            </span>
            <span class="mt-2 block text-2xl font-bold tabular-nums text-status-pendiente">@Model.Pendientes</span>
        </button>

        <button type="submit" name="estado"
                value="@(Model.Filtros.EstaActivo("completado") ? "" : "completado")"
                aria-pressed="@(Model.Filtros.EstaActivo("completado") ? "true" : "false")"
                class="tarjeta tarjeta-filtro w-full p-5 text-left">
            <span class="flex items-center gap-2 text-sm text-muted">
                <icono nombre="completado" class="h-4 w-4 text-status-completado" />
                @(esPaciente ? "Atendidos" : "Completados")
            </span>
            <span class="mt-2 block text-2xl font-bold tabular-nums text-status-completado">@Model.Completados</span>
        </button>

        <button type="submit" name="estado"
                value="@(Model.Filtros.EstaActivo("ausente") ? "" : "ausente")"
                aria-pressed="@(Model.Filtros.EstaActivo("ausente") ? "true" : "false")"
                class="tarjeta tarjeta-filtro w-full p-5 text-left">
            <span class="flex items-center gap-2 text-sm text-muted">
                <icono nombre="usuario-x" class="h-4 w-4 text-muted" />
                Ausentes
            </span>
            <span class="mt-2 block text-2xl font-bold tabular-nums text-ink">@Model.Ausentes</span>
        </button>

        <button type="submit" name="estado"
                value="@(Model.Filtros.EstaActivo("cancelado") ? "" : "cancelado")"
                aria-pressed="@(Model.Filtros.EstaActivo("cancelado") ? "true" : "false")"
                class="tarjeta tarjeta-filtro col-span-2 w-full p-5 text-left sm:col-span-1">
            <span class="flex items-center gap-2 text-sm text-muted">
                <icono nombre="x-circulo" class="h-4 w-4 text-status-cancelado" />
                Cancelados
            </span>
            <span class="mt-2 block text-2xl font-bold tabular-nums text-status-cancelado">@Model.Cancelados</span>
        </button>
    </form>
    }

    @if (Model.Turnos.Count == 0)
    {
        <div class="tarjeta mt-6">
            @if (Model.Filtros.SinCerrar)
            {
                <partial name="_EstadoVacio"
                         model='new EstadoVacioViewModel { Icono = "calendario", Nivel = 2, Titulo = "No hay turnos sin cerrar", Ayuda = "¡Todo al día! Los turnos de días anteriores ya están marcados como completados o ausentes.", Accion = new EnlaceViewModel { Controlador = "Turnos", Accion = "Index", Descripcion = "Volver a la agenda" } }' />
            }
            else if (Model.SinTurnosDelEstado)
            {
                @* Hay turnos, pero ninguno del estado de la tarjeta activa. "Ver
                   todos" saca solo el estado: las fechas elegidas se conservan. *@
                <partial name="_EstadoVacio"
                         model='new EstadoVacioViewModel { Icono = "calendario", Nivel = 2, Titulo = $"No hay turnos {Model.Filtros.Estado}s", Ayuda = "Elegí otra tarjeta o volvé a ver todos los turnos.", Accion = new EnlaceViewModel { Controlador = "Turnos", Accion = "Index", Ruta = Model.Filtros.Ruta(null), Descripcion = "Ver todos" } }' />
            }
            else if (Model.SinResultados)
            {
                <partial name="_EstadoVacio"
                         model='new EstadoVacioViewModel { Icono = "calendario", Nivel = 2, Titulo = "Ningún turno coincide con los filtros", Ayuda = "Probá ampliando el rango de fechas.", Accion = new EnlaceViewModel { Controlador = "Turnos", Accion = "Index", Descripcion = "Limpiar filtros" } }' />
            }
            else if (Model.SinProximos)
            {
                @* No hay turnos de hoy en adelante, pero puede haber pasados. *@
                <partial name="_EstadoVacio"
                         model='new EstadoVacioViewModel { Icono = "calendario", Nivel = 2, Titulo = "No hay turnos de hoy en adelante", Ayuda = "Los turnos anteriores están en la lista completa.", Accion = new EnlaceViewModel { Controlador = "Turnos", Accion = "Index", Ruta = Model.Filtros.RutaVerTodos(true), Descripcion = "Ver todos, también los pasados" } }' />
            }
            else
            {
                @* El botón de alta solo para quien puede cargar turnos, igual
                   que el "Nuevo turno" de arriba. *@
                <partial name="_EstadoVacio"
                         model='new EstadoVacioViewModel { Icono = "calendario", Nivel = 2, Titulo = "No hay turnos para mostrar", Ayuda = Model.TextoVacio, Accion = Auth.PuedeCargarTurnos ? new EnlaceViewModel { Controlador = "Turnos", Accion = "Crear", Descripcion = "Nuevo turno" } : null }' />
            }
        </div>
    }
    else
    {
        @* En el celular, tarjetas en vez de la tabla: cinco columnas no entran
           sin desplazarse de costado. Cada tarjeta lleva el bloque de
           calendario, a quién o con quién, la hora, el estado y las acciones. *@
        <div class="mt-6 overflow-hidden tarjeta md:hidden">
            <ul>
                @{ var tarjeta = 0; }
                @foreach (var turno in Model.Turnos)
                {
                    var principal = esPaciente ? turno.DoctorMostrado : turno.PacienteMostrado;
                    var secundario = esPaciente ? turno.EspecialidadMostrada : turno.DoctorMostrado;

                    <li class="fila-animada @FranjaEstado.Clase(turno.Estado) border-b border-border px-5 py-4 last:border-0 hover:bg-primary-soft/50"
                        style="--i: @(tarjeta++)">
                        <div class="flex items-start gap-3">
                            <partial name="_FechaTile" model="new FechaTileViewModel { Fecha = turno.FechaInicio }" />
                            <div class="min-w-0 flex-1">
                                <a asp-action="Detalle" asp-route-id="@turno.IdTurno"
                                   class="block truncate rounded-badge font-medium text-ink after:absolute after:inset-0 hover:text-primary">
                                    @principal
                                    <span class="sr-only">— ver el turno @turno.CuandoParaLector</span>
                                </a>
                                <span class="block truncate text-sm text-muted">
                                    <span class="font-semibold tabular-nums text-ink">@(turno.Hora is null ? "Sin hora" : $"{turno.Hora} hs")</span>
                                    @if (secundario is not null)
                                    {
                                        <span aria-hidden="true"> · </span>
                                        <span class="@(esPaciente ? "capitalize" : null)">@secundario</span>
                                    }
                                </span>
                                <span class="mt-2 block">
                                    <partial name="_BadgeEstado" model="turno.Estado" />
                                </span>
                            </div>
                        </div>
                        @if (TieneAcciones(turno))
                        {
                            <div class="mt-2 flex flex-wrap items-center justify-end gap-x-1 gap-y-2">
                                @{ await Acciones(turno); }
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>

        <div class="mt-6 hidden overflow-hidden tarjeta md:block">
            @* relative: los textos sr-only (posición absoluta) quedan adentro
               del scroll de la tabla. Sin eso se ubicaban respecto de la
               página y en el celular toda la página se corría de costado. *@
            <div class="relative overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="tarjeta-encabezado text-xs font-semibold text-primary-deep">
                            @{
                                await Encabezado("hora", "Hora");
                                // Al paciente la columna le muestra con quién es el turno:
                                // el paciente es siempre él. La API no ordena por doctor,
                                // así que ese encabezado no es un enlace.
                                if (esPaciente)
                                {
                                    <th scope="col" class="px-5 py-3 font-semibold">Doctor</th>
                                }
                                else
                                {
                                    await Encabezado("paciente", "Paciente");
                                }
                                await Encabezado("fecha", "Fecha");
                                await Encabezado("estado", "Estado", "text-right");
                            }
                            @if (Auth.PuedeCancelarTurnos)
                            {
                                <th scope="col" class="px-5 py-3 text-right font-semibold">
                                    <span class="sr-only">Acciones</span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{ var fila = 0; }
                        @foreach (var turno in Model.Turnos)
                        {
                            <tr class="fila-animada border-b border-border last:border-0 hover:bg-primary-soft/50"
                                style="--i: @(fila++)">
                                @* La franja del color del estado va en la primera celda:
                                   en una fila de tabla no se puede posicionar. *@
                                <td class="@FranjaEstado.Clase(turno.Estado) whitespace-nowrap px-5 py-4 text-sm font-medium tabular-nums text-ink">
                                    @(turno.Hora ?? "—")
                                </td>
                                @* La celda es el contenedor posicionado y el enlace la cubre entera
                                   con after:absolute inset-0. Así se navega con click o con teclado
                                   (el foco cae sobre el nombre) sin poner un onclick en el <tr>. *@
                                <td class="relative px-5 py-4">
                                    @if (esPaciente)
                                    {
                                        @* El paciente ve con quién es cada turno. *@
                                        <a asp-action="Detalle" asp-route-id="@turno.IdTurno"
                                           class="block rounded-badge font-medium text-ink after:absolute after:inset-0 hover:text-primary">
                                            @turno.DoctorMostrado
                                            <span class="sr-only">— ver el turno @turno.CuandoParaLector</span>
                                        </a>
                                        @if (turno.EspecialidadMostrada is not null)
                                        {
                                            <span class="block text-sm capitalize text-muted">@turno.EspecialidadMostrada</span>
                                        }
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-3">
                                            <partial name="_Avatar"
                                                     model="new AvatarViewModel { Nombre = turno.Paciente, FotoUrl = turno.FotoUrl, Tamano = TamanoAvatar.Chico }" />
                                            <span>
                                                <a asp-action="Detalle" asp-route-id="@turno.IdTurno"
                                                   class="block rounded-badge font-medium text-ink after:absolute after:inset-0 hover:text-primary">
                                                    @turno.PacienteMostrado
                                                    <span class="sr-only">— ver el turno @turno.CuandoParaLector</span>
                                                </a>
                                                <span class="block text-sm text-muted">
                                                    @turno.DoctorMostrado
                                                    @if (turno.EspecialidadMostrada is not null)
                                                    {
                                                        <span aria-hidden="true"> · </span>
                                                        <span class="capitalize">@turno.EspecialidadMostrada</span>
                                                    }
                                                </span>
                                            </span>
                                        </div>
                                    }
                                </td>
                                @* El paciente lee el día con palabras ("viernes 16 de
                                   octubre"); el personal, la fecha corta de siempre. *@
                                <td class="whitespace-nowrap px-5 py-4 text-sm tabular-nums text-muted">
                                    @(esPaciente ? turno.DiaParaPaciente : turno.FechaCorta)
                                </td>
                                <td class="px-5 py-4 text-right">
                                    <partial name="_BadgeEstado" model="turno.Estado" />
                                </td>
                                @if (Auth.PuedeCancelarTurnos)
                                {
                                    @* El enlace estirado está acotado a la celda del paciente, pero
                                       el z-10 deja esto a salvo si algún día se mueve al <tr>. *@
                                    <td class="whitespace-nowrap px-5 py-4 text-right">
                                        <div class="flex items-center justify-end gap-1">
                                            @{ await Acciones(turno); }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <partial name="_Paginador" model="Model.Paginador" />

        @if (Model.FaltaHora)
        {
            <p class="mt-3 text-xs text-muted">
                Algunos turnos no tienen horario cargado y por eso la columna aparece con un guion.
            </p>
        }
    }
}
