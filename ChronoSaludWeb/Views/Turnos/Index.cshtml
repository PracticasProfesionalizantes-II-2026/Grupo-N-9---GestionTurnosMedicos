@model TurnosIndexViewModel
@inject AuthService Auth
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-ink">@Model.Titulo</h1>
        <p class="mt-1 text-sm capitalize text-muted">@Model.FechaDeHoy</p>
        @if (Model.Subtitulo is not null)
        {
            <p class="mt-1 text-xs text-muted">@Model.Subtitulo</p>
        }
    </div>
    <div class="flex flex-wrap items-center justify-end gap-x-5 gap-y-3">
        @if (!Model.HuboError)
        {
            <p class="text-sm text-muted">
                <span class="font-semibold tabular-nums text-ink">@Model.Total</span>
                @(Model.Total == 1 ? "turno" : "turnos") en total
            </p>
        }
        @* Solo doctor y administrador pueden elegir el paciente de la lista. *@
        @if (Auth.PuedeCargarTurnos)
        {
            <a asp-action="Crear"
               class="boton boton-primario">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="M12 5v14" />
                </svg>
                Nuevo turno
            </a>
        }
    </div>
</div>

@* Filtros por GET: los valores viajan en la query string, así el listado
   filtrado se puede compartir o recargar. *@
<form method="get" asp-action="Index"
      class="mt-6 flex flex-wrap items-end gap-4 tarjeta p-5">
    <div class="w-full sm:w-auto sm:min-w-40">
        <label for="estado" class="block text-sm font-medium text-ink">Estado</label>
        <select id="estado" name="estado" asp-items="Model.Filtros.Opciones()"
                class="campo mt-1.5 capitalize">
            <option value="">Todos</option>
        </select>
    </div>

    <div>
        <label for="desde" class="block text-sm font-medium text-ink">Desde</label>
        <input id="desde" name="desde" type="date" value="@(Model.Filtros.Desde?.ToString("yyyy-MM-dd"))"
               class="campo mt-1.5 w-auto tabular-nums" />
    </div>

    <div>
        <label for="hasta" class="block text-sm font-medium text-ink">Hasta</label>
        <input id="hasta" name="hasta" type="date" value="@(Model.Filtros.Hasta?.ToString("yyyy-MM-dd"))"
               class="campo mt-1.5 w-auto tabular-nums" />
    </div>

    <div class="flex items-center gap-2">
        <button type="submit"
                class="boton boton-primario">
            Filtrar
        </button>
        @if (Model.Filtros.HayAlguno)
        {
            <a asp-action="Index"
               class="boton boton-secundario">
                Limpiar
            </a>
        }
    </div>

    @if (Model.Filtros.RangoInvertido)
    {
        <p class="w-full text-xs text-status-pendiente">
            La fecha "desde" es posterior a la "hasta", por eso no aparece ningún turno.
        </p>
    }
</form>

@if (Model.Aviso is not null)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "info", Tono = TonoVacio.Aviso, Nivel = 2, Titulo = "No podemos mostrarte turnos", Ayuda = Model.Aviso }' />
    </div>
}
else if (Model.HuboError)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudieron cargar los turnos", Ayuda = Model.Error, Accion = new EnlaceViewModel { Controlador = "Turnos", Accion = "Index", Descripcion = "Reintentar" } }' />
    </div>
}
else
{
    <div class="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
        <div class="tarjeta p-5">
            <div class="flex items-center gap-2 text-sm text-muted">
                <svg class="h-4 w-4 text-status-confirmado" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="m9 12 2 2 4-4" />
                </svg>
                Confirmados
            </div>
            <p class="mt-2 text-2xl font-bold tabular-nums text-ink">@Model.Confirmados</p>
        </div>

        <div class="tarjeta p-5">
            <div class="flex items-center gap-2 text-sm text-muted">
                <svg class="h-4 w-4 text-status-pendiente" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
                Pendientes
            </div>
            <p class="mt-2 text-2xl font-bold tabular-nums text-ink">@Model.Pendientes</p>
        </div>

        <div class="tarjeta p-5">
            <div class="flex items-center gap-2 text-sm text-muted">
                <svg class="h-4 w-4 text-status-completado" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21.801 10A10 10 0 1 1 17 3.335" />
                    <path d="m9 11 3 3L22 4" />
                </svg>
                Completados
            </div>
            <p class="mt-2 text-2xl font-bold tabular-nums text-ink">@Model.Completados</p>
        </div>

        <div class="tarjeta p-5">
            <div class="flex items-center gap-2 text-sm text-muted">
                <svg class="h-4 w-4 text-status-cancelado" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="m15 9-6 6" />
                    <path d="m9 9 6 6" />
                </svg>
                Cancelados
            </div>
            <p class="mt-2 text-2xl font-bold tabular-nums text-ink">@Model.Cancelados</p>
        </div>
    </div>

    @if (Model.Turnos.Count == 0)
    {
        <div class="tarjeta mt-6">
            @if (Model.SinResultados)
            {
                <partial name="_EstadoVacio"
                         model='new EstadoVacioViewModel { Icono = "calendario", Nivel = 2, Titulo = "Ningún turno coincide con los filtros", Ayuda = "Probá con otro estado o ampliá el rango de fechas.", Accion = new EnlaceViewModel { Controlador = "Turnos", Accion = "Index", Descripcion = "Limpiar filtros" } }' />
            }
            else
            {
                @* El botón de alta solo para quien puede cargar turnos, igual
                   que el "Nuevo turno" de arriba. *@
                <partial name="_EstadoVacio"
                         model='new EstadoVacioViewModel { Icono = "calendario", Nivel = 2, Titulo = "No hay turnos para mostrar", Ayuda = Model.TextoVacio, Accion = Auth.PuedeCargarTurnos ? new EnlaceViewModel { Controlador = "Turnos", Accion = "Crear", Descripcion = "Nuevo turno" } : null }' />
            }
        </div>
    }
    else
    {
        <div class="mt-6 overflow-hidden tarjeta">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="border-b border-border text-xs font-semibold text-muted">
                            <th scope="col" class="px-5 py-3 font-semibold">Hora</th>
                            <th scope="col" class="px-5 py-3 font-semibold">Paciente</th>
                            <th scope="col" class="px-5 py-3 font-semibold">Fecha</th>
                            <th scope="col" class="px-5 py-3 text-right font-semibold">Estado</th>
                            @if (Auth.PuedeCancelarTurnos)
                            {
                                <th scope="col" class="px-5 py-3 text-right font-semibold">
                                    <span class="sr-only">Acciones</span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{ var fila = 0; }
                        @foreach (var turno in Model.Turnos)
                        {
                            <tr class="fila-animada border-b border-border last:border-0 hover:bg-surface"
                                style="animation-delay: @(Math.Min(fila++, 12) * 40)ms">
                                <td class="whitespace-nowrap px-5 py-4 text-sm font-medium tabular-nums text-ink">
                                    @(turno.Hora ?? "—")
                                </td>
                                @* La celda es el contenedor posicionado y el enlace la cubre entera
                                   con after:absolute inset-0. Así se navega con click o con teclado
                                   (el foco cae sobre el nombre) sin poner un onclick en el <tr>. *@
                                <td class="relative px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        <partial name="_Avatar"
                                                 model="new AvatarViewModel { Nombre = turno.Paciente, FotoUrl = turno.FotoUrl, Tamano = TamanoAvatar.Chico }" />
                                        <span>
                                            <a asp-action="Detalle" asp-route-id="@turno.IdTurno"
                                               class="block rounded-badge font-medium text-ink after:absolute after:inset-0 hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                                                @turno.PacienteMostrado
                                                <span class="sr-only">— ver detalle del turno</span>
                                            </a>
                                            <span class="block text-sm text-muted">
                                                @turno.DoctorMostrado
                                                @if (turno.EspecialidadMostrada is not null)
                                                {
                                                    <span aria-hidden="true"> · </span>
                                                    <span class="capitalize">@turno.EspecialidadMostrada</span>
                                                }
                                            </span>
                                        </span>
                                    </div>
                                </td>
                                <td class="whitespace-nowrap px-5 py-4 text-sm tabular-nums text-muted">
                                    @turno.FechaCorta
                                </td>
                                <td class="px-5 py-4 text-right">
                                    <partial name="_BadgeEstado" model="turno.Estado" />
                                </td>
                                @if (Auth.PuedeCancelarTurnos)
                                {
                                    @* El enlace estirado está acotado a la celda del paciente, pero
                                       el z-10 deja esto a salvo si algún día se mueve al <tr>. *@
                                    <td class="whitespace-nowrap px-5 py-4 text-right">
                                        <div class="flex items-center justify-end gap-1">
                                            @if (Auth.PuedeCambiarEstadoTurno && turno.PuedeConfirmarse)
                                            {
                                                <form asp-action="CambiarEstado" asp-route-id="@turno.IdTurno" method="post" class="relative z-10">
                                                    <input type="hidden" name="estado" value="confirmado" />
                                                    <input type="hidden" name="volverA" value="Index" />
                                                    <button type="submit"
                                                            class="boton-texto px-2 py-1">
                                                        Confirmar
                                                        <span class="sr-only">el turno de @turno.PacienteMostrado</span>
                                                    </button>
                                                </form>
                                            }
                                            @if (!turno.EstaCancelado)
                                            {
                                                <a asp-action="Cancelar" asp-route-id="@turno.IdTurno"
                                                   class="boton-texto relative z-10 px-2 py-1 text-status-cancelado">
                                                    Cancelar
                                                    <span class="sr-only">el turno de @turno.PacienteMostrado</span>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.HayMas || Model.FaltaHora)
        {
            <div class="mt-3 space-y-1 text-xs text-muted">
                @if (Model.HayMas)
                {
                    <p>Mostrando @Model.Turnos.Count de @Model.Total turnos.</p>
                }
                @if (Model.FaltaHora)
                {
                    <p>Algunos turnos no tienen horario cargado y por eso la columna aparece con un guion.</p>
                }
            </div>
        }
    }
}
