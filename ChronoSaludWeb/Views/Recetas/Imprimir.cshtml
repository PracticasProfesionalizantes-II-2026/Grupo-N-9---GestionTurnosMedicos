@model RecetaImprimirViewModel
@{
    ViewData["Title"] = Model.Receta is null ? "Receta" : $"Receta #{Model.Receta.IdReceta}";

    // Si la receta no se pudo cargar, se vuelve al listado.
    var volverA = Model.Receta is null ? "Index" : "Detalle";
    var textoVolver = Model.Receta is null ? "Volver a recetas" : "Volver a la receta";
}

@* La hoja de la receta. Sin JavaScript: se imprime con el menú del
   navegador. Lo que lleva print:hidden no sale en el papel, y el bloque
   @media print de app.css deja la hoja en blanco y negro. *@

<a asp-action="@volverA" asp-route-id="@(Model.Receta?.IdReceta)" asp-route-paciente="@Model.IdPaciente"
   class="boton-texto text-muted hover:text-primary print:hidden">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    @textoVolver
</a>

@if (Model.HuboError || Model.Receta is null)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudo cargar la receta", Ayuda = Model.Error }' />
    </div>
}
else
{
    var receta = Model.Receta;

    <div class="mx-auto mt-6 flex max-w-3xl items-start gap-3 rounded-input border border-border bg-surface px-4 py-3 text-sm text-muted print:hidden">
        <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 16v-4" />
            <path d="M12 8h.01" />
        </svg>
        <p>
            Para imprimirla o guardarla como PDF, usá <span class="font-medium text-ink">Imprimir</span>
            en el menú del navegador (Ctrl + P). Sale solo la hoja.
        </p>
    </div>

    <article class="hoja-receta tarjeta mx-auto mt-6 max-w-3xl p-6 sm:p-10" aria-labelledby="titulo-receta">
        <header class="flex flex-wrap items-start justify-between gap-4 border-b border-border pb-5">
            <p class="flex items-center gap-2 text-lg font-bold tracking-tight text-primary">
                <svg class="size-7 shrink-0" viewBox="0 0 32 32" aria-hidden="true">
                    <rect width="32" height="32" rx="7" class="fill-primary" />
                    <path d="M16 8v8l5 3" fill="none" class="stroke-on-primary" stroke-width="3"
                          stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                ChronoSalud
            </p>
            <div class="text-sm text-muted sm:text-right">
                <h1 id="titulo-receta" class="text-xl font-bold text-ink">Receta N.º @receta.IdReceta</h1>
                <p class="mt-1">Emitida el <span class="tabular-nums">@receta.FechaCorta</span></p>
                <p>Vigente hasta el <span class="tabular-nums">@receta.VigenciaCorta</span></p>
            </div>
        </header>

        <section class="border-b border-border py-5" aria-labelledby="titulo-paciente">
            <h2 id="titulo-paciente" class="text-xs font-semibold uppercase tracking-wide text-muted">Paciente</h2>
            <p class="mt-1 text-lg font-medium text-ink">@(Model.NombrePaciente ?? "Sin datos")</p>
            @if (Model.Documento is not null)
            {
                <p class="text-sm tabular-nums text-ink">@Model.Documento</p>
            }
        </section>

        <section class="py-5" aria-labelledby="titulo-rp">
            <h2 id="titulo-rp" class="text-2xl font-bold italic text-ink">Rp/</h2>

            @if (receta.Medicamentos.Count == 0)
            {
                <p class="mt-3 text-sm text-muted">La receta no tiene medicamentos cargados.</p>
            }
            else
            {
                <ol class="mt-3 space-y-4">
                    @for (var i = 0; i < receta.Medicamentos.Count; i++)
                    {
                        var medicamento = receta.Medicamentos[i];

                        <li class="flex gap-3 break-inside-avoid">
                            <span class="font-semibold tabular-nums text-ink">@(i + 1).</span>
                            <div class="min-w-0">
                                <p class="font-semibold text-ink">@medicamento.DescripcionParaImprimir</p>
                                <p class="mt-1 text-sm text-ink">
                                    <span class="text-muted">Dosis:</span> @medicamento.Dosis
                                    <span aria-hidden="true"> · </span>
                                    <span class="text-muted">Frecuencia:</span> @medicamento.Frecuencia
                                    @if (!string.IsNullOrWhiteSpace(medicamento.Duracion))
                                    {
                                        <span aria-hidden="true"> · </span>
                                        <span class="text-muted">Duración:</span> @medicamento.Duracion
                                    }
                                </p>
                                @if (!string.IsNullOrWhiteSpace(medicamento.IndicacionesMostradas))
                                {
                                    <p class="mt-1 whitespace-pre-line text-sm text-ink"><span class="text-muted">Indicaciones:</span> @medicamento.IndicacionesMostradas</p>
                                }
                            </div>
                        </li>
                    }
                </ol>
            }
        </section>

        @if (receta.TieneDetalles)
        {
            <section class="border-t border-border py-5" aria-labelledby="titulo-detalles">
                <h2 id="titulo-detalles" class="text-xs font-semibold uppercase tracking-wide text-muted">Detalles</h2>
                <p class="mt-1 whitespace-pre-line text-ink">@receta.Detalles</p>
            </section>
        }

        @* Lugar para la firma y el sello, con los datos de quien la firmó. *@
        <div class="mt-16 flex justify-end break-inside-avoid">
            <div class="w-64 max-w-full border-t border-ink pt-2 text-center">
                <p class="text-xs text-muted">Firma y sello</p>
                @if (receta.Firma is not null)
                {
                    <p class="mt-2 font-semibold text-ink">@receta.Firma.NombreCompleto</p>
                    @if (!string.IsNullOrWhiteSpace(receta.Firma.Especialidad))
                    {
                        <p class="text-sm text-ink">@receta.Firma.Especialidad</p>
                    }
                    @if (receta.Firma.MatriculaMostrada is not null)
                    {
                        <p class="text-sm tabular-nums text-ink">@receta.Firma.MatriculaMostrada</p>
                    }
                }
                else
                {
                    <p class="mt-2 text-sm text-muted">Sin datos del profesional.</p>
                }
            </div>
        </div>

        <p class="mt-8 border-t border-border pt-3 text-xs text-muted">
            Generada en ChronoSalud el <span class="tabular-nums">@Model.GeneradaElTexto</span>.
        </p>
    </article>
}
