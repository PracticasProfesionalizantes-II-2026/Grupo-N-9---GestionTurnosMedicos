@model RecetasIndexViewModel
@{
    ViewData["Title"] = "Recetas";
}

<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-ink">Recetas</h1>
        @if (Model.NombrePaciente is not null)
        {
            <p class="mt-1 text-sm text-muted">Paciente: <span class="font-medium text-ink">@Model.NombrePaciente</span></p>
        }
        else
        {
            <p class="mt-1 text-sm text-muted">Recetas emitidas por los profesionales.</p>
        }
    </div>
    <div class="flex flex-wrap items-center justify-end gap-x-5 gap-y-3">
        @if (Model.IdPaciente is not null && !Model.HuboError)
        {
            <p class="text-sm text-muted">
                <span class="font-semibold tabular-nums text-ink">@Model.Recetas.Count</span>
                @(Model.Recetas.Count == 1 ? "receta" : "recetas")
                @if (Model.Recetas.Count > 0)
                {
                    <span>· @Model.Vigentes vigentes</span>
                }
            </p>
        }
        @if (Model.PuedeCrear)
        {
            <a asp-action="Crear" asp-route-paciente="@Model.IdPaciente"
               class="boton boton-primario">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="M12 5v14" />
                </svg>
                Nueva receta
            </a>
        }
    </div>
</div>

@if (Model.PuedeElegirPaciente)
{
    <form method="get" asp-action="Index"
          class="mt-6 flex flex-wrap items-end gap-4 tarjeta p-5">
        <div class="w-full sm:w-auto sm:min-w-64">
            <label for="paciente" class="block text-sm font-medium text-ink">Paciente</label>
            <select id="paciente" name="paciente" asp-items="Model.Pacientes"
                    class="campo mt-1.5">
                <option value="">Elegí un paciente</option>
            </select>
        </div>
        <button type="submit"
                class="boton boton-primario">
            Ver recetas
        </button>
    </form>
}

@if (Model.Aviso is not null)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "info", Tono = TonoVacio.Aviso, Nivel = 2, Titulo = "No podemos mostrarte recetas", Ayuda = Model.Aviso }' />
    </div>
}
else if (Model.HuboError)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudieron cargar las recetas", Ayuda = Model.Error, Accion = new EnlaceViewModel { Controlador = "Recetas", Accion = "Index", Ruta = Model.IdPaciente is null ? null : new Dictionary<string, string> { ["paciente"] = $"{Model.IdPaciente}" }, Descripcion = "Reintentar" } }' />
    </div>
}
else if (Model.SinPacienteElegido)
{
    <div class="tarjeta mt-6">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "personas", Nivel = 2, Titulo = "Elegí un paciente", Ayuda = "Las recetas se guardan por paciente, así que primero elegí de quién querés verlas." }' />
    </div>
}
else if (Model.Recetas.Count == 0)
{
    <div class="tarjeta mt-6">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "pastilla", Nivel = 2, Titulo = "No hay recetas", Ayuda = "Este paciente todavía no tiene recetas emitidas.", Accion = Model.PuedeCrear ? new EnlaceViewModel { Controlador = "Recetas", Accion = "Crear", Ruta = Model.IdPaciente is null ? null : new Dictionary<string, string> { ["paciente"] = $"{Model.IdPaciente}" }, Descripcion = "Nueva receta" } : null }' />
    </div>
}
else
{
    <div class="mt-6 overflow-hidden tarjeta">
        <ul>
            @{ var fila = 0; }
            @foreach (var receta in Model.Recetas)
            {
                <li class="fila-animada relative flex items-start gap-4 border-b border-border px-5 py-4 last:border-0 hover:bg-primary-soft/50"
                    style="animation-delay: @(Math.Min(fila++, 12) * 40)ms">
                    <span aria-hidden="true"
                          class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full circulo-icono">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z" />
                            <path d="m8.5 8.5 7 7" />
                        </svg>
                    </span>

                    <span class="min-w-0 flex-1">
                        <a asp-action="Detalle" asp-route-id="@receta.IdReceta" asp-route-paciente="@Model.IdPaciente"
                           class="block rounded-badge font-medium text-ink after:absolute after:inset-0 hover:text-primary">
                            Receta #@receta.IdReceta
                            <span class="sr-only">— ver detalle</span>
                        </a>
                        <span class="mt-0.5 block text-sm text-muted">
                            Emitida el <span class="tabular-nums">@receta.FechaCorta</span>
                            <span aria-hidden="true"> · </span>
                            vigente hasta <span class="tabular-nums">@receta.VigenciaCorta</span>
                        </span>
                        @if (receta.Medicamentos.Count > 0)
                        {
                            <span class="mt-1 block truncate text-sm text-ink">
                                @string.Join(", ", receta.Medicamentos.Select(m => m.NombreMostrado))
                            </span>
                        }
                    </span>

                    <partial name="_Chip"
                             model='new ChipViewModel { Texto = receta.Vigente ? "vigente" : "vencida", Tono = receta.Vigente ? TonoChip.Exito : TonoChip.Neutro, Capitalizar = true }' />
                </li>
            }
        </ul>
    </div>
}
