@model RecetaDetalleViewModel
@{
    ViewData["Title"] = Model.Receta is null ? "Receta" : $"Receta #{Model.Receta.IdReceta}";
}

<a asp-action="Index" asp-route-paciente="@Model.IdPaciente"
   class="boton-texto text-muted hover:text-primary">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    Volver a recetas
</a>

@if (Model.HuboError || Model.Receta is null)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudo cargar la receta", Ayuda = Model.Error }' />
    </div>
}
else
{
    var receta = Model.Receta;

    <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-ink">Receta #@receta.IdReceta</h1>
            @if (Model.NombrePaciente is not null)
            {
                <p class="mt-1 text-sm text-muted">Paciente: <span class="font-medium text-ink">@Model.NombrePaciente</span></p>
            }
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <partial name="_Chip"
                     model='new ChipViewModel { Texto = receta.Vigente ? "vigente" : "vencida", Tono = receta.Vigente ? TonoChip.Exito : TonoChip.Neutro, Capitalizar = true }' />
            @if (Model.PuedeEditar)
            {
                <a asp-action="Editar" asp-route-id="@receta.IdReceta" asp-route-paciente="@Model.IdPaciente"
                   class="boton boton-secundario">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
                        <path d="m15 5 4 4" />
                    </svg>
                    Editar
                </a>
            }
            <a asp-action="Imprimir" asp-route-id="@receta.IdReceta" asp-route-paciente="@Model.IdPaciente"
               class="boton boton-secundario">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                    <path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6" />
                    <rect x="6" y="14" width="12" height="8" rx="1" />
                </svg>
                Imprimir
            </a>
        </div>
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-3">
        <div class="tarjeta p-6">
            <h2 class="text-base font-semibold text-ink">Emisión</h2>
            <dl class="mt-4 space-y-4">
                <div>
                    <dt class="text-sm text-muted">Emitida</dt>
                    <dd class="mt-0.5 capitalize text-ink">@receta.FechaLarga</dd>
                </div>
                <div>
                    <dt class="text-sm text-muted">Vigente hasta</dt>
                    <dd class="mt-0.5 capitalize text-ink">@receta.VigenciaLarga</dd>
                </div>
                <div>
                    <dt class="text-sm text-muted">Firmada por</dt>
                    @if (receta.Firma is not null)
                    {
                        <dd class="mt-0.5 text-ink">
                            <span class="font-medium">@receta.Firma.NombreCompleto</span>
                            @if (receta.Firma.Detalle is not null)
                            {
                                <span class="block text-sm text-muted">@receta.Firma.Detalle</span>
                            }
                        </dd>
                    }
                    else
                    {
                        <dd class="mt-0.5 text-sm text-muted">Sin datos del profesional.</dd>
                    }
                </div>
                @if (receta.IdTurno is not null)
                {
                    <div>
                        <dt class="text-sm text-muted">Turno</dt>
                        <dd class="mt-0.5 text-ink">
                            @if (Model.EnlaceAlTurno)
                            {
                                <a asp-controller="Turnos" asp-action="Detalle" asp-route-id="@receta.IdTurno"
                                   class="underline hover:text-primary">Turno #@receta.IdTurno</a>
                            }
                            else
                            {
                                <span>Turno #@receta.IdTurno</span>
                            }
                        </dd>
                    </div>
                }
            </dl>
        </div>

        <div class="tarjeta p-6 lg:col-span-2">
            <h2 class="text-base font-semibold text-ink">Detalles</h2>
            @if (receta.TieneDetalles)
            {
                <p class="mt-3 whitespace-pre-line text-ink">@receta.Detalles</p>
            }
            else
            {
                <p class="mt-3 text-sm text-muted">La receta no tiene detalles cargados.</p>
            }
        </div>
    </div>

    <div class="mt-4 overflow-hidden tarjeta">
        <header class="tarjeta-encabezado px-6 py-4">
            <h2 class="text-base font-semibold text-primary-deep">
                Medicamentos (@receta.Medicamentos.Count)
            </h2>
        </header>

        @if (receta.Medicamentos.Count == 0)
        {
            <p class="px-6 py-8 text-center text-sm text-muted">La receta no tiene medicamentos cargados.</p>
        }
        else
        {
            <ul>
                @foreach (var medicamento in receta.Medicamentos)
                {
                    <li class="border-b border-border px-6 py-4 last:border-0">
                        <p class="font-medium text-ink">
                            @medicamento.DescripcionCompleta
                            @if (medicamento.EsOtro)
                            {
                                <span class="ml-2 inline-block align-middle"><partial name="_Chip" model='new ChipViewModel { Texto = "Fuera del vademécum" }' /></span>
                            }
                        </p>
                        <dl class="mt-2 grid gap-3 sm:grid-cols-3">
                            <div>
                                <dt class="text-xs font-medium text-muted">Dosis</dt>
                                <dd class="mt-0.5 text-sm text-ink">@medicamento.Dosis</dd>
                            </div>
                            <div>
                                <dt class="text-xs font-medium text-muted">Frecuencia</dt>
                                <dd class="mt-0.5 text-sm text-ink">@medicamento.Frecuencia</dd>
                            </div>
                            <div>
                                <dt class="text-xs font-medium text-muted">Duración</dt>
                                <dd class="mt-0.5 text-sm text-ink">
                                    @(string.IsNullOrWhiteSpace(medicamento.Duracion) ? "Sin especificar" : medicamento.Duracion)
                                </dd>
                            </div>
                        </dl>
                        @if (!string.IsNullOrWhiteSpace(medicamento.IndicacionesMostradas))
                        {
                            <p class="mt-3 whitespace-pre-line text-sm text-muted">
                                <span class="font-medium text-ink">Indicaciones:</span> @medicamento.IndicacionesMostradas
                            </p>
                        }
                    </li>
                }
            </ul>
        }
    </div>
}
