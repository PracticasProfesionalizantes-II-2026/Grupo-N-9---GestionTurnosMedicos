@model RecetaDetalleViewModel
@{
    ViewData["Title"] = Model.Receta is null ? "Receta" : $"Receta #{Model.Receta.IdReceta}";
}

<a asp-action="Index" asp-route-paciente="@Model.IdPaciente"
   class="inline-flex items-center gap-1.5 rounded-badge text-sm font-medium text-muted hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    Volver a recetas
</a>

@if (Model.HuboError || Model.Receta is null)
{
    <div class="mt-8 rounded-card border border-border bg-surface p-10 text-center">
        <svg class="mx-auto h-8 w-8 text-status-cancelado" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
        </svg>
        <h2 class="mt-4 text-base font-semibold text-ink">No se pudo cargar la receta</h2>
        <p class="mx-auto mt-1 max-w-sm text-sm text-muted">@Model.Error</p>
    </div>
}
else
{
    var receta = Model.Receta;

    <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-ink">Receta #@receta.IdReceta</h1>
            @if (Model.NombrePaciente is not null)
            {
                <p class="mt-1 text-sm text-muted">Paciente: <span class="font-medium text-ink">@Model.NombrePaciente</span></p>
            }
        </div>
        <span class="rounded-badge px-3 py-1 text-xs font-semibold @(receta.Vigente ? "bg-status-confirmado/10 text-status-confirmado" : "bg-canvas text-muted")">
            @(receta.Vigente ? "vigente" : "vencida")
        </span>
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-3">
        <div class="rounded-card border border-border bg-surface p-6">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Vigencia</h2>
            <dl class="mt-4 space-y-4">
                <div>
                    <dt class="text-sm text-muted">Emitida</dt>
                    <dd class="mt-0.5 capitalize text-ink">@receta.FechaLarga</dd>
                </div>
                <div>
                    <dt class="text-sm text-muted">Vigente hasta</dt>
                    <dd class="mt-0.5 capitalize text-ink">@receta.VigenciaLarga</dd>
                </div>
            </dl>
        </div>

        <div class="rounded-card border border-border bg-surface p-6 lg:col-span-2">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Detalles</h2>
            @if (receta.TieneDetalles)
            {
                <p class="mt-3 whitespace-pre-line text-ink">@receta.Detalles</p>
            }
            else
            {
                <p class="mt-3 text-sm text-muted">La receta no tiene detalles cargados.</p>
            }
        </div>
    </div>

    <div class="mt-4 overflow-hidden rounded-card border border-border bg-surface">
        <header class="border-b border-border px-6 py-4">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">
                Medicamentos (@receta.Medicamentos.Count)
            </h2>
        </header>

        @if (receta.Medicamentos.Count == 0)
        {
            <p class="px-6 py-8 text-center text-sm text-muted">La receta no tiene medicamentos cargados.</p>
        }
        else
        {
            <ul>
                @foreach (var medicamento in receta.Medicamentos)
                {
                    <li class="border-b border-border px-6 py-4 last:border-0">
                        <p class="font-medium text-ink">@medicamento.NombreMostrado</p>
                        <dl class="mt-2 grid gap-3 sm:grid-cols-3">
                            <div>
                                <dt class="text-xs uppercase tracking-wide text-muted">Dosis</dt>
                                <dd class="mt-0.5 text-sm text-ink">@medicamento.Dosis</dd>
                            </div>
                            <div>
                                <dt class="text-xs uppercase tracking-wide text-muted">Frecuencia</dt>
                                <dd class="mt-0.5 text-sm text-ink">@medicamento.Frecuencia</dd>
                            </div>
                            <div>
                                <dt class="text-xs uppercase tracking-wide text-muted">Duración</dt>
                                <dd class="mt-0.5 text-sm text-ink">
                                    @(string.IsNullOrWhiteSpace(medicamento.Duracion) ? "Sin especificar" : medicamento.Duracion)
                                </dd>
                            </div>
                        </dl>
                        @if (!string.IsNullOrWhiteSpace(medicamento.Indicaciones))
                        {
                            <p class="mt-3 whitespace-pre-line text-sm text-muted">
                                <span class="font-medium text-ink">Indicaciones:</span> @medicamento.Indicaciones
                            </p>
                        }
                    </li>
                }
            </ul>
        }
    </div>
}
