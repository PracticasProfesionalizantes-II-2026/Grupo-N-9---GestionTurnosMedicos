@model RecetaDetalleViewModel
@{
    ViewData["Title"] = Model.Receta is null ? "Receta" : $"Receta #{Model.Receta.IdReceta}";
}

<a asp-action="Index" asp-route-paciente="@Model.IdPaciente"
   class="boton-texto area-tactil text-muted hover:text-primary">
    <icono nombre="volver" class="h-4 w-4" />
    Volver a recetas
</a>

@if (Model.HuboError || Model.Receta is null)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudo cargar la receta", Ayuda = Model.Error }' />
    </div>
}
else
{
    var receta = Model.Receta;

    <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
        <div class="flex min-w-0 items-center gap-4">
            <span aria-hidden="true" class="circulo-icono flex size-12 shrink-0 items-center justify-center rounded-full">
                <icono nombre="pastilla" class="size-6" />
            </span>
            <div class="min-w-0">
                <h1 class="text-2xl font-bold tracking-tight text-ink">Receta #@receta.IdReceta</h1>
                @if (Model.NombrePaciente is not null)
                {
                    <p class="mt-1 text-sm text-muted">Paciente: <span class="font-medium text-ink">@Model.NombrePaciente</span></p>
                }
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            @* Cuánto le queda, con palabras. En ámbar si vence en una semana o menos. *@
            <partial name="_Chip"
                     model='new ChipViewModel { Texto = receta.Vigente ? receta.TextoVigencia : "Vencida", Tono = !receta.Vigente ? TonoChip.Neutro : receta.VencePronto ? TonoChip.Aviso : TonoChip.Exito }' />
            @if (Model.PuedeEditar)
            {
                <a asp-action="Editar" asp-route-id="@receta.IdReceta" asp-route-paciente="@Model.IdPaciente"
                   class="boton boton-secundario">
                    <icono nombre="lapiz" class="h-4 w-4" />
                    Editar
                </a>
            }
            <a asp-action="Imprimir" asp-route-id="@receta.IdReceta" asp-route-paciente="@Model.IdPaciente"
               class="boton boton-secundario">
                <icono nombre="imprimir" class="h-4 w-4" />
                Imprimir
            </a>
        </div>
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-3">
        <div class="tarjeta p-5 sm:p-6">
            <h2 class="text-base font-semibold text-ink">Emisión</h2>
            <dl class="lista-datos mt-4">
                <div>
                    <dt><icono nombre="calendario" /> Emitida</dt>
                    <dd class="first-letter:uppercase">@receta.FechaLarga</dd>
                </div>
                <div>
                    <dt><icono nombre="reloj" /> Vigente hasta</dt>
                    <dd class="first-letter:uppercase">@receta.VigenciaLarga</dd>
                </div>
                <div>
                    <dt><icono nombre="estetoscopio" /> Firmada por</dt>
                    @if (receta.Firma is not null)
                    {
                        <dd>
                            @receta.Firma.NombreCompleto
                            @if (receta.Firma.Detalle is not null)
                            {
                                <span class="block font-normal text-muted">@receta.Firma.Detalle</span>
                            }
                        </dd>
                    }
                    else
                    {
                        <dd class="sin-dato">Sin datos del profesional.</dd>
                    }
                </div>
                @if (receta.IdTurno is not null)
                {
                    <div>
                        <dt><icono nombre="calendario-flecha" /> Turno</dt>
                        <dd>
                            @if (Model.EnlaceAlTurno)
                            {
                                <a asp-controller="Turnos" asp-action="Detalle" asp-route-id="@receta.IdTurno"
                                   class="underline hover:text-primary">Turno #@receta.IdTurno</a>
                            }
                            else
                            {
                                <span>Turno #@receta.IdTurno</span>
                            }
                        </dd>
                    </div>
                }
            </dl>
        </div>

        <div class="tarjeta p-5 sm:p-6 lg:col-span-2">
            <h2 class="text-base font-semibold text-ink">Detalles</h2>
            @if (receta.TieneDetalles)
            {
                <p class="mt-3 whitespace-pre-line wrap-break-word text-ink">@receta.Detalles</p>
            }
            else
            {
                <p class="mt-3 text-sm text-muted">La receta no tiene detalles cargados.</p>
            }
        </div>
    </div>

    <div class="mt-4 overflow-hidden tarjeta">
        <header class="tarjeta-encabezado px-6 py-4">
            <h2 class="text-base font-semibold text-primary-deep">
                Medicamentos <span class="tabular-nums">(@receta.Medicamentos.Count)</span>
            </h2>
        </header>

        @if (receta.Medicamentos.Count == 0)
        {
            <partial name="_EstadoVacio"
                     model='new EstadoVacioViewModel { Icono = "pastilla", Titulo = "La receta no tiene medicamentos cargados", Ayuda = Model.PuedeEditar ? "Podés sumarlos editando la receta." : null }' />
        }
        else
        {
            <ul>
                @{ var fila = 0; }
                @foreach (var medicamento in receta.Medicamentos)
                {
                    <li class="fila-animada flex items-start gap-4 border-b border-border px-5 py-4 last:border-0 sm:px-6"
                        style="--i: @(fila++)">
                        <span aria-hidden="true" class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary-deep">
                            <icono nombre="pastilla" class="size-4" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <p class="font-medium wrap-break-word text-ink">
                                @medicamento.DescripcionCompleta
                                @if (medicamento.EsOtro)
                                {
                                    <span class="ml-2 inline-block align-middle"><partial name="_Chip" model='new ChipViewModel { Texto = "Fuera del vademécum" }' /></span>
                                }
                            </p>
                            @* Dosis, frecuencia y duración como etiquetas cortas, cada
                               una con su rótulo adelante, que se leen de un vistazo. *@
                            <dl class="mt-2 flex flex-wrap gap-2 text-sm">
                                <div class="rounded-badge border border-border bg-surface px-2 py-1">
                                    <dt class="inline text-muted">Dosis:</dt>
                                    <dd class="inline font-medium text-ink">@medicamento.Dosis</dd>
                                </div>
                                <div class="rounded-badge border border-border bg-surface px-2 py-1">
                                    <dt class="inline text-muted">Frecuencia:</dt>
                                    <dd class="inline font-medium text-ink">@medicamento.Frecuencia</dd>
                                </div>
                                <div class="rounded-badge border border-border bg-surface px-2 py-1">
                                    <dt class="inline text-muted">Duración:</dt>
                                    <dd class="inline font-medium text-ink">
                                        @(string.IsNullOrWhiteSpace(medicamento.Duracion) ? "Sin especificar" : medicamento.Duracion)
                                    </dd>
                                </div>
                            </dl>
                            @if (!string.IsNullOrWhiteSpace(medicamento.IndicacionesMostradas))
                            {
                                <p class="mt-3 whitespace-pre-line wrap-break-word text-sm text-muted">
                                    <span class="font-medium text-ink">Indicaciones:</span> @medicamento.IndicacionesMostradas
                                </p>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
}
