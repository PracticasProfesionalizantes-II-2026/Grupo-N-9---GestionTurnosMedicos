@model RecetaCrearViewModel
@{
    ViewData["Title"] = "Nueva receta";
    var erroresGenerales = ViewData.ModelState[string.Empty]?.Errors;
    const string claseCampo = "mt-1.5 w-full rounded-input border border-primary-line bg-white px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary-soft";
    const string claseError = "mt-1 block text-xs text-status-cancelado";
}

<a asp-action="Index" asp-route-paciente="@Model.IdPaciente"
   class="inline-flex items-center gap-1.5 rounded-badge text-sm font-medium text-muted hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
    </svg>
    Volver a recetas
</a>

<div class="mt-6 max-w-3xl">
    <h1 class="text-2xl font-bold tracking-tight text-ink">Nueva receta</h1>
    <p class="mt-1 text-sm text-muted">
        La receta queda a tu nombre: la API registra como emisor al doctor que está logueado.
    </p>

    <div class="mt-6 rounded-card border border-border bg-surface p-8">
        @if (erroresGenerales is { Count: > 0 })
        {
            <div class="mb-6 flex items-start gap-3 rounded-input border border-status-cancelado/40 bg-status-cancelado/10 px-4 py-3 text-sm text-status-cancelado">
                <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
                    <path d="M12 9v4" />
                    <path d="M12 17h.01" />
                </svg>
                <span>
                    @foreach (var error in erroresGenerales)
                    {
                        <span class="block">@error.ErrorMessage</span>
                    }
                </span>
            </div>
        }

        <form asp-action="Crear" method="post" novalidate>
            <div class="grid gap-5 sm:grid-cols-3">
                <div class="sm:col-span-3">
                    <label asp-for="IdPaciente" class="block text-sm font-medium text-ink"></label>
                    <select asp-for="IdPaciente" asp-items="Model.Pacientes" class="@claseCampo">
                        <option value="">Elegí un paciente</option>
                    </select>
                    <span asp-validation-for="IdPaciente" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Fecha" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Fecha" type="date" class="@claseCampo tabular-nums" />
                    <span asp-validation-for="Fecha" class="@claseError"></span>
                </div>

                <div>
                    <label asp-for="Vigencia" class="block text-sm font-medium text-ink"></label>
                    <input asp-for="Vigencia" type="date" class="@claseCampo tabular-nums" />
                    <span asp-validation-for="Vigencia" class="@claseError"></span>
                </div>
            </div>

            <fieldset class="mt-8">
                <legend class="text-sm font-semibold uppercase tracking-wide text-muted">Medicamentos</legend>
                <p class="mt-1 text-xs text-muted">
                    Hace falta al menos uno. Dejá vacías las filas que no uses.
                </p>

                @for (var i = 0; i < Model.Medicamentos.Count; i++)
                {
                    <div class="mt-4 rounded-input border border-border p-4">
                        <div class="grid gap-4 sm:grid-cols-3">
                            <div>
                                <label asp-for="Medicamentos[i].IdMedicamento" class="block text-sm font-medium text-ink"></label>
                                <select asp-for="Medicamentos[i].IdMedicamento" asp-items="Model.Vademecum" class="@claseCampo">
                                    <option value="">Ninguno</option>
                                </select>
                                <span asp-validation-for="Medicamentos[i].IdMedicamento" class="@claseError"></span>
                            </div>
                            <div>
                                <label asp-for="Medicamentos[i].Dosis" class="block text-sm font-medium text-ink"></label>
                                <input asp-for="Medicamentos[i].Dosis" placeholder="500 mg" class="@claseCampo" />
                                <span asp-validation-for="Medicamentos[i].Dosis" class="@claseError"></span>
                            </div>
                            <div>
                                <label asp-for="Medicamentos[i].Frecuencia" class="block text-sm font-medium text-ink"></label>
                                <input asp-for="Medicamentos[i].Frecuencia" placeholder="Cada 8 horas" class="@claseCampo" />
                                <span asp-validation-for="Medicamentos[i].Frecuencia" class="@claseError"></span>
                            </div>
                            <div>
                                <label asp-for="Medicamentos[i].Duracion" class="block text-sm font-medium text-ink"></label>
                                <input asp-for="Medicamentos[i].Duracion" placeholder="7 días" class="@claseCampo" />
                                <span asp-validation-for="Medicamentos[i].Duracion" class="@claseError"></span>
                            </div>
                            <div class="sm:col-span-2">
                                <label asp-for="Medicamentos[i].Indicaciones" class="block text-sm font-medium text-ink"></label>
                                <input asp-for="Medicamentos[i].Indicaciones" placeholder="Opcional" class="@claseCampo" />
                                <span asp-validation-for="Medicamentos[i].Indicaciones" class="@claseError"></span>
                            </div>
                        </div>
                    </div>
                }
            </fieldset>

            <div class="mt-6">
                <label asp-for="Detalles" class="block text-sm font-medium text-ink"></label>
                <textarea asp-for="Detalles" rows="3" placeholder="Opcional" class="@claseCampo"></textarea>
                <span asp-validation-for="Detalles" class="@claseError"></span>
            </div>

            <div class="mt-7 flex flex-wrap items-center gap-3">
                <button type="submit"
                        class="rounded-input bg-primary px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-hover focus:outline-none focus:ring-2 focus:ring-primary-soft">
                    Emitir receta
                </button>
                <a asp-action="Index" asp-route-paciente="@Model.IdPaciente"
                   class="rounded-input border border-border px-4 py-2.5 text-sm font-semibold text-muted hover:bg-canvas hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
