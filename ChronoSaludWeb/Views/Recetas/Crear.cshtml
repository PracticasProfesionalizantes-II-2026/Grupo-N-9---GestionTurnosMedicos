@model RecetaCrearViewModel
@{
    // El mismo formulario sirve para una receta nueva, para la receta de un
    // turno y para editar una que ya existe.
    var titulo = Model.EsEdicion ? $"Editar receta #{Model.IdReceta}" : "Nueva receta";
    ViewData["Title"] = titulo;
    var erroresGenerales = ViewData.ModelState[string.Empty]?.Errors;
    const string claseCampo = "campo mt-1.5";
    const string claseError = "mt-1 block text-xs text-status-cancelado";
    const string claseBotonFila = "boton boton-secundario size-11 p-0";

    // A dónde vuelven "Volver" y "Cancelar": al detalle si se edita, al turno
    // si se emite desde un turno, y si no, a la lista de recetas.
    var vuelveAlTurno = !Model.EsEdicion && Model.IdTurno is not null;
    var textoVolver = Model.EsEdicion ? "Volver a la receta" : vuelveAlTurno ? "Volver al turno" : "Volver a recetas";
}

@if (Model.EsEdicion)
{
    <a asp-action="Detalle" asp-route-id="@Model.IdReceta" asp-route-paciente="@Model.IdPaciente"
       class="boton-texto area-tactil text-muted hover:text-primary">
        <icono nombre="volver" class="h-4 w-4" />
        @textoVolver
    </a>
}
else if (vuelveAlTurno)
{
    <a asp-controller="Turnos" asp-action="Detalle" asp-route-id="@Model.IdTurno"
       class="boton-texto area-tactil text-muted hover:text-primary">
        <icono nombre="volver" class="h-4 w-4" />
        @textoVolver
    </a>
}
else
{
    <a asp-action="Index" asp-route-paciente="@Model.IdPaciente"
       class="boton-texto area-tactil text-muted hover:text-primary">
        <icono nombre="volver" class="h-4 w-4" />
        @textoVolver
    </a>
}

<div class="mt-6 max-w-3xl">
    <h1 class="text-2xl font-bold tracking-tight text-ink">@titulo</h1>
    <p class="mt-1 text-sm text-muted">
        @if (Model.EsEdicion)
        {
            <text>Solo la puede editar quien la firmó. Al guardar, los medicamentos toman los datos que tienen hoy en el vademécum.</text>
        }
        else
        {
            <text>La receta queda a tu nombre: figurás vos como el doctor que la emite.</text>
        }
    </p>

    @if (Model.Turno is not null)
    {
        <p class="mt-4 flex items-start gap-3 rounded-input border border-border bg-surface px-4 py-3 text-sm text-ink">
            <icono nombre="calendario" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
            <span>Receta del <span class="font-medium tabular-nums">@Model.Turno.Descripcion</span>. Queda vinculada a ese turno.</span>
        </p>
    }

    @if (Model.IdPaciente is null)
    {
        @* Paso 1: elegir el paciente. El formulario aparece recién con el
           paciente elegido, así el buscador (que recarga la página) no pisa
           nada de lo que se escribió. *@
        <div class="mt-6 tarjeta p-5 sm:p-8">
            <p class="mb-5 text-sm text-muted">Primero elegí a quién le emitís la receta.</p>
            @if (Model.ElegirPaciente is not null)
            {
                <partial name="_ElegirPaciente" model="Model.ElegirPaciente" />
            }
            else
            {
                <p class="text-sm text-status-cancelado">No se pudo cargar el buscador de pacientes. Probá de nuevo en un rato.</p>
            }
        </div>
    }
    else
    {
        <div class="mt-6 tarjeta p-5 sm:p-8">
            @if (erroresGenerales is { Count: > 0 })
            {
                <div role="alert" class="aviso aviso-error mb-6">
                    <icono nombre="alerta" class="mt-0.5 h-4 w-4 shrink-0" />
                    <span>
                        @foreach (var error in erroresGenerales)
                        {
                            <span class="block">@error.ErrorMessage</span>
                        }
                    </span>
                </div>
            }

            <form asp-action="@(Model.EsEdicion ? "Editar" : "Crear")" method="post" novalidate data-avisar-cambios>
                @* Enter en un campo de texto dispara el primer submit del formulario:
                   sin este, sería el "+" de la primera fila en vez de emitir. *@
                <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">@(Model.EsEdicion ? "Guardar cambios" : "Emitir receta")</button>

                @* Viajan con "+" y "−" también, así la pantalla sigue en el mismo modo. *@
                <input type="hidden" asp-for="IdReceta" />
                <input type="hidden" asp-for="IdTurno" />

                <div class="grid gap-5 sm:grid-cols-2">
                    @* El paciente ya está elegido: va oculto y se muestra con sus datos. *@
                    <div class="sm:col-span-2">
                        <input type="hidden" asp-for="IdPaciente" />
                        @if (Model.ElegirPaciente is not null)
                        {
                            <partial name="_ElegirPaciente" model="Model.ElegirPaciente" />
                        }
                        else
                        {
                            <p class="block text-sm font-medium text-ink">Paciente</p>
                            <p class="mt-0.5 text-ink">Paciente #@Model.IdPaciente</p>
                        }
                    </div>

                    <div>
                        <label asp-for="Fecha" class="block text-sm font-medium text-ink"></label>
                        <input asp-for="Fecha" type="date" class="@claseCampo tabular-nums" />
                        <span asp-validation-for="Fecha" class="@claseError"></span>
                    </div>

                    <div>
                        <label asp-for="Vigencia" class="block text-sm font-medium text-ink"></label>
                        <input asp-for="Vigencia" type="date" class="@claseCampo tabular-nums" />
                        <span asp-validation-for="Vigencia" class="@claseError"></span>
                    </div>
                </div>

                <fieldset class="mt-8">
                    <legend class="text-base font-semibold text-ink">Medicamentos</legend>
                    <p class="mt-1 text-xs text-muted">
                        Hace falta al menos uno. Con «+» agregás una fila debajo y con «−» la quitás
                        (hasta @RecetaCrearViewModel.MaximoDeFilas); las que queden vacías se ignoran.
                    </p>

                    @for (var i = 0; i < Model.Medicamentos.Count; i++)
                    {
                        <div id="fila-@i" class="group/fila mt-4 flex scroll-mt-6 items-start gap-3 rounded-input border border-contorno-suave bg-surface p-4">
                            <div class="grid min-w-0 flex-1 gap-4 sm:grid-cols-3">
                                @* El número de la fila, para ubicarse con varias. *@
                                <p class="flex items-center gap-2 text-xs font-semibold text-muted sm:col-span-3">
                                    <icono nombre="pastilla" class="size-4 text-primary" />
                                    Medicamento <span class="tabular-nums">@(i + 1)</span>
                                </p>
                                <div class="sm:col-span-3">
                                    <label asp-for="Medicamentos[i].IdMedicamento" class="block text-sm font-medium text-ink"></label>
                                    <select asp-for="Medicamentos[i].IdMedicamento" asp-items="Model.Vademecum" class="@claseCampo">
                                        <option value="">Ninguno</option>
                                        @if (Model.OtroDisponible)
                                        {
                                            <option value="@RecetaCrearViewModel.IdOtro">Otro…</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Medicamentos[i].IdMedicamento" class="@claseError"></span>

                                    @if (Model.OtroDisponible)
                                    {
                                        @* Sin JavaScript: el cuadro aparece mientras la opción
                                           "Otro…" (value -1) esté elegida en esta fila. *@
                                        <div class="mt-3 hidden group-has-[option[value='-1']:checked]/fila:block">
                                            <label asp-for="Medicamentos[i].NombreOtro" class="block text-sm font-medium text-ink"></label>
                                            <input asp-for="Medicamentos[i].NombreOtro" maxlength="150"
                                                   placeholder="Nombre, concentración y presentación…" autocomplete="off" class="@claseCampo" />
                                            <span asp-validation-for="Medicamentos[i].NombreOtro" class="@claseError"></span>
                                        </div>
                                    }
                                </div>
                                <div>
                                    <label asp-for="Medicamentos[i].Dosis" class="block text-sm font-medium text-ink"></label>
                                    <input asp-for="Medicamentos[i].Dosis" placeholder="500 mg" autocomplete="off" class="@claseCampo" />
                                    <span asp-validation-for="Medicamentos[i].Dosis" class="@claseError"></span>
                                </div>
                                <div>
                                    <label asp-for="Medicamentos[i].Frecuencia" class="block text-sm font-medium text-ink"></label>
                                    <input asp-for="Medicamentos[i].Frecuencia" placeholder="Cada 8 horas" autocomplete="off" class="@claseCampo" />
                                    <span asp-validation-for="Medicamentos[i].Frecuencia" class="@claseError"></span>
                                </div>
                                <div>
                                    <label asp-for="Medicamentos[i].Duracion" class="block text-sm font-medium text-ink"></label>
                                    <input asp-for="Medicamentos[i].Duracion" placeholder="7 días" autocomplete="off" class="@claseCampo" />
                                    <span asp-validation-for="Medicamentos[i].Duracion" class="@claseError"></span>
                                </div>
                                <div class="sm:col-span-3">
                                    <label asp-for="Medicamentos[i].Indicaciones" class="block text-sm font-medium text-ink">Indicaciones <span class="font-normal text-muted">(opcional)</span></label>
                                    <input asp-for="Medicamentos[i].Indicaciones" placeholder="Por ejemplo: tomar después de comer…" autocomplete="off" class="@claseCampo" />
                                    <span asp-validation-for="Medicamentos[i].Indicaciones" class="@claseError"></span>
                                </div>
                            </div>

                            @* Cada botón postea el formulario entero a su acción y vuelve
                               a esta pantalla, anclado en la fila que resulta. *@
                            <div class="flex shrink-0 flex-col gap-2">
                                @if (Model.Medicamentos.Count < RecetaCrearViewModel.MaximoDeFilas)
                                {
                                    <button type="submit" formnovalidate
                                            asp-action="AgregarFila" asp-route-indice="@i" asp-fragment="fila-@(i + 1)"
                                            title="Agregar una fila debajo" aria-label="Agregar una fila debajo de la fila @(i + 1)"
                                            class="@claseBotonFila">
                                        <icono nombre="mas" class="size-5" />
                                    </button>
                                }
                                @if (Model.Medicamentos.Count > RecetaCrearViewModel.MinimoDeFilas)
                                {
                                    <button type="submit" formnovalidate
                                            asp-action="QuitarFila" asp-route-indice="@i" asp-fragment="fila-@(Math.Max(i - 1, 0))"
                                            title="Quitar esta fila" aria-label="Quitar la fila @(i + 1)"
                                            class="@claseBotonFila">
                                        <icono nombre="menos" class="size-5" />
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </fieldset>

                <div class="mt-6">
                    <label asp-for="Detalles" class="block text-sm font-medium text-ink">Detalles <span class="font-normal text-muted">(opcional)</span></label>
                    <textarea asp-for="Detalles" rows="3" placeholder="Indicaciones generales para el paciente o la farmacia…" class="@claseCampo"></textarea>
                    <span asp-validation-for="Detalles" class="@claseError"></span>
                </div>

                <div class="mt-7 flex flex-wrap items-center gap-3">
                    <button type="submit" data-cargando="@(Model.EsEdicion ? "Guardando…" : "Emitiendo…")"
                            class="boton boton-primario">
                        @(Model.EsEdicion ? "Guardar cambios" : "Emitir receta")
                    </button>
                    @if (Model.EsEdicion)
                    {
                        <a asp-action="Detalle" asp-route-id="@Model.IdReceta" asp-route-paciente="@Model.IdPaciente"
                           class="boton boton-secundario">
                            Cancelar
                        </a>
                    }
                    else if (vuelveAlTurno)
                    {
                        <a asp-controller="Turnos" asp-action="Detalle" asp-route-id="@Model.IdTurno"
                           class="boton boton-secundario">
                            Cancelar
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" asp-route-paciente="@Model.IdPaciente"
                           class="boton boton-secundario">
                            Cancelar
                        </a>
                    }
                </div>
            </form>
        </div>
    }
</div>

@* Esta pantalla no participa del fundido entre páginas: «+» y «−» la repintan
   anclada a otra fila, y un fundido encima de ese salto se vería como un
   parpadeo en cada clic. Es CSS, no JavaScript. Para volver a activarlo
   alcanza con borrar esta sección. *@
@section Head {
    <style>
        @@view-transition {
            navigation: none;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
