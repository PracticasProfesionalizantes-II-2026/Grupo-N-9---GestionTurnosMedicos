@model DoctoresIndexViewModel
@inject AuthService Auth
@{
    ViewData["Title"] = "Doctores";
}

<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-ink">Doctores</h1>
        <p class="mt-1 text-sm text-muted">Profesionales activos del sistema.</p>
    </div>
    @if (!Model.HuboError)
    {
        <p class="text-sm text-muted">
            <span class="font-semibold tabular-nums text-ink">@Model.Total</span>
            @(Model.Total == 1 ? "doctor" : "doctores")
        </p>
    }
</div>

@* Las opciones salen de GET /doctores/especialidades. *@
<form method="get" asp-action="Index"
      class="mt-6 flex flex-wrap items-end gap-4 tarjeta p-5">
    <div class="w-full sm:w-auto sm:min-w-56">
        <label for="especialidad" class="block text-sm font-medium text-ink">Especialidad</label>
        <select id="especialidad" name="especialidad" asp-items="Model.Especialidades"
                class="campo mt-1.5 capitalize">
            <option value="">Todas</option>
        </select>
    </div>

    <div class="flex items-center gap-2">
        <button type="submit"
                class="boton boton-primario">
            Filtrar
        </button>
        @if (Model.HayFiltro)
        {
            <a asp-action="Index"
               class="boton boton-secundario">
                Limpiar
            </a>
        }
    </div>
</form>

@if (Model.HuboError)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudieron cargar los doctores", Ayuda = Model.Error, Accion = new EnlaceViewModel { Controlador = "Doctores", Accion = "Index", Descripcion = "Reintentar" } }' />
    </div>
}
else if (Model.Doctores.Count == 0)
{
    <div class="tarjeta mt-6">
        @if (Model.SinResultados)
        {
            <partial name="_EstadoVacio"
                     model='new EstadoVacioViewModel { Icono = "estetoscopio", Nivel = 2, Titulo = "Ningún doctor con esa especialidad", Ayuda = "Probá con otra especialidad.", Accion = new EnlaceViewModel { Controlador = "Doctores", Accion = "Index", Descripcion = "Ver todos" } }' />
        }
        else
        {
            <partial name="_EstadoVacio"
                     model='new EstadoVacioViewModel { Icono = "estetoscopio", Nivel = 2, Titulo = "No hay doctores cargados", Ayuda = "Cuando se registren profesionales van a aparecer en esta lista.", Accion = Auth.EsAdministrador ? new EnlaceViewModel { Controlador = "Admin", Accion = "NuevoDoctor", Descripcion = "Agregar doctor" } : null }' />
        }
    </div>
}
else
{
    <div class="mt-6 overflow-hidden tarjeta">
        <ul>
            @{ var fila = 0; }
            @foreach (var doctor in Model.Doctores)
            {
                <li class="fila-animada relative flex items-center gap-4 border-b border-border px-5 py-4 last:border-0 hover:bg-primary-soft/50"
                    style="animation-delay: @(Math.Min(fila++, 12) * 40)ms">
                    <partial name="_Avatar"
                             model="new AvatarViewModel { Nombre = doctor.Nombre, FotoUrl = doctor.FotoUrl, Tamano = TamanoAvatar.Chico, Tono = TonoAvatar.Terracota }" />
                    <span class="min-w-0 flex-1">
                        <a asp-action="Detalle" asp-route-id="@doctor.IdDoctor"
                           class="block truncate rounded-badge font-medium text-ink after:absolute after:inset-0 hover:text-primary">
                            @doctor.NombreMostrado
                            <span class="sr-only">— ver ficha del doctor</span>
                        </a>
                        @if (doctor.EspecialidadMostrada is not null)
                        {
                            <span class="block truncate text-sm capitalize text-muted">@doctor.EspecialidadMostrada</span>
                        }
                    </span>
                    @if (doctor.SinHorario)
                    {
                        <partial name="_Chip" model='new ChipViewModel { Texto = "Sin horario", Tono = TonoChip.Aviso }' />
                    }
                    @if (doctor.MatriculaMostrada is not null)
                    {
                        <span class="shrink-0 text-sm tabular-nums text-muted">@doctor.MatriculaMostrada</span>
                    }
                </li>
            }
        </ul>
    </div>

    @if (Model.HayMas)
    {
        <p class="mt-3 text-xs text-muted">Mostrando @Model.Doctores.Count de @Model.Total doctores.</p>
    }
}
