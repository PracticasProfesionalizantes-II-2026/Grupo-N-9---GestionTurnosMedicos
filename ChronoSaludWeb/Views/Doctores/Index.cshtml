@model DoctoresIndexViewModel
@{
    ViewData["Title"] = "Doctores";
}

<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-ink">Doctores</h1>
        <p class="mt-1 text-sm text-muted">Profesionales activos del sistema.</p>
    </div>
    @if (!Model.HuboError)
    {
        <p class="text-sm text-muted">
            <span class="font-semibold tabular-nums text-ink">@Model.Total</span>
            @(Model.Total == 1 ? "doctor" : "doctores")
        </p>
    }
</div>

@* Las opciones salen de la propia lista de doctores: la API no tiene un
   endpoint de especialidades. *@
<form method="get" asp-action="Index"
      class="mt-6 flex flex-wrap items-end gap-4 rounded-card border border-border bg-surface p-5">
    <div class="min-w-56">
        <label for="especialidad" class="block text-sm font-medium text-ink">Especialidad</label>
        <select id="especialidad" name="especialidad" asp-items="Model.Especialidades"
                class="mt-1.5 w-full rounded-input border border-primary-line bg-white px-3 py-2 text-sm capitalize text-ink focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary-soft">
            <option value="">Todas</option>
        </select>
    </div>

    <div class="flex items-center gap-2">
        <button type="submit"
                class="rounded-input bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-primary-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft">
            Filtrar
        </button>
        @if (Model.HayFiltro)
        {
            <a asp-action="Index"
               class="rounded-input border border-border px-4 py-2 text-sm font-semibold text-muted hover:bg-canvas hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft">
                Limpiar
            </a>
        }
    </div>
</form>

@if (Model.HuboError)
{
    <div class="mt-8 rounded-card border border-border bg-surface p-10 text-center">
        <svg class="mx-auto h-8 w-8 text-status-cancelado" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
        </svg>
        <h2 class="mt-4 text-base font-semibold text-ink">No se pudieron cargar los doctores</h2>
        <p class="mx-auto mt-1 max-w-sm text-sm text-muted">@Model.Error</p>
        <a asp-action="Index"
           class="mt-6 inline-block rounded-input border border-primary-line px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-soft">
            Reintentar
        </a>
    </div>
}
else if (Model.Doctores.Count == 0)
{
    <div class="mt-6 rounded-card border border-border bg-surface p-10 text-center">
        <svg class="mx-auto h-8 w-8 text-primary-line" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3" />
            <path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4" />
            <circle cx="20" cy="10" r="2" />
        </svg>
        @if (Model.SinResultados)
        {
            <h2 class="mt-4 text-base font-semibold text-ink">Ningún doctor con esa especialidad</h2>
            <p class="mx-auto mt-1 max-w-sm text-sm text-muted">Probá con otra especialidad.</p>
            <a asp-action="Index"
               class="mt-6 inline-block rounded-input border border-primary-line px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-soft">
                Ver todos
            </a>
        }
        else
        {
            <h2 class="mt-4 text-base font-semibold text-ink">No hay doctores cargados</h2>
            <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
                Cuando se registren profesionales van a aparecer en esta lista.
            </p>
        }
    </div>
}
else
{
    <div class="mt-6 overflow-hidden rounded-card border border-border bg-surface">
        <ul>
            @foreach (var doctor in Model.Doctores)
            {
                <li class="relative flex items-center gap-4 border-b border-border px-5 py-4 last:border-0 hover:bg-canvas">
                    <span aria-hidden="true"
                          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent">
                        @doctor.Iniciales
                    </span>
                    <span class="min-w-0 flex-1">
                        <a asp-action="Detalle" asp-route-id="@doctor.IdDoctor"
                           class="block truncate rounded-badge font-medium text-ink after:absolute after:inset-0 hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                            @doctor.NombreMostrado
                            <span class="sr-only">— ver ficha del doctor</span>
                        </a>
                        @if (doctor.EspecialidadMostrada is not null)
                        {
                            <span class="block truncate text-sm capitalize text-muted">@doctor.EspecialidadMostrada</span>
                        }
                    </span>
                    @if (doctor.MatriculaMostrada is not null)
                    {
                        <span class="shrink-0 text-sm tabular-nums text-muted">@doctor.MatriculaMostrada</span>
                    }
                </li>
            }
        </ul>
    </div>

    @if (Model.HayMas)
    {
        <p class="mt-3 text-xs text-muted">Mostrando @Model.Doctores.Count de @Model.Total doctores.</p>
    }
}
