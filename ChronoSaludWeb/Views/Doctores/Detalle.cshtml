@model DoctorDetalleViewModel
@{
    ViewData["Title"] = Model.HuboError ? "Doctor" : Model.NombreCompleto;
}

<a asp-action="Index"
   class="boton-texto area-tactil text-muted hover:text-primary">
    <icono nombre="volver" class="h-4 w-4" />
    Volver a doctores
</a>

@if (Model.HuboError)
{
    <div class="tarjeta mt-8">
        <partial name="_EstadoVacio"
                 model='new EstadoVacioViewModel { Icono = "alerta", Tono = TonoVacio.Error, Nivel = 2, Titulo = "No se pudo cargar el doctor", Ayuda = Model.Error, Accion = new EnlaceViewModel { Controlador = "Doctores", Accion = "Detalle", Ruta = new Dictionary<string, string> { ["id"] = $"{Model.IdDoctor}" }, Descripcion = "Reintentar" } }' />
    </div>
}
else
{
    @* Encabezado con la foto, el nombre y la especialidad como chip. *@
    <div class="mt-6 tarjeta tarjeta-hero flex flex-wrap items-center gap-4 p-5 sm:p-6">
        <partial name="_Avatar"
                 model='new AvatarViewModel { Nombre = $"{Model.Nombre} {Model.Apellido}", FotoUrl = Model.FotoUrl, Tamano = TamanoAvatar.Grande, Tono = TonoAvatar.Terracota }' />
        <div class="min-w-0 flex-1">
            <h1 class="text-2xl font-bold tracking-tight wrap-break-word text-ink">@Model.NombreCompleto</h1>
            <p class="mt-1.5">
                @if (string.IsNullOrWhiteSpace(Model.Especialidad))
                {
                    <span class="text-sm text-muted">Sin especialidad cargada</span>
                }
                else
                {
                    <partial name="_Chip" model="new ChipViewModel { Texto = Model.Especialidad, Capitalizar = true }" />
                }
            </p>
        </div>
    </div>

    @* Desde lg, los datos y el horario van lado a lado: antes las dos
       tarjetas dejaban vacía la mitad derecha de la pantalla. *@
    <div class="mt-6 grid items-start gap-6 lg:grid-cols-5">
        <div class="tarjeta p-5 sm:p-6 lg:col-span-2">
            <h2 class="text-base font-semibold text-ink">Datos profesionales</h2>
            <dl class="lista-datos mt-4">
                <div>
                    <dt><icono nombre="documento" /> Matrícula</dt>
                    @if (string.IsNullOrWhiteSpace(Model.Matricula))
                    {
                        <dd class="sin-dato">Sin datos</dd>
                    }
                    else
                    {
                        <dd class="tabular-nums">@Model.Matricula</dd>
                    }
                </div>
                <div>
                    <dt><icono nombre="ubicacion" /> Consultorio</dt>
                    @if (string.IsNullOrWhiteSpace(Model.Consultorio))
                    {
                        <dd class="sin-dato">Sin asignar</dd>
                    }
                    else
                    {
                        <dd>@Model.Consultorio</dd>
                    }
                </div>
            </dl>
        </div>

        <section class="tarjeta p-5 sm:p-6 lg:col-span-3" aria-labelledby="titulo-horario">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 id="titulo-horario" class="text-base font-semibold text-ink">Horario de atención</h2>
                <div class="flex flex-wrap items-center gap-2">
                    @if (Model.PuedeEditarHorario)
                    {
                        <a asp-action="Horario" asp-route-id="@Model.IdDoctor"
                           class="boton boton-secundario">
                            @* «Cargar» solo cuando se sabe que no tiene ninguno; si
                               el horario no se pudo leer, queda «Editar». *@
                            @(Model.Horario is { TieneHorario: false } ? "Cargar horario" : "Editar horario")
                        </a>
                    }
                    @if (Model.PuedePedirTurno && Model.Horario is { TieneHorario: true })
                    {
                        <a asp-controller="Turnos" asp-action="Crear"
                           asp-route-especialidad="@Model.Especialidad" asp-route-idDoctor="@Model.IdDoctor"
                           class="boton boton-secundario">
                            Pedir turno con este doctor
                        </a>
                    }
                </div>
            </div>

            <div class="mt-4">
                @if (Model.Horario is not null)
                {
                    <partial name="_HorarioSemanal" model="Model.Horario" />
                }
                else
                {
                    <p role="alert" class="aviso aviso-error">
                        <icono nombre="alerta" />
                        <span>No se pudo cargar el horario: @Model.ErrorHorario</span>
                    </p>
                }
            </div>
        </section>
    </div>
}
