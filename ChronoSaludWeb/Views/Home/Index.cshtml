@model DashboardViewModel
@{
    // Sin sesión no se pone título: el layout deja solo "ChronoSalud".
    ViewData["Title"] = Model.HaySesion ? "Inicio" : null;
}

@if (!Model.HaySesion)
{
    <div class="mx-auto max-w-xl py-10 text-center">
        <svg class="mx-auto h-10 w-10 text-primary" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 2v4" />
            <path d="M16 2v4" />
            <rect width="18" height="18" x="3" y="4" rx="2" />
            <path d="M3 10h18" />
            <path d="M12 14v4" />
            <path d="M10 16h4" />
        </svg>
        <h1 class="mt-6 text-3xl font-bold tracking-tight text-ink">ChronoSalud</h1>
        <p class="mx-auto mt-3 max-w-md text-muted">
            Gestión de turnos médicos: agenda de pacientes y doctores, historia clínica,
            recetas y coberturas, todo en un mismo lugar.
        </p>
        <a asp-controller="Cuenta" asp-action="Login"
           class="mt-8 inline-block rounded-input bg-primary px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft">
            Ingresar
        </a>
    </div>
}
else
{
    <h1 class="text-3xl font-bold tracking-tight text-ink">@Model.Saludo</h1>

    @if (Model.HuboError)
    {
        <div class="mt-8 rounded-card border border-border bg-surface p-10 text-center">
            <svg class="mx-auto h-8 w-8 text-status-cancelado" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
                <path d="M12 9v4" />
                <path d="M12 17h.01" />
            </svg>
            <h2 class="mt-4 text-base font-semibold text-ink">No se pudo armar el tablero</h2>
            <p class="mx-auto mt-1 max-w-sm text-sm text-muted">@Model.Error</p>
            <a asp-action="Index"
               class="mt-6 inline-block rounded-input border border-primary-line px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-soft">
                Reintentar
            </a>
        </div>
    }
    else
    {
        @if (Model.Aviso is not null)
        {
            <div class="mt-6 flex items-start gap-3 rounded-input border border-status-pendiente/40 bg-status-pendiente/10 px-4 py-3 text-sm text-status-pendiente">
                <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 16v-4" />
                    <path d="M12 8h.01" />
                </svg>
                <span>
                    @Model.Aviso
                    @if (Model.AvisoEnlace is { } avisoEnlace)
                    {
                        <a class="ml-1 font-semibold underline hover:no-underline"
                           asp-controller="@avisoEnlace.Controlador" asp-action="@avisoEnlace.Accion"
                           asp-all-route-data="avisoEnlace.Ruta">@avisoEnlace.Descripcion</a>
                    }
                </span>
            </div>
        }

        @* Cada rol acomoda las mismas piezas distinto, según el mockup:
           el administrativo lleva el resumen a la izquierda y la agenda al
           costado, el doctor abre con los accesos y deja la agenda abajo a todo
           el ancho, y el paciente pone su historial reciente al costado. *@
        @switch (Model.Disposicion)
        {
            case DisposicionDashboard.PanelAbajo:
                <div class="mt-6 space-y-6">
                    <partial name="_GrillaAccesos" model="Model.Accesos" />

                    @if (Model.Panel is not null)
                    {
                        <partial name="_PanelTurnos" model="Model.Panel" />
                    }
                </div>
                break;

            case DisposicionDashboard.ActividadDerecha:
                <div class="mt-6 grid gap-6 lg:grid-cols-5">
                    <div class="space-y-6 lg:col-span-3">
                        @if (Model.Panel is not null)
                        {
                            <partial name="_PanelTurnos" model="Model.Panel" />
                        }
                        <partial name="_GrillaAccesos" model="Model.Accesos" />
                    </div>

                    @if (Model.Actividad is not null)
                    {
                        <div class="lg:col-span-2">
                            <partial name="_ActividadReciente" model="Model.Actividad" />
                        </div>
                    }
                </div>
                break;

            default:
                <div class="mt-6 grid gap-6 lg:grid-cols-5">
                    <div class="space-y-6 lg:col-span-3">
                        <partial name="_GrillaMetricas" model="Model.Metricas" />
                        <partial name="_GrillaAccesos" model="Model.Accesos" />
                    </div>

                    @if (Model.Panel is not null)
                    {
                        <div class="lg:col-span-2">
                            <partial name="_PanelTurnos" model="Model.Panel" />
                        </div>
                    }
                </div>
                break;
        }
    }
}
