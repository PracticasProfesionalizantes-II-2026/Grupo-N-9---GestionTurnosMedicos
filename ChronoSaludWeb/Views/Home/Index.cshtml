@model DashboardViewModel
@{
    ViewData["Title"] = Model.HaySesion ? "Inicio" : "ChronoSalud";
}

@functions {
    // Acento sutil por rol: cambia el tratamiento del chip, no el fondo de la
    // página. Todo sale de los tokens del proyecto.
    static string ClaseRol(string? rol) => rol switch
    {
        "paciente"      => "bg-primary-soft text-primary",
        "doctor"        => "bg-accent-soft text-accent",
        "administrador" => "border border-primary-line text-primary",
        _               => "bg-canvas text-muted",
    };
}

@if (!Model.HaySesion)
{
    <div class="mx-auto max-w-xl py-10 text-center">
        <svg class="mx-auto h-10 w-10 text-primary" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 2v4" />
            <path d="M16 2v4" />
            <rect width="18" height="18" x="3" y="4" rx="2" />
            <path d="M3 10h18" />
            <path d="M12 14v4" />
            <path d="M10 16h4" />
        </svg>
        <h1 class="mt-6 text-3xl font-bold tracking-tight text-ink">ChronoSalud</h1>
        <p class="mx-auto mt-3 max-w-md text-muted">
            Gestión de turnos médicos: agenda de pacientes y doctores, historia clínica,
            recetas y coberturas, todo en un mismo lugar.
        </p>
        <a asp-controller="Cuenta" asp-action="Login"
           class="mt-8 inline-block rounded-input bg-primary px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-soft">
            Ingresar
        </a>
    </div>
}
else
{
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-ink">@Model.Saludo</h1>
            <p class="mt-1 text-sm capitalize text-muted">@Model.FechaDeHoy</p>
        </div>
        @if (Model.Rol is not null)
        {
            <span class="rounded-badge px-3 py-1 text-xs font-semibold capitalize @ClaseRol(Model.Rol)">@Model.Rol</span>
        }
    </div>

    @if (Model.HuboError)
    {
        <div class="mt-8 rounded-card border border-border bg-surface p-10 text-center">
            <svg class="mx-auto h-8 w-8 text-status-cancelado" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
                <path d="M12 9v4" />
                <path d="M12 17h.01" />
            </svg>
            <h2 class="mt-4 text-base font-semibold text-ink">No se pudo armar el tablero</h2>
            <p class="mx-auto mt-1 max-w-sm text-sm text-muted">@Model.Error</p>
            <a asp-action="Index"
               class="mt-6 inline-block rounded-input border border-primary-line px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-soft">
                Reintentar
            </a>
        </div>
    }
    else
    {
        @if (Model.Aviso is not null)
        {
            <div class="mt-6 flex items-start gap-3 rounded-input border border-status-pendiente/40 bg-status-pendiente/10 px-4 py-3 text-sm text-status-pendiente">
                <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 16v-4" />
                    <path d="M12 8h.01" />
                </svg>
                <span>@Model.Aviso</span>
            </div>
        }

        <div class="mt-6 grid gap-6 lg:grid-cols-5">
            <div class="space-y-6 lg:col-span-3">
                @if (Model.HayMetricas)
                {
                    <div class="grid grid-cols-2 gap-4">
                        @if (Model.TurnosDeHoy is not null)
                        {
                            <div class="rounded-card border border-border bg-surface p-5">
                                <div class="flex items-center gap-2 text-sm text-muted">
                                    <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M8 2v4" />
                                        <path d="M16 2v4" />
                                        <rect width="18" height="18" x="3" y="4" rx="2" />
                                        <path d="M3 10h18" />
                                    </svg>
                                    Turnos de hoy
                                </div>
                                <p class="mt-2 text-3xl font-bold tabular-nums text-ink">@Model.TurnosDeHoy</p>
                            </div>
                        }
                        @if (Model.TotalPacientes is not null)
                        {
                            <div class="rounded-card border border-border bg-surface p-5">
                                <div class="flex items-center gap-2 text-sm text-muted">
                                    <svg class="h-4 w-4 text-accent" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                        <circle cx="9" cy="7" r="4" />
                                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                    </svg>
                                    Pacientes
                                </div>
                                <p class="mt-2 text-3xl font-bold tabular-nums text-ink">@Model.TotalPacientes</p>
                            </div>
                        }
                    </div>
                }

                @if (Model.Accesos.Count > 0)
                {
                    <div>
                        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Accesos rápidos</h2>
                        <div class="mt-3 grid grid-cols-2 gap-4 sm:grid-cols-4">
                            @foreach (var acceso in Model.Accesos)
                            {
                                <partial name="_AccesoRapido" model="acceso" />
                            }
                        </div>
                    </div>
                }
            </div>

            @if (Model.Panel is not null)
            {
                <div class="lg:col-span-2">
                    <partial name="_PanelTurnos" model="Model.Panel" />
                </div>
            }
        </div>
    }
}
