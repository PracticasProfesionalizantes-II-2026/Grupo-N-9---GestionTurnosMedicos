@{
    ViewData["Title"] = "Prueba de estilos";
}

<h1 class="text-2xl font-bold text-ink">Prueba de tokens</h1>
<p class="mt-1 text-sm text-muted">Si esta pantalla se ve con los colores de la paleta, Tailwind está compilando bien.</p>

<div class="mt-8 max-w-md rounded-card border border-border bg-surface p-6">
    <h2 class="text-lg font-semibold text-ink">Turno de ejemplo</h2>
    <p class="mt-2 text-sm text-muted">
        Tarjeta con <code class="text-primary">bg-surface</code>, <code class="text-primary">border-border</code>
        y <code class="text-primary">text-ink</code>.
    </p>

    <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold">
        <span class="rounded-badge bg-primary-soft px-2 py-1 text-status-pendiente">pendiente</span>
        <span class="rounded-badge bg-primary-soft px-2 py-1 text-status-confirmado">confirmado</span>
        <span class="rounded-badge bg-primary-soft px-2 py-1 text-status-completado">completado</span>
        <span class="rounded-badge bg-primary-soft px-2 py-1 text-status-cancelado">cancelado</span>
    </div>

    <input type="text" placeholder="Input con rounded-input"
           class="mt-4 w-full rounded-input border border-primary-line bg-white px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-primary focus:outline-none" />

    <div class="mt-4 flex gap-3">
        <button type="button" class="rounded-input bg-primary px-4 py-2 text-sm font-semibold text-white hover:bg-primary-hover">
            Confirmar turno
        </button>
        <button type="button" class="rounded-input bg-accent-soft px-4 py-2 text-sm font-semibold text-accent hover:bg-accent hover:text-white">
            Cancelar
        </button>
    </div>
</div>
