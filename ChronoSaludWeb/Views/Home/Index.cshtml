@model DashboardViewModel
@{
    // Sin sesión no se pone título: el layout deja solo "ChronoSalud".
    ViewData["Title"] = Model.HaySesion ? "Inicio" : null;
}

@if (!Model.HaySesion)
{
    @* Portada: misma estructura que el banner del inicio. El motivo de marca
       es la única decoración; en el celular va arriba y chico, y desde sm al
       costado, con el texto angostado para no quedar nunca encima. *@
    <section aria-labelledby="titulo-portada" class="tarjeta tarjeta-hero relative overflow-hidden p-6 sm:p-10">
        <div class="motivo-animado mb-3 h-20 w-full sm:absolute sm:inset-y-0 sm:right-0 sm:mb-0 sm:h-full sm:w-[44%] sm:p-4">
            <partial name="_MotivoMarca" />
        </div>

        <div class="relative sm:max-w-[54%]">
            <h1 id="titulo-portada" class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Tus turnos médicos, en un mismo lugar</h1>
            <p class="mt-3 text-base text-muted">
                Agendá turnos, seguí tu historia clínica y tené tus recetas a mano
                con ChronoSalud.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
                <a asp-controller="Cuenta" asp-action="Login" class="boton boton-primario">Ingresar</a>
                <a asp-controller="Cuenta" asp-action="Registro" class="boton boton-secundario">Crear cuenta</a>
            </div>
        </div>
    </section>
}
else
{
    @if (Model.HuboError)
    {
        <h1 class="text-3xl font-bold tracking-tight text-ink">@Model.Saludo</h1>

        <div class="tarjeta mt-8 p-10 text-center">
            <svg class="mx-auto size-8 text-status-cancelado" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
                <path d="M12 9v4" />
                <path d="M12 17h.01" />
            </svg>
            <h2 class="mt-4 text-base font-semibold text-ink">No pudimos cargar tu inicio</h2>
            <p class="mx-auto mt-1 max-w-sm text-sm text-muted">@Model.Error</p>
            <a asp-action="Index" class="boton boton-secundario mt-6">Reintentar</a>
        </div>
    }
    else
    {
        <partial name="_BannerBienvenida" model="Model" />

        @if (Model.Aviso is not null)
        {
            @* El texto va en tinta y no en el color del estado: el enlace
               hereda ese color y sobre el tinte del aviso tiene que seguir
               pasando 4,5:1. El estado lo marcan el ícono y el borde. *@
            <div class="mt-6 flex items-start gap-3 rounded-input border border-status-pendiente-line bg-status-pendiente-soft px-4 py-3 text-sm text-ink">
                <svg class="mt-0.5 size-5 shrink-0 text-status-pendiente" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 16v-4" />
                    <path d="M12 8h.01" />
                </svg>
                <span>
                    @Model.Aviso
                    @if (Model.AvisoEnlace is { } avisoEnlace)
                    {
                        <a class="ml-1 rounded-badge font-semibold underline hover:no-underline"
                           asp-controller="@avisoEnlace.Controlador" asp-action="@avisoEnlace.Accion"
                           asp-all-route-data="avisoEnlace.Ruta">@avisoEnlace.Descripcion</a>
                    }
                </span>
            </div>
        }

        @* Cada rol acomoda las mismas piezas distinto, según el mockup:
           el administrativo lleva el resumen a la izquierda y la agenda al
           costado, el doctor abre con los accesos y deja la agenda abajo a todo
           el ancho, y el paciente pone su historial reciente al costado. *@
        @switch (Model.Disposicion)
        {
            case DisposicionDashboard.PanelAbajo:
                <div class="mt-6 space-y-6">
                    <partial name="_GrillaAccesos" model="Model.Accesos" />

                    @if (Model.Panel is not null)
                    {
                        <partial name="_PanelTurnos" model="Model.Panel" />
                    }
                </div>
                break;

            case DisposicionDashboard.ActividadDerecha:
                <div class="mt-6 grid gap-6 lg:grid-cols-5">
                    <div class="space-y-6 lg:col-span-3">
                        @if (Model.Panel is not null)
                        {
                            <partial name="_PanelTurnos" model="Model.Panel" />
                        }
                        <partial name="_GrillaAccesos" model="Model.Accesos" />
                    </div>

                    @if (Model.Actividad is not null)
                    {
                        <div class="lg:col-span-2">
                            <partial name="_ActividadReciente" model="Model.Actividad" />
                        </div>
                    }
                </div>
                break;

            default:
                <div class="mt-6 grid gap-6 lg:grid-cols-5">
                    <div class="space-y-6 lg:col-span-3">
                        <partial name="_GrillaMetricas" model="Model.Metricas" />
                        <partial name="_GrillaAccesos" model="Model.Accesos" />
                    </div>

                    @if (Model.Panel is not null)
                    {
                        <div class="lg:col-span-2">
                            <partial name="_PanelTurnos" model="Model.Panel" />
                        </div>
                    }
                </div>
                break;
        }
    }
}
